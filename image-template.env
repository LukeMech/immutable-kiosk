# Base image name -- just the repo name. The package a build produces is
# always "<IMAGE_NAME>-<variant>" (see images/variants.toml), appended by the
# Justfile's `build` recipe, never edited here.
IMAGE_NAME=immutable-kiosk

REPO_ORGANIZATION="LukeMech"

IMAGE_DESC="Immutable bootc kiosk: boots straight into a web HMI, with a touch-first settings and update page"
IMAGE_KEYWORDS="bootc,oci,linux,kiosk,hmi,cage,webkit,x86_64,tablet,twincat"

IMAGE_LOGO_URL=""
DEFAULT_TAG="latest"
