# The installer ISO's live system: the kiosk image itself, booted from the
# USB stick, with two differences --
#   * mode "installer": kiosk-shell shows only the installer page (same
#     kioskd, same on-screen keyboard), never an HMI;
#   * the payload: a ready-made disk image of the kiosk system
#     (dist/payload/disk.raw.zst + payload.json, made by build-media.yml or
#     `just build-raw`), which the installer writes onto the internal eMMC
#     with a real byte-for-byte progress bar and a read-back verification.
#
# image-builder's bootc-generic-iso turns this container into the ISO
# (build-media.yml / `just build-iso`), the same tool lm-server's installer
# uses -- there with Anaconda inside, here with our own page.
#
# Built from the repo root: podman build -f installer/Containerfile .
ARG BASE_IMAGE=ghcr.io/lukemech/immutable-kiosk-x86:latest
FROM ${BASE_IMAGE}

# Live boot from the ISO (dracut's dmsquash-live), the ISO bootloaders for
# both 64- and 32-bit UEFI, and what image-builder needs to assemble the ISO
# (it runs its stages inside this image: xorrisofs, mksquashfs, implantisomd5),
# plus mtools for scripts/iso-add-ia32.sh, which build-media.yml / `just
# build-iso` also run in this image to add the ia32 files image-builder skips.
# bootc images ship no /boot/efi, but the ISO build takes its EFI files from
# there, so it's filled here. Since Fedora 45 the packages keep their files in
# /usr/lib/efi/<pkg>/<ver>/EFI/ and only their %posttrans scriptlets copy them
# to /boot/efi/EFI/{BOOT,fedora} -- without creating those directories. So:
# create them, reinstall (scriptlets copy), then copy every package tree
# (and bootupd's, for the older layout) over anything a scriptlet missed.
RUN dnf5 install -y \
        dracut-live \
        grub2-efi-x64-cdboot \
        grub2-efi-ia32-cdboot \
        xorriso \
        squashfs-tools \
        isomd5sum \
        mtools \
        grub2-pc-modules \
    && mkdir -p /boot/efi/EFI/BOOT /boot/efi/EFI/fedora \
    && dnf5 reinstall -y shim-x64 shim-ia32 grub2-efi-x64 grub2-efi-ia32 \
    && for t in /usr/lib/efi/*/*/EFI /usr/lib/bootupd/updates/EFI; do \
           if [ -d "$t" ]; then cp -rn "$t/." /boot/efi/EFI/; fi; \
       done \
    && ls -R /boot/efi/EFI \
    && test -f /boot/efi/EFI/BOOT/BOOTX64.EFI \
    && test -f /boot/efi/EFI/BOOT/BOOTIA32.EFI \
    && dnf5 clean all

RUN mkdir -p /usr/lib/immutable-kiosk \
    && echo installer > /usr/lib/immutable-kiosk/mode

# ISO volume label and boot menu (read by image-builder).
COPY installer/iso.yaml /usr/lib/image-builder/bootc/iso.yaml

# Initramfs that can find its root on the ISO: the system image's own recipe
# (images/<variant>/initramfs.sh from the repo -- slim, i915 for early KMS)
# plus dmsquash-live. A variant without one: fedora-bootc's stock initramfs
# plus dmsquash-live.
ARG VARIANT=x86
RUN --mount=type=bind,source=images,target=/ctx/images \
    if [ -f "/ctx/images/${VARIANT}/initramfs.sh" ]; then \
        bash "/ctx/images/${VARIANT}/initramfs.sh" dmsquash-live; \
    else \
        kernel=$(ls /usr/lib/modules | head -1) \
        && DRACUT_NO_XATTR=1 dracut --force --zstd --reproducible --no-hostonly \
            --add "dmsquash-live" \
            "/usr/lib/modules/${kernel}/initramfs.img" "${kernel}"; \
    fi

# Last, so a new payload doesn't rebuild the layers above.
COPY dist/payload/ /usr/share/immutable-kiosk/payload/
RUN test -s /usr/share/immutable-kiosk/payload/disk.raw.zst \
    && test -s /usr/share/immutable-kiosk/payload/payload.json
