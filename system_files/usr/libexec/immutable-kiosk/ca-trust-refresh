#!/bin/bash
# update-ca-trust only if the trust sources' contents changed (ostree
# normalizes /usr mtimes). See immutable-kiosk-ca-trust.service.
set -euo pipefail

STAMP=/var/lib/immutable-kiosk/ca-trust.sha256
dirs=()
for d in /usr/share/pki/ca-trust-source /etc/pki/ca-trust/source; do
    [[ -d "$d" ]] && dirs+=("$d")
done
[[ ${#dirs[@]} -gt 0 ]] || exit 0

sum=$(find "${dirs[@]}" -type f -print0 | LC_ALL=C sort -z | xargs -0 -r sha256sum | sha256sum | cut -d' ' -f1)
if [[ -f "$STAMP" && "$(cat "$STAMP")" == "$sum" ]]; then
    echo "CA trust sources unchanged"
    exit 0
fi
echo "CA trust sources changed: update-ca-trust"
update-ca-trust
mkdir -p "$(dirname "$STAMP")"
echo "$sum" > "$STAMP"
