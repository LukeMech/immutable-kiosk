def is_benign(error):
    """A load replaced by another one (navigation, our own retry) -- not a failure."""
    if error.domain == "WebKitNetworkError":
        return error.code == int(WebKit.NetworkError.CANCELLED)
    if error.domain == "WebKitPolicyError":
        return error.code == int(WebKit.PolicyError.FRAME_LOAD_INTERRUPTED_BY_POLICY_CHANGE)
    return False


def esc(s):
    return (str(s).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;"))


# ------------------------------------------------------------ app

class KioskShell(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="io.github.lukemech.ImmutableKiosk")
        self.cfg = None
        self.retry_source = None
        self.loaded_url = None
        self.hmi = None
        self.settings_loaded = False
        self.hmi_error = False
        self.boot_reported = False
        self.ok_reported = False
        self.pending = None  # view to reveal once its first page is rendered
        self.device_scale = 1.0  # GTK's scale for our window (display_check)
        # The HMI couldn't be reached at start (no network yet, server still
        # booting): Settings is shown instead, and the HMI replaces it the
        # moment it loads. Settings' top bar says what's being waited for.
        self.waiting_for_hmi = False

    # -- setup
    def do_activate(self):
        """kiosk-splash (started before us by kiosk-session) is on screen and
        animating while all of this runs: GTK, the rotation, WebKit and its
        views. Then the window maps over it -- see-through, so the
        animation stays in sight -- until the first page is rendered."""
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.cfg = self.wait_for_config()
        apply_output(self.cfg)  # before the first frame: no portrait flash
        # Let GTK hear about it before WebKit starts: a round trip to cage,
        # then the events it brought (the monitor's new geometry). Without
        # this the web process started with the monitor still 800x1280 and
        # laid the landscape pages out 800 px wide, stretched 1.6x.
        Gdk.Display.get_default().sync()
        ctx = GLib.MainContext.default()
        while ctx.pending():
            ctx.iteration(False)
        milestone("kiosk-shell: konfiguracja i obrót")

        self.win = Gtk.ApplicationWindow(application=self, title="Kiosk")
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, transition_duration=200)
        self.overlay = Gtk.Overlay(child=self.stack)
        self.win.set_child(self.overlay)
        self.win.add_css_class("splashing")
        splash = Gtk.Box(halign=Gtk.Align.FILL, valign=Gtk.Align.FILL)
        splash.add_css_class("splash")
        self.stack.add_named(splash, "splash")
        # WebKit comes in only once the window is on the screen (painted):
        # a view created and loading before that never got its size -- the
        # page measured 0x0, the zoom came out NaN, and in landscape the
        # pages ended up ~1.6x too big after every start (measured under a
        # headless cage: created after the window, 1280x800 at zoom 1.0).
        # The window is see-through meanwhile; kiosk-splash animates below.
        self.win.fullscreen()
        self.win.connect("map", self.on_first_map)
        self.win.present()
        milestone("kiosk-shell: okno wysłane")

    def on_first_map(self, win):
        """The window's first frame actually drawn: from here it covers
        kiosk-splash (the boot timeline shows any gap)."""
        clock = win.get_frame_clock()
        state = {}

        def painted(_clock):
            clock.disconnect(state["id"])
            milestone("kiosk-shell: ekran startowy (pierwsza klatka okna)")
            GLib.idle_add(self.setup_once)
            self.watch_display()
        state["id"] = clock.connect("after-paint", painted)

    # -- display: what cage and GTK actually use
    def watch_display(self):
        """The page came up ~2x too big with Settings' scaling at 100 %: GTK
        drew at a scale above 1. Whenever the window's scale or the set of
        outputs changes, look again: a scale above 1 gets the output
        configuration (scale 1, the rotation) applied once more, and what's
        there goes to kioskd -- Settings > Ekran shows it."""
        self.display_pending = False
        self.display_fixed = 0.0
        self.win.get_surface().connect("notify::scale", lambda *a: self.display_changed())
        Gdk.Display.get_default().get_monitors().connect("items-changed", lambda *a: self.display_changed())
        self.display_changed()

    def display_changed(self):
        if not self.display_pending:
            self.display_pending = True
            GLib.timeout_add(300, self.display_check)

    def display_check(self):
        self.display_pending = False
        surface = self.win.get_surface()
        scale = surface.get_scale() if hasattr(surface, "get_scale") else float(surface.get_scale_factor())
        outputs = wlr_state()
        wrong = scale != 1 or any(o["scale"] not in (None, 1, 1.0) for o in outputs)
        if wrong and time.monotonic() - self.display_fixed > 5:
            self.display_fixed = time.monotonic()
            log(f"window scale {scale}, outputs {outputs}: output configuration again")
            apply_output(self.cfg)
            self.display_changed()  # and look once more
        if scale > 0 and scale != self.device_scale:
            # Whatever made GTK draw above 1 (the page came up ~2x too big),
            # the pages keep their size: apply_scale divides WebKit's zoom by it.
            log(f"window scale {scale}: WebKit zoom compensates")
            self.device_scale = scale
            self.apply_scale()
        monitor = Gdk.Display.get_default().get_monitor_at_surface(surface)
        geo = monitor.get_geometry() if monitor else None
        info = {"gtk_scale": scale, "window": [self.win.get_width(), self.win.get_height()],
                "monitor": [geo.width, geo.height] if geo else None, "outputs": outputs}

        def report():
            try:
                api_post("/api/display", info, timeout=5)
            except (OSError, ValueError) as e:
                log("display report:", e)
        threading.Thread(target=report, daemon=True).start()
        return GLib.SOURCE_REMOVE

    def setup_once(self):
        if not getattr(self, "set_up", False):
            self.set_up = True
            self.setup()
        return GLib.SOURCE_REMOVE

    def setup(self):
        load_webkit()
        milestone("kiosk-shell: WebKit wczytany")
        self.settings = self.make_settings_view()
        self.stack.add_named(self.settings, "settings")

        if self.cfg.get("mode") != "installer":
            (DATA / "hmi").mkdir(parents=True, exist_ok=True)
            CACHE.mkdir(parents=True, exist_ok=True)
            # Persistent: TwinCAT HMI's login session survives a restart.
            self.hmi_session = WebKit.NetworkSession.new(str(DATA / "hmi"), str(CACHE / "hmi"))
            # Cookies on disk explicitly (SQLite), so a login with an expiry
            # survives a reboot. A pure session cookie (no expiry) is still
            # dropped at restart -- that one is the HMI server's choice.
            self.hmi_session.get_cookie_manager().set_persistent_storage(
                str(DATA / "hmi" / "cookies.sqlite"), WebKit.CookiePersistentStorage.SQLITE)
            self.hmi = self.make_hmi_view()
            self.stack.add_named(self.hmi, "hmi")
            self.hotcorner = self.make_hotcorner()
            self.overlay.add_overlay(self.hotcorner)
            self.recovery_corner = self.make_recovery_corner()
            self.overlay.add_overlay(self.recovery_corner)
            self.apply_hmi_config(force_load=True)
        self.apply_scale()

        # The start-up screen stays until the view's first page is rendered
        # (on_any_load_changed) -- no blank WebKit view in between -- or 30 s.
        if self.hmi and self.cfg.get("hmi_url"):
            # Settings' page loads once the HMI is up (or Settings is opened):
            # two web processes starting side by side on a Bay Trail Atom
            # slowed the HMI's first paint down.
            self.pending = "hmi"
            # An HMI server that accepts but never answers would keep
            # Settings from ever loading (and the boot from counting as good).
            GLib.timeout_add_seconds(60, self.ensure_settings)
        else:
            self.pending = "settings"  # first boot: nothing to show yet but Settings
            self.ensure_settings()
        GLib.timeout_add_seconds(30, self.reveal)
        threading.Thread(target=self.listen_events, daemon=True).start()

    def listen_events(self):
        """kioskd's live events (/api/events, the Settings page reads the
        same): a network change retries an HMI that couldn't be reached,
        right then instead of at the next retry tick."""
        while True:
            try:
                req = urllib.request.Request(API + "/api/events")
                with urllib.request.urlopen(req, timeout=60) as r:
                    for raw in r:
                        line = raw.decode(errors="replace").strip()
                        if line.startswith("data:") and "net" in json.loads(line[5:]):
                            GLib.idle_add(self.on_net_change)
            except (OSError, ValueError) as e:
                log("events:", e)
            GLib.usleep(3_000_000)

    def on_net_change(self):
        if self.hmi and self.hmi_error and self.retry_source:
            log("network changed: retrying the HMI now")
            self.load_hmi()
        return GLib.SOURCE_REMOVE

    def set_waiting(self, on):
        self.waiting_for_hmi = on
        self.tell_settings_waiting()

    def tell_settings_waiting(self):
        if self.settings_loaded:
            self.settings.evaluate_javascript(
                f"window.kioskWaiting && window.kioskWaiting({'true' if self.waiting_for_hmi else 'false'})",
                -1, None, None, None, None, None)

    def reveal(self):
        if self.pending:
            name, self.pending = self.pending, None
            self.show(name)
            milestone("kiosk-shell: pierwsza strona")
        return GLib.SOURCE_REMOVE

    def splash_over(self):
        """The first view is in: once the stack's crossfade from the see-through
        start-up page is done, the window turns opaque and kiosk-splash goes."""
        if not self.win.has_css_class("splashing") or getattr(self, "splash_ending", False):
            return
        self.splash_ending = True

        def finish():
            self.win.remove_css_class("splashing")
            end_splash()
            return GLib.SOURCE_REMOVE
        GLib.timeout_add(self.stack.get_transition_duration() + 150, finish)

    def wait_for_config(self):
        # kioskd starts first (unit ordering), but give it a moment on a slow eMMC.
        for _ in range(60):
            try:
                return api_get("/api/config")
            except OSError:
                GLib.usleep(500_000)
        log("kioskd unreachable, starting with defaults")
        return {"mode": "kiosk", "hmi_url": "", "rotation_effective": "landscape",
                "osk_in_hmi": True, "accept_self_signed": True, "zoom": 1.0, "retry_seconds": 10}

    def common_view_setup(self, view):
        s = view.get_settings()
        # WebKit honours <meta name="viewport" content="width=device-width">
        # on a touch screen -- and after cage (re)started in landscape it
        # took "device-width" as the panel's portrait 800 px: every page laid
        # out 800 px wide and stretched to 1280 (fine in portrait, fine after
        # rotating while running). A kiosk page is as wide as the window.
        feats = WebKit.Settings.get_all_features()
        for i in range(feats.get_length()):
            f = feats.get(i)
            if f.get_identifier() == "ShouldIgnoreMetaViewport":
                s.set_feature_enabled(f, True)
        s.set_enable_developer_extras(False)
        s.set_javascript_can_open_windows_automatically(False)
        s.set_enable_back_forward_navigation_gestures(False)
        view.connect("context-menu", lambda *a: True)

    def make_settings_view(self):
        ucm = WebKit.UserContentManager()
        ucm.register_script_message_handler("kiosk", None)
        ucm.connect("script-message-received::kiosk", self.on_settings_message)
        view = WebKit.WebView(user_content_manager=ucm,
                              network_session=WebKit.NetworkSession.new_ephemeral())
        self.common_view_setup(view)
        view.connect("decide-policy", self.settings_policy)
        view.connect("web-process-terminated", lambda v, r: v.load_uri(SETTINGS_URL))
        # kioskd restarting / not up yet: keep trying.
        view.connect("load-failed", self.settings_load_failed)
        view.connect("load-changed", self.on_any_load_changed)
        return view

    def make_hmi_view(self):
        ucm = WebKit.UserContentManager()
        ucm.register_script_message_handler("kioskNav", None)
        ucm.connect("script-message-received::kioskNav", self.on_hmi_nav)
        view = WebKit.WebView(user_content_manager=ucm, network_session=self.hmi_session)
        self.common_view_setup(view)
        view.connect("load-failed", self.on_hmi_load_failed)
        view.connect("load-failed-with-tls-errors", self.on_hmi_tls_error)
        view.connect("load-changed", self.on_hmi_load_changed)
        view.connect("web-process-terminated", lambda v, r: self.load_hmi())
        # target=_blank / window.open: stay in the same view, there are no other windows.
        view.connect("create", self.on_hmi_create)
        return view

    def make_hotcorner(self):
        box = Gtk.Box(width_request=72, height_request=72)
        box.add_css_class("hotcorner")
        press = Gtk.GestureLongPress(touch_only=False)
        # GTK's maximum (gtk-long-press-time x 2 = ~1 s); 4.0 was rejected
        # with a Gtk-CRITICAL and silently left at the default ~0.5 s.
        press.set_delay_factor(2.0)
        press.connect("begin", lambda *a: box.add_css_class("armed"))
        press.connect("end", lambda *a: box.remove_css_class("armed"))
        press.connect("cancelled", lambda *a: box.remove_css_class("armed"))
        press.connect("pressed", lambda *a: self.show("settings"))
        box.add_controller(press)
        return box

    def make_recovery_corner(self):
        """Held RECOVERY_HOLD_MS: Settings > System > Odzyskiwanie.
        GestureLongPress can't wait longer than ~1 s, so a drag gesture plus
        our own timer; moving the finger away cancels."""
        box = Gtk.Box(width_request=72, height_request=72)
        box.add_css_class("hotcorner")
        box.add_css_class("recovery")
        state = {"timer": None}

        def cancel(*_):
            if state["timer"]:
                GLib.source_remove(state["timer"])
                state["timer"] = None
            box.remove_css_class("armed")

        def fire():
            state["timer"] = None
            box.remove_css_class("armed")
            self.open_recovery()
            return GLib.SOURCE_REMOVE

        def begin(*_):
            cancel()
            box.add_css_class("armed")
            state["timer"] = GLib.timeout_add(RECOVERY_HOLD_MS, fire)

        def update(_g, dx, dy):
            if dx * dx + dy * dy > 48 * 48:
                cancel()

        drag = Gtk.GestureDrag(touch_only=False)
        drag.connect("drag-begin", begin)
        drag.connect("drag-update", update)
        drag.connect("drag-end", cancel)
        drag.connect("cancel", cancel)
        box.add_controller(drag)
        return box

    def open_recovery(self):
        """Settings' page with #recovery: it opens System and scrolls to the
        recovery card (a fragment change if the page is already there, a
        fresh load otherwise -- either way app.js handles it)."""
        log("recovery corner held: Settings > System > Odzyskiwanie")
        self.settings_loaded = True
        self.settings.load_uri(SETTINGS_URL + "#recovery")
        self.show("settings")

    # -- switching
    def ensure_settings(self):
        if not self.settings_loaded:
            self.settings_loaded = True
            self.settings.load_uri(SETTINGS_URL)
        return GLib.SOURCE_REMOVE

    def show(self, name):
        if name == "hmi" and not self.hmi:
            return
        self.pending = None  # an explicit switch ends the start-up screen
        if name == "settings":
            self.ensure_settings()
        self.stack.set_visible_child_name(name)
        self.splash_over()
        if self.hmi:
            self.hotcorner.set_visible(name == "hmi")
        # Settings' page keeps running behind the HMI: tell it when it's on
        # screen, so it reloads on kioskd's events (network, battery...) only then.
        if name == "settings":
            self.settings.evaluate_javascript("window.kioskShown && window.kioskShown()", -1,
                                              None, None, None, None, None)
            self.tell_settings_waiting()
        elif self.settings_loaded:
            self.settings.evaluate_javascript("window.kioskHidden && window.kioskHidden()", -1,
                                              None, None, None, None, None)

    # -- config
    def apply_hmi_config(self, force_load=False):
        cfg = self.cfg
        self.place_corners()

        ucm = self.hmi.get_user_content_manager()
        ucm.remove_all_scripts()
        # Always, keyboard or not: no viewport meta of the HMI's (NO_VIEWPORT_JS).
        ucm.add_script(WebKit.UserScript.new(
            NO_VIEWPORT_JS, WebKit.UserContentInjectedFrames.ALL_FRAMES,
            WebKit.UserScriptInjectionTime.START, None, None))
        if cfg.get("osk_in_hmi", True) and OSK_JS.exists():
            ucm.add_script(WebKit.UserScript.new(
                OSK_JS.read_text(), WebKit.UserContentInjectedFrames.ALL_FRAMES,
                WebKit.UserScriptInjectionTime.END, None, None))
        if force_load or cfg.get("hmi_url") != self.loaded_url:
            self.load_hmi()

    def place_corners(self):
        """Settings corner where Ekran says, recovery corner opposite it.
        Removed and added back, not just re-aligned: a changed halign/valign
        on an overlay child that's already placed didn't move it (the
        recovery corner stayed bottom-left whatever Ekran said)."""
        corner = self.cfg.get("settings_corner", "top-right")
        if corner not in CORNERS:
            corner = "top-right"
        for box, name in ((self.hotcorner, corner), (self.recovery_corner, OPPOSITE[corner])):
            h, v = CORNERS[name]
            self.overlay.remove_overlay(box)
            box.set_halign(h)
            box.set_valign(v)
            self.overlay.add_overlay(box)
        log(f"corners: settings {corner}, recovery {OPPOSITE[corner]}")

    def apply_scale(self):
        """Screen scaling = WebKit zoom: Settings (and its keyboard) at the
        scale, the HMI at scale x its own zoom (the HMI tab's setting) --
        both divided by the scale GTK really draws our window at, so a page
        is the same size whatever the compositor's scale is."""
        if not hasattr(self, "settings"):
            return  # before setup(): it applies the scale itself
        scale = screen_scale(self.cfg) / (self.device_scale or 1.0)
        self.settings.set_zoom_level(scale)
        if self.hmi:
            try:
                zoom = float(self.cfg.get("zoom", 1.0))
            except (TypeError, ValueError):
                zoom = 1.0
            self.hmi.set_zoom_level(scale * zoom)

    def reload_config(self):
        try:
            self.cfg = api_get("/api/config")
        except OSError as e:
            log("reload config:", e)
            return
        apply_output(self.cfg)
        if self.hmi:
            self.apply_hmi_config()
        self.apply_scale()

    # -- HMI loading
    def load_hmi(self):
        self.cancel_retry()
        self.hmi_error = False
        url = self.cfg.get("hmi_url")
        self.loaded_url = url
        if not url:
            self.show_error(self.t("Brak adresu HMI", "No HMI address"),
                            self.t("Ustaw adres wizualizacji w Ustawieniach.", "Set the HMI's address in Settings."),
                            None)
            return
        self.hmi.load_uri(url)

    def cancel_retry(self):
        if self.retry_source:
            GLib.source_remove(self.retry_source)
            self.retry_source = None

    def schedule_retry(self):
        self.cancel_retry()
        secs = int(self.cfg.get("retry_seconds", 10))
        if self.waiting_for_hmi:
            secs = min(secs, 5)  # Settings is on screen meanwhile: try often

        def fire():
            self.retry_source = None
            self.load_hmi()
            return GLib.SOURCE_REMOVE
        self.retry_source = GLib.timeout_add_seconds(secs, fire)
        return secs

    def t(self, pl, en):
        """The error page's own texts, in Settings' language (en by default;
        Settings itself is translated by i18n.js)."""
        return pl if (self.cfg or {}).get("language", "en") == "pl" else en

    def show_error(self, title, detail, failing_uri):
        self.hmi_error = True
        self.ensure_settings()  # the error page's "Settings" button is the way out
        secs = self.schedule_retry() if failing_uri else 0
        html = ERROR_PAGE.format(
            title=esc(title), detail=detail, retry=secs, lang=(self.cfg or {}).get("language", "en"),
            retry_in=self.t("Ponowna próba za", "Trying again in"), settings=self.t("Ustawienia", "Settings"),
            retry_now=self.t("Spróbuj teraz", "Try now"))
        self.hmi.load_alternate_html(html, failing_uri or "about:blank", None)

    def on_hmi_load_failed(self, view, event, uri, error):
        if is_benign(error):
            return False
        log("HMI load failed:", uri, error.message)
        if self.pending == "hmi":
            # Start-up and no HMI: Settings instead of the error page (it
            # shows the network and what's being waited for); the HMI keeps
            # being tried behind it and takes over once it loads.
            log("HMI not reachable at start: Settings until it is")
            self.waiting_for_hmi = True
            self.pending = "settings"
            self.ensure_settings()
        self.show_error(self.t("Brak połączenia z HMI", "Can't reach the HMI"),
                        self.t("Nie można otworzyć", "Couldn't open") +
                        f" <code>{esc(uri)}</code>.<br>{esc(error.message)}", uri)
        return True

    def on_hmi_tls_error(self, view, uri, certificate, errors):
        host = urlsplit(uri).hostname or ""
        hmi_host = urlsplit(self.cfg.get("hmi_url", "")).hostname or ""
        if self.cfg.get("accept_self_signed", True) and host and host == hmi_host:
            # TwinCAT HMI's own self-signed certificate -- only for the HMI host.
            log(f"accepting certificate for {host} ({errors})")
            self.hmi_session.allow_tls_certificate_for_host(certificate, host)
            view.load_uri(uri)
            return True
        self.show_error(self.t("Niezaufany certyfikat", "Untrusted certificate"),
                        self.t(f"Serwer <code>{esc(host)}</code> przedstawił niezaufany certyfikat. "
                               "Włącz „Akceptuj certyfikat HMI” w Ustawieniach.",
                               f"The server <code>{esc(host)}</code> presented an untrusted certificate. "
                               "Turn on “Accept the HMI's certificate” in Settings."), uri)
        return True

    def on_any_load_changed(self, view, event):
        """First page rendered by either view -- the HMI, its error page or
        Settings: cage, GTK, WebKit and kioskd all work. kioskd tells
        boot-counter this boot is good (automatic rollback)."""
        if event == WebKit.LoadEvent.FINISHED and view is self.settings:
            self.tell_settings_waiting()  # a (re)loaded page starts without it
        if event == WebKit.LoadEvent.FINISHED and self.pending == ("hmi" if view is self.hmi else "settings"):
            self.reveal()
        if event == WebKit.LoadEvent.FINISHED and not self.ok_reported:
            self.ok_reported = True
            threading.Thread(target=self.report_boot_ok, daemon=True).start()

    def report_boot_ok(self):
        for _ in range(10):
            try:
                r = api_post("/api/boot/ok", {}, timeout=150)
                if r.get("fallback"):
                    log("new version never came up, previous one restored:", r)
                return
            except (OSError, ValueError) as e:
                log("boot ok:", e)
                GLib.usleep(5_000_000)

    def on_hmi_load_changed(self, view, event):
        self.on_any_load_changed(view, event)
        if event == WebKit.LoadEvent.COMMITTED:
            self.cancel_retry()
        elif event == WebKit.LoadEvent.FINISHED and not self.hmi_error:
            if self.waiting_for_hmi:
                # Reachable at last: the HMI replaces Settings shown meanwhile.
                log("HMI reachable: switching to it")
                self.set_waiting(False)
                if self.stack.get_visible_child_name() == "settings":
                    self.show("hmi")
            # The HMI is up: Settings may load now, with a head start for the
            # HMI's own scripts.
            GLib.timeout_add_seconds(3, self.ensure_settings)
            if not self.boot_reported:
                # Settings > System shows "HMI visible N s after boot".
                self.boot_reported = True
                threading.Thread(target=self.report_hmi_shown, daemon=True).start()

    @staticmethod
    def report_hmi_shown():
        try:
            api_post("/api/boot/hmi", {}, timeout=5)
        except (OSError, ValueError) as e:
            log("boot timing:", e)

    def on_hmi_create(self, view, action):
        uri = action.get_request().get_uri()
        if uri:
            view.load_uri(uri)
        return None

    def on_hmi_nav(self, ucm, value):
        cmd = value.to_string()
        if cmd == "settings":
            self.show("settings")
        elif cmd == "retry":
            self.load_hmi()

    # -- settings view
    def settings_policy(self, view, decision, kind):
        if kind == WebKit.PolicyDecisionType.NAVIGATION_ACTION:
            uri = decision.get_navigation_action().get_request().get_uri()
            if not uri.startswith(API + "/"):
                decision.ignore()
                return True
        elif kind == WebKit.PolicyDecisionType.NEW_WINDOW_ACTION:
            decision.ignore()
            return True
        return False

    def settings_load_failed(self, view, event, uri, error):
        if is_benign(error):
            return False
        GLib.timeout_add_seconds(2, lambda: (view.load_uri(SETTINGS_URL), GLib.SOURCE_REMOVE)[1])
        view.load_alternate_html("<body style='background:#10151c;color:#9aa7b4;font:20px sans-serif;"
                                 "display:grid;place-items:center;height:100vh;margin:0'>Uruchamianie…</body>",
                                 uri, None)
        return True

    def on_settings_message(self, ucm, value):
        try:
            msg = json.loads(value.to_string())
        except ValueError:
            return
        cmd = msg.get("cmd")
        if cmd == "show-hmi":
            self.show("hmi")
        elif cmd == "config-changed":
            self.reload_config()
        elif cmd == "reload-hmi" and self.hmi:
            self.load_hmi()
            self.show("hmi")


def main():
    app = KioskShell()
    return app.run(sys.argv[:1])


if __name__ == "__main__":
    sys.exit(main())
