def log(*a):
    print("kiosk-shell:", *a, file=sys.stderr, flush=True)


def milestone(label):
    """A point of the kiosk's start-up, for Settings' boot timeline: kioskd
    picks "kiosk-shell: milestone: <label>" lines out of this unit's journal
    (their own timestamps), next to the system's."""
    log("milestone:", label)


milestone("kiosk-shell: start")


def sandbox_works():
    """Can bubblewrap create the namespaces WebKit's web-process sandbox needs?

    If it can't, WebKitGTK doesn't fail gracefully: the UI process aborts
    ("Connection: failed to receive credentials") as soon as the first view
    starts its web process -- cage exits with it and systemd restarts the
    pair every 2 s: a black screen with a blinking cursor.
    """
    try:
        r = subprocess.run(
            ["bwrap", "--unshare-user", "--unshare-pid", "--unshare-ipc", "--unshare-uts",
             "--ro-bind", "/", "/", "--dev", "/dev", "--proc", "/proc", "true"],
            capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired) as e:
        log("bwrap check failed:", e)
        return False
    if r.returncode != 0:
        log("bwrap check failed:", r.stderr.strip())
    return r.returncode == 0


def load_webkit():
    """WebKit comes in only after the start-up screen is up (KioskShell.setup):
    loading it takes seconds on an Atom, which used to be seconds of black
    between the boot splash and the kiosk. The sandbox decision has to come
    before it. Without a sandbox the web pages still run in their own
    processes, just not namespaced -- far better than a kiosk that never
    comes up."""
    global WebKit
    if "WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS" not in os.environ and not sandbox_works():
        log("WebKit sandbox unavailable, starting without it")
        os.environ["WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS"] = "1"
    from gi.repository import WebKit as webkit
    WebKit = webkit


