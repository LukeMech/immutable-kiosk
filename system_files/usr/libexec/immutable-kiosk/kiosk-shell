import http.client
import json
import os
import signal
import socket
import ssl
import subprocess
import sys
import threading
import urllib.error
import urllib.request
from pathlib import Path
from urllib.parse import urlsplit


def log(*a):
    print("kiosk-shell:", *a, file=sys.stderr, flush=True)


def sandbox_works():
    """Can bubblewrap create the namespaces WebKit's sandbox needs? If not,
    WebKitGTK aborts on the first web process instead of failing gracefully."""
    try:
        r = subprocess.run(
            ["bwrap", "--unshare-user", "--unshare-pid", "--unshare-ipc", "--unshare-uts",
             "--ro-bind", "/", "/", "--dev", "/dev", "--proc", "/proc", "true"],
            capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired) as e:
        log("bwrap check failed:", e)
        return False
    if r.returncode != 0:
        log("bwrap check failed:", r.stderr.strip())
    return r.returncode == 0


def load_webkit():
    """Imported only once the window is up: it takes seconds on an Atom.
    Without a working sandbox, pages still run in their own processes."""
    global WebKit
    if "WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS" not in os.environ and not sandbox_works():
        log("WebKit sandbox unavailable, starting without it")
        os.environ["WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS"] = "1"
    from gi.repository import WebKit as webkit
    WebKit = webkit


