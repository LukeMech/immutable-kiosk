class KioskShell(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="io.github.lukemech.ImmutableKiosk")
        self.cfg = None
        self.retry_source = None
        self.loaded_url = None
        self.hmi = None
        self.settings_loaded = False
        self.hmi_error = False
        self.boot_reported = False
        self.ok_reported = False
        self.pending = None  # view to reveal once its first page is rendered
        # The HMI loads only after Settings' first page (start_hmi).
        self.hmi_started = False
        # The start-up or connecting screen shows, and the HMI replaces it
        # by itself once it has loaded. Off once Settings is opened.
        self.waiting_for_hmi = False
        self.pulse_source = None
        self.probe_gen = 0  # the newest probe_hmi; older answers are dropped
        # The HMI's page is loaded and answering: "Back to HMI" shows it;
        # otherwise the connecting screen, until it is.
        self.hmi_ready = False
        self.hmi_loading = False  # load_hmi until the page finishes or fails
        # The update card: kioskd's last /api/update, what was hidden (by
        # update_key), a fetch in flight / wanted again, timers.
        self.upd = {"phase": "idle"}
        self.upd_hidden = []
        self.upd_fetching = False
        self.upd_again = False
        self.upd_poll = None
        self.upd_pulse = None
        self.upd_timers = set()  # failed cards' keys with their auto-hide pending
        # kioskd's auto shutdown countdown (/api/power/auto): its end on this
        # process's clock, the second tick, what the card shows now.
        self.power = {"state": "idle"}
        self.power_until = None
        self.power_tick = None
        self.card_kind = "update"

    # -- setup
    def do_activate(self):
        """kiosk-splash animates while this starts; the window maps over it
        see-through until the first page is rendered."""
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        # WebKitGTK zooms pages by gtk-xft-dpi / 96, or, when that's unset
        # (as in cage), by the monitor's physical DPI: 1.97x on the 408.
        # 1 CSS px = 1 screen px; Settings' scaling is the zoom on top.
        Gtk.Settings.get_default().set_property("gtk-xft-dpi", 96 * 1024)

        self.cfg = self.wait_for_config()
        apply_output(self.cfg)  # before the first frame: no portrait flash

        self.win = Gtk.ApplicationWindow(application=self, title="Kiosk")
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, transition_duration=200)
        self.overlay = Gtk.Overlay(child=self.stack)
        self.win.set_child(self.overlay)
        self.win.add_css_class("splashing")
        splash = Gtk.Box(halign=Gtk.Align.FILL, valign=Gtk.Align.FILL)
        splash.add_css_class("splash")
        self.stack.add_named(splash, "splash")
        self.stack.add_named(self.make_connecting_view(), "connecting")
        # WebKit loads only after the window's first frame (on_first_map):
        # loading it takes seconds, and the splash must stay smooth meanwhile.
        self.win.fullscreen()
        self.win.connect("map", self.on_first_map)
        self.win.present()

    def on_first_map(self, win):
        """After the window's first painted frame: set up WebKit."""
        clock = win.get_frame_clock()
        state = {}

        def painted(_clock):
            clock.disconnect(state["id"])
            GLib.idle_add(self.setup_once)
            self.report_drawn()
        state["id"] = clock.connect("after-paint", painted)

    # -- display
    def report_drawn(self):
        """The kiosk has drawn: kioskd quits plymouth (deactivated until now)."""
        def report():
            try:
                api_post("/api/display", {}, timeout=5)
            except (OSError, ValueError) as e:
                log("display report:", e)
        threading.Thread(target=report, daemon=True).start()

    def setup_once(self):
        if not getattr(self, "set_up", False):
            self.set_up = True
            self.setup()
        return GLib.SOURCE_REMOVE

    def setup(self):
        load_webkit()
        self.settings = self.make_settings_view()
        self.stack.add_named(self.settings, "settings")

        if self.cfg.get("mode") != "installer":
            (DATA / "hmi").mkdir(parents=True, exist_ok=True)
            CACHE.mkdir(parents=True, exist_ok=True)
            # Persistent session and cookies: an HMI login with an expiry
            # survives a reboot (session-only cookies don't, by design).
            self.hmi_session = WebKit.NetworkSession.new(str(DATA / "hmi"), str(CACHE / "hmi"))
            self.hmi_session.get_cookie_manager().set_persistent_storage(
                str(DATA / "hmi" / "cookies.sqlite"), WebKit.CookiePersistentStorage.SQLITE)
            self.hmi = self.make_hmi_view()
            self.stack.add_named(self.hmi, "hmi")
            self.hotcorner = self.make_hotcorner()
            self.overlay.add_overlay(self.hotcorner)
            self.load_update_hidden()
            self.upd_card = self.make_update_card()
            self.overlay.add_overlay(self.upd_card)
            self.apply_hmi_config()
            if not self.cfg.get("hmi_url"):
                # No address at boot: an HMI set up later says nothing about
                # boot time, so the boot timing stops here.
                self.boot_reported = True
                threading.Thread(target=self.report_hmi_shown, args=(None,), daemon=True).start()
        self.apply_scale()

        # With an address: "Connecting…" now, the HMI loading, alone (two web
        # processes starting at once slow both down on an Atom); Settings
        # loads once the HMI shows or doesn't answer, at the latest after
        # 30 s (its first page also means the boot is good, report_boot_ok).
        # Without: Settings once rendered (the splash stays until then, at
        # most 30 s).
        self.waiting_for_hmi = bool(self.hmi and self.cfg.get("hmi_url"))
        if self.waiting_for_hmi:
            self.show("connecting")
            self.start_hmi()
        else:
            self.pending = "settings"
            self.ensure_settings()
        GLib.timeout_add_seconds(30, self.reveal)
        threading.Thread(target=self.listen_events, daemon=True).start()
        self.fetch_update()
        self.fetch_power()

    def start_hmi(self):
        if self.hmi and not self.hmi_started:
            self.hmi_started = True
            self.load_hmi()

    def listen_events(self):
        """kioskd's live events: a network change retries an unreachable HMI
        at once; "hmi" is kioskd's check of it (hmi_watch). (The stream is
        reopened after a minute without events.)"""
        while True:
            try:
                req = urllib.request.Request(API + "/api/events")
                with urllib.request.urlopen(req, timeout=60) as r:
                    for raw in r:
                        line = raw.decode(errors="replace").strip()
                        if not line.startswith("data:"):
                            continue
                        topics = json.loads(line[5:])
                        if "net" in topics:
                            GLib.idle_add(self.on_net_change)
                        if "job" in topics or "system" in topics:
                            GLib.idle_add(self.fetch_update)
                        if "power" in topics:
                            GLib.idle_add(self.fetch_power)
                        if "hmi" in topics:
                            try:
                                st = api_get("/api/hmi/state")
                            except (OSError, ValueError):
                                continue
                            GLib.idle_add(self.on_hmi_state, st)
            except (OSError, ValueError):
                pass
            GLib.usleep(3_000_000)

    def on_hmi_state(self, st):
        """The HMI stopped answering while on screen: the connecting screen
        (the page would only be dead). Answering again: loaded afresh, and
        shown by itself once it has (on_hmi_load_changed). Settings opened
        on purpose stays."""
        if not self.hmi or not self.hmi_started or st.get("url") != self.cfg.get("hmi_url"):
            return GLib.SOURCE_REMOVE
        if st.get("ok") is False:
            self.hmi_ready = False  # the page is dead: loaded afresh once it answers
            if self.stack.get_visible_child_name() == "hmi":
                self.waiting_for_hmi = True
                self.show("connecting")
        elif st.get("ok") and not self.hmi_loading and (self.hmi_error or not self.hmi_ready):
            self.load_hmi()
        return GLib.SOURCE_REMOVE

    def on_net_change(self):
        if self.hmi and self.hmi_error and self.retry_source:
            self.load_hmi()
        return GLib.SOURCE_REMOVE

    def reveal(self):
        """Settings' first page, or 30 s: Settings if it's the first screen;
        Settings loaded and the HMI started either way."""
        if self.pending:
            name, self.pending = self.pending, None
            self.show(name)
        self.ensure_settings()
        self.start_hmi()
        return GLib.SOURCE_REMOVE

    def open_settings(self):
        """The Settings corner held: Settings, and the HMI no longer replaces
        it by itself (Back to HMI does)."""
        self.waiting_for_hmi = False
        self.show("settings")

    def make_connecting_view(self):
        """"Connecting…" over a loading bar, as kiosk-splash draws its own
        (its colours and size)."""
        try:
            d = json.loads(SPLASH_DATA.read_text())
        except (OSError, ValueError):
            d = {}
        self.splash_data = d
        self.colours = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), self.colours,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
        self.apply_colours()
        bar = d.get("bar", {})
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=bar.get("gap", 16),
                      halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        box.add_css_class("connecting")
        self.connecting_bar = Gtk.ProgressBar(pulse_step=0.04)
        self.connecting_bar.set_size_request(int(bar.get("max", 480)), -1)
        box.append(self.connecting_bar)
        box.append(Gtk.Label(label=self.t("Łączę…", "Connecting…")))
        page = Gtk.Box(halign=Gtk.Align.FILL, valign=Gtk.Align.FILL, hexpand=True, vexpand=True)
        page.add_css_class("connecting")
        box.set_hexpand(True)
        page.append(box)
        return page

    def apply_colours(self):
        """The accent (Settings' Display tab, kiosk-splash's colours): the
        connecting screen's bar and the Settings corner's glow."""
        d = self.splash_data
        rgb = lambda c, dflt: "#%02x%02x%02x" % tuple(c) if c else dflt  # noqa: E731
        accents = d.get("accents", {})
        fill = accents.get(self.cfg.get("accent")) or accents.get(d.get("default_accent"))
        glow = "rgba(%d,%d,%d,0.6)" % tuple(fill[:3]) if fill else "rgba(47,129,247,0.6)"
        self.colours.load_from_data((
            f".connecting progressbar trough {{ background: {rgb(d.get('track'), '#2a3542')}; }}\n"
            f".connecting progressbar progress {{ background: {rgb(fill, '#2f81f7')}; }}\n"
            f".connecting label {{ color: {rgb(d.get('text'), '#e6edf3')}; }}\n"
            f".hotcorner.armed {{ background: radial-gradient(circle, {glow} 0%, transparent 70%); }}\n"
            f".updcard progressbar progress {{ background: {rgb(fill, '#2f81f7')}; }}\n"
            f".updcard .hold progressbar trough {{ background: {rgb(fill, '#2f81f7')}; }}\n"
            ".updcard .hold progressbar progress { background: rgba(255, 255, 255, 0.3); }\n"
            ).encode())

    def accent_hex(self):
        """The accent (Settings' Display tab) as #rrggbb: kiosk-splash's table
        (splash-bar.json, the same colours as Settings' app.js ACCENTS)."""
        d = getattr(self, "splash_data", {}) or {}
        accents = d.get("accents", {})
        fill = accents.get(self.cfg.get("accent")) or accents.get(d.get("default_accent"))
        return "#%02x%02x%02x" % tuple(fill[:3]) if fill else "#2f81f7"

    def pulse(self, on):
        """The connecting screen's moving segment, only while it shows."""
        if on and not self.pulse_source:
            self.pulse_source = GLib.timeout_add(40, lambda: (self.connecting_bar.pulse(), True)[1])
        elif not on and self.pulse_source:
            GLib.source_remove(self.pulse_source)
            self.pulse_source = None

    def splash_over(self):
        """After the crossfade to the first view: window opaque, splash gone."""
        if not self.win.has_css_class("splashing") or getattr(self, "splash_ending", False):
            return
        self.splash_ending = True

        def finish():
            self.win.remove_css_class("splashing")
            end_splash()
            return GLib.SOURCE_REMOVE
        GLib.timeout_add(self.stack.get_transition_duration() + 150, finish)

    def wait_for_config(self):
        # kioskd starts first, but may be slow on eMMC.
        for _ in range(60):
            try:
                return api_get("/api/config")
            except OSError:
                GLib.usleep(500_000)
        log("kioskd unreachable, starting with defaults")
        return {"mode": "kiosk", "hmi_url": "", "rotation_effective": "landscape",
                "osk_in_hmi": True, "accept_self_signed": True, "zoom": 1.0}

    def common_view_setup(self, view):
        s = view.get_settings()
        s.set_enable_developer_extras(False)
        s.set_javascript_can_open_windows_automatically(False)
        s.set_enable_back_forward_navigation_gestures(False)
        view.connect("context-menu", lambda *a: True)
        # No pinch zoom: a two-finger pinch is claimed here, in the capture
        # phase, so WebKit's own zoom gesture never gets it.
        pinch = Gtk.GestureZoom()
        pinch.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        pinch.connect("begin", lambda g, _seq: g.set_state(Gtk.EventSequenceState.CLAIMED))
        view.add_controller(pinch)

    def make_settings_view(self):
        ucm = WebKit.UserContentManager()
        ucm.register_script_message_handler("kiosk", None)
        ucm.connect("script-message-received::kiosk", self.on_settings_message)
        view = WebKit.WebView(user_content_manager=ucm,
                              network_session=WebKit.NetworkSession.new_ephemeral())
        self.common_view_setup(view)
        view.connect("decide-policy", self.settings_policy)
        view.connect("web-process-terminated", lambda v, r: v.load_uri(SETTINGS_URL))
        # kioskd restarting / not up yet: keep trying.
        view.connect("load-failed", self.settings_load_failed)
        view.connect("load-changed", self.on_any_load_changed)
        return view

    def make_hmi_view(self):
        view = WebKit.WebView(user_content_manager=WebKit.UserContentManager(),
                              network_session=self.hmi_session)
        self.common_view_setup(view)
        view.connect("load-failed", self.on_hmi_load_failed)
        view.connect("load-failed-with-tls-errors", self.on_hmi_tls_error)
        view.connect("load-changed", self.on_hmi_load_changed)
        view.connect("web-process-terminated", lambda v, r: self.load_hmi())
        # target=_blank / window.open: stay in the same view, there are no other windows.
        view.connect("create", self.on_hmi_create)
        return view

    def make_hotcorner(self):
        box = Gtk.Box(width_request=72, height_request=72)
        box.add_css_class("hotcorner")
        press = Gtk.GestureLongPress(touch_only=False)
        # ~1 s, GTK's maximum (larger factors are rejected).
        press.set_delay_factor(2.0)
        press.connect("begin", lambda *a: box.add_css_class("armed"))
        press.connect("end", lambda *a: box.remove_css_class("armed"))
        press.connect("cancelled", lambda *a: box.remove_css_class("armed"))
        press.connect("pressed", lambda *a: self.open_settings())
        box.add_controller(press)
        return box

    # -- update card
    def make_update_card(self):
        """Title and a line under it, Hide on the right; the bar under them;
        for "ready" the Hide / Hold: restart row instead."""
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, width_request=360)
        card.add_css_class("updcard")
        head = Gtk.Box(spacing=12)
        texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True, valign=Gtk.Align.CENTER)
        top = Gtk.Box(spacing=8)
        self.upd_title = Gtk.Label(xalign=0, hexpand=True, ellipsize=Pango.EllipsizeMode.END)
        self.upd_title.add_css_class("title")
        self.upd_pct = Gtk.Label(xalign=1)
        self.upd_pct.add_css_class("pct")
        top.append(self.upd_title)
        top.append(self.upd_pct)
        self.upd_sub = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END)
        self.upd_sub.add_css_class("sub")
        texts.append(top)
        texts.append(self.upd_sub)
        self.upd_hide = Gtk.Button(valign=Gtk.Align.CENTER)
        self.upd_hide.connect("clicked", lambda _b: self.cancel_power() if self.card_kind == "power"
                              else self.hide_update())
        head.append(texts)
        head.append(self.upd_hide)  # on the side away from the Settings corner: place_corners()
        self.upd_head, self.upd_texts = head, texts
        self.upd_bar = Gtk.ProgressBar(pulse_step=0.05)
        self.upd_actions = Gtk.Box(spacing=8, halign=Gtk.Align.END)
        self.upd_later = Gtk.Button()
        self.upd_later.connect("clicked", lambda _b: self.hide_update())
        self.upd_restart, self.upd_restart_label = self.make_hold_button(RESTART_HOLD_S, self.restart_now)
        self.upd_actions.append(self.upd_later)
        self.upd_actions.append(self.upd_restart)
        card.append(head)
        card.append(self.upd_bar)
        card.append(self.upd_actions)
        # A tap on the card itself (its buttons claim theirs): Settings → System.
        tap = Gtk.GestureClick()
        tap.connect("released", lambda *a: self.open_update_settings())
        card.add_controller(tap)
        rev = Gtk.Revealer(child=card, reveal_child=False, visible=False,
                           transition_type=Gtk.RevealerTransitionType.CROSSFADE, transition_duration=250)
        # Gone once faded out: nothing left there to catch a touch.
        rev.connect("notify::child-revealed", lambda r, _p: r.set_visible(r.get_reveal_child()))
        return rev

    def make_hold_button(self, seconds, on_done):
        """A button held `seconds` to act, filling up meanwhile (Settings'
        hold buttons): a bar under its label."""
        bar = Gtk.ProgressBar(valign=Gtk.Align.CENTER)
        label = Gtk.Label()
        box = Gtk.Overlay(child=bar)
        box.add_overlay(label)
        box.set_measure_overlay(label, True)
        box.add_css_class("hold")
        held = {"t0": None, "tick": None}

        def tick(widget, clock):
            done = (clock.get_frame_time() / 1e6 - held["t0"]) / seconds
            bar.set_fraction(min(1.0, done))
            if done < 1:
                return GLib.SOURCE_CONTINUE
            held.update(t0=None, tick=None)
            on_done()
            return GLib.SOURCE_REMOVE

        def press(gesture, *_a):
            gesture.set_state(Gtk.EventSequenceState.CLAIMED)  # not the card's tap
            clock = box.get_frame_clock()
            if clock and held["tick"] is None:
                held["t0"] = clock.get_frame_time() / 1e6
                held["tick"] = box.add_tick_callback(tick)

        def release(*_a):
            if held["tick"] is not None:
                box.remove_tick_callback(held["tick"])
            held.update(t0=None, tick=None)
            bar.set_fraction(0)

        def moved(gesture, dx, dy):
            ok, x, y = gesture.get_start_point()
            x, y = x + dx, y + dy
            if ok and not (0 <= x < box.get_width() and 0 <= y < box.get_height()):
                release()  # slid off the button: let go (Settings' pointerleave)

        # As Settings' holdButton (pointerdown, then pointerup / pointerleave /
        # pointercancel). A drag, not a click: GestureClick "stops" a held
        # touch after the double-click time or a few pixels of finger jitter,
        # and then never reports the release -- the bar stopped after ~1 s.
        g = Gtk.GestureDrag()
        g.connect("drag-begin", press)
        g.connect("drag-update", moved)
        g.connect("drag-end", release)
        g.connect("cancel", release)
        box.add_controller(g)
        return box, label

    def fetch_update(self):
        """kioskd's /api/update, in the background; one at a time."""
        if not self.hmi:
            return GLib.SOURCE_REMOVE
        if self.upd_fetching:
            self.upd_again = True
            return GLib.SOURCE_REMOVE
        self.upd_fetching = True

        def work():
            try:
                n = api_get("/api/update", timeout=5)
            except (OSError, ValueError):
                n = None
            GLib.idle_add(self.on_update, n)
        threading.Thread(target=work, daemon=True).start()
        return GLib.SOURCE_REMOVE

    def on_update(self, n):
        self.upd_fetching = False
        if isinstance(n, dict):
            self.upd = n
        if self.upd_again:
            self.upd_again = False
            self.fetch_update()
        self.render_update()
        # A running update on screen: its bar followed every second (the
        # install's bar is time-paced, with no events of its own).
        if self.upd_card.get_reveal_child() and self.upd.get("phase") in UPDATE_RUNNING and not self.upd_poll:
            def poll():
                self.upd_poll = None
                self.fetch_update()
                return GLib.SOURCE_REMOVE
            self.upd_poll = GLib.timeout_add(1000, poll)
        return GLib.SOURCE_REMOVE

    @staticmethod
    def update_key(n):
        """What Hide hides: a version's download and install (every try of
        it), a version's "ready", one failure."""
        phase = n.get("phase")
        if phase in UPDATE_RUNNING:
            return "run:" + (n.get("digest") or n.get("id", ""))
        if phase == "ready":
            return "ready:" + n.get("digest", "")
        return "failed:" + n.get("id", "")

    def render_update(self):
        """The card: the auto shutdown countdown over any view; otherwise
        the update, over the HMI only."""
        if not self.hmi:
            return
        view = self.stack.get_visible_child_name()
        if self.power.get("state") == "counting" and view != "splash":
            self.card_kind = "power"
            self.fill_power()
            self.update_pulse(False)
            self.upd_card.set_visible(True)
            self.upd_card.set_reveal_child(True)
            return
        self.card_kind = "update"
        n = self.upd
        phase = n.get("phase", "idle")
        on_hmi = view in ("hmi", "connecting")
        want = phase != "idle" and on_hmi and self.update_key(n) not in self.upd_hidden
        if want:
            self.fill_update(n)
            if phase == "failed":
                key = self.update_key(n)
                if key not in self.upd_timers:
                    self.upd_timers.add(key)
                    GLib.timeout_add_seconds(UPDATE_FAILED_S, lambda: (self.hide_update(key), GLib.SOURCE_REMOVE)[1])
        self.update_pulse(want and phase == "found")
        if want:
            self.upd_card.set_visible(True)
        self.upd_card.set_reveal_child(want)

    def fill_update(self, n):
        phase = n.get("phase")
        version = version_label(n.get("version")) or self.t("nowa wersja", "a new version")
        fraction = n.get("fraction")
        pct = f"{fraction * 100:.0f}%" if isinstance(fraction, (int, float)) else ""
        ready = phase == "ready"
        if phase == "found":
            title = self.t("Znaleziono aktualizację", "Update found")
            sub = self.t(f"{version} · pobieranie…", f"{version} · downloading…")
        elif phase == "download":
            title = self.t("Pobieranie aktualizacji", "Downloading the update")
            mb = n.get("mb") or {}
            sub = f"{version} · {mb['done']} / {mb['total']} MB" if mb.get("done") and mb.get("total") else version
        elif phase == "install":
            title = self.t("Instalowanie aktualizacji", "Installing the update")
            sub = self.t(f"{version} · kiosk działa normalnie", f"{version} · the kiosk keeps working")
        elif ready:
            title = self.t("Aktualizacja gotowa", "Update ready")
            sub = self.t(f"{version} włączy się po restarcie", f"{version} starts after a restart")
        else:  # failed
            title = self.t("Aktualizacja nie powiodła się", "The update failed")
            sub = (self.t("Kolejna próba później", "It will be tried again later") if n.get("background")
                   else n.get("error") or "")
        self.upd_title.set_label(title)
        self.upd_sub.set_label(sub)
        self.upd_pct.set_label(pct if phase in ("download", "install") else "")
        self.upd_pct.set_visible(phase in ("download", "install"))
        self.upd_bar.set_visible(phase in UPDATE_RUNNING)
        if phase in ("download", "install"):
            self.upd_bar.set_fraction(max(0.0, min(1.0, fraction or 0.0)))
        self.upd_hide.set_label(self.t("Ukryj", "Hide"))
        self.upd_hide.set_visible(not ready)
        self.upd_actions.set_visible(ready)
        self.upd_later.set_label(self.t("Ukryj", "Hide"))
        if not getattr(self, "restarting", False):
            self.upd_restart_label.set_label(self.t("Przytrzymaj: restart", "Hold: restart"))

    def fetch_power(self):
        """kioskd's auto shutdown countdown, in the background."""
        if not self.hmi:
            return GLib.SOURCE_REMOVE

        def work():
            try:
                n = api_get("/api/power/auto", timeout=5)
            except (OSError, ValueError):
                n = None
            GLib.idle_add(self.on_power, n)
        threading.Thread(target=work, daemon=True).start()
        return GLib.SOURCE_REMOVE

    def on_power(self, n):
        if isinstance(n, dict):
            self.power = n
            counting = n.get("state") == "counting"
            self.power_until = time.monotonic() + float(n.get("left") or 0) if counting else None
            if counting and not self.power_tick:
                self.power_tick = GLib.timeout_add(1000, self.on_power_tick)
            self.render_update()
        return GLib.SOURCE_REMOVE

    def on_power_tick(self):
        if self.power.get("state") != "counting":
            self.power_tick = None
            return GLib.SOURCE_REMOVE
        self.render_update()
        return GLib.SOURCE_CONTINUE

    def fill_power(self):
        n = self.power
        left = max(0, round((self.power_until or 0) - time.monotonic()))
        total = max(1, float(n.get("total") or 1))
        clock = f"{left // 60}:{left % 60:02d}"
        self.upd_title.set_label(self.t("Brak zasilania", "No power"))
        if n.get("action") == "poweroff":
            sub = self.t(f"Tablet wyłączy się za {clock}", f"The tablet powers off in {clock}")
        else:
            sub = self.t(f"Tablet uśpi się za {clock}", f"The tablet goes to sleep in {clock}")
        self.upd_sub.set_label(sub)
        self.upd_pct.set_visible(False)
        self.upd_bar.set_visible(True)
        self.upd_bar.set_fraction(max(0.0, min(1.0, left / total)))
        self.upd_hide.set_label(self.t("Anuluj", "Cancel"))
        self.upd_hide.set_visible(True)
        self.upd_actions.set_visible(False)

    def cancel_power(self):
        """Cancel: no auto shutdown until the charger has been back (kioskd)."""
        self.power = {"state": "idle"}
        self.render_update()

        def work():
            try:
                api_post("/api/power/auto/cancel", {}, timeout=5)
            except (OSError, ValueError) as e:
                log("auto shutdown cancel:", e)
            GLib.idle_add(self.fetch_power)
        threading.Thread(target=work, daemon=True).start()

    def update_pulse(self, on):
        """The bar's moving segment while a version is found, before bytes come."""
        if on and not self.upd_pulse:
            self.upd_pulse = GLib.timeout_add(80, lambda: (self.upd_bar.pulse(), True)[1])
        elif not on and self.upd_pulse:
            GLib.source_remove(self.upd_pulse)
            self.upd_pulse = None

    def load_update_hidden(self):
        try:
            hidden = json.loads(UPDATE_HIDDEN.read_text())
            self.upd_hidden = [k for k in hidden if isinstance(k, str)][-20:]
        except (OSError, ValueError, TypeError):
            self.upd_hidden = []

    def hide_update(self, key=None):
        """Hide: this card, and the same one again (update_key)."""
        key = key or self.update_key(self.upd)
        if key not in self.upd_hidden:
            self.upd_hidden = (self.upd_hidden + [key])[-20:]
            try:
                CACHE.mkdir(parents=True, exist_ok=True)
                (CACHE / "update-hidden.tmp").write_text(json.dumps(self.upd_hidden))
                (CACHE / "update-hidden.tmp").replace(UPDATE_HIDDEN)
            except OSError as e:
                log("update card:", e)
        self.render_update()

    def restart_now(self):
        """Held through: kioskd restarts (its restart screen comes up at once)."""
        self.restarting = True
        self.upd_restart_label.set_label(self.t("Restartowanie…", "Restarting…"))

        def work():
            try:
                api_post("/api/power", {"action": "reboot"}, timeout=10)
            except (OSError, ValueError) as e:
                log("restart:", e)
                GLib.idle_add(self.restart_failed)
        threading.Thread(target=work, daemon=True).start()

    def restart_failed(self):
        self.restarting = False
        self.render_update()
        return GLib.SOURCE_REMOVE

    def open_update_settings(self):
        """The card tapped: Settings on its System tab (kioskShown, run by
        show, opens the tab app.js was told here)."""
        self.settings.evaluate_javascript("window.kioskOpenTab && window.kioskOpenTab('system')", -1,
                                          None, None, None, None, None)
        self.open_settings()

    # -- switching
    def ensure_settings(self):
        if not self.settings_loaded:
            self.settings_loaded = True
            self.settings.load_uri(SETTINGS_URL)
        return GLib.SOURCE_REMOVE

    def show(self, name):
        if name == "hmi":
            if not self.hmi or not self.cfg.get("hmi_url"):
                return  # nothing to go back to
            if not self.hmi_ready:
                # Not loaded, or not answering: the connecting screen, and the
                # HMI replaces it once it has loaded (a failed try now again).
                self.waiting_for_hmi = True
                name = "connecting"
                self.start_hmi()
                if self.hmi_error:
                    self.load_hmi()
        self.pending = None  # an explicit switch ends the start-up screen
        if name == "settings":
            self.ensure_settings()
        self.stack.set_visible_child_name(name)
        if name == "hmi":
            self.boot_hmi_now()
        self.splash_over()
        self.pulse(name == "connecting")
        if self.hmi:
            self.hotcorner.set_visible(name in ("hmi", "connecting"))
            # The update card only over the HMI; it may have changed meanwhile.
            self.render_update()
            if name in ("hmi", "connecting"):
                self.fetch_update()
        # Settings runs behind the HMI: it refreshes on events only while shown.
        if name == "settings":
            self.settings.evaluate_javascript("window.kioskShown && window.kioskShown()", -1,
                                              None, None, None, None, None)
        elif self.settings_loaded:
            self.settings.evaluate_javascript("window.kioskHidden && window.kioskHidden()", -1,
                                              None, None, None, None, None)

    # -- config
    def apply_hmi_config(self):
        cfg = self.cfg
        self.place_corners()

        ucm = self.hmi.get_user_content_manager()
        ucm.remove_all_scripts()
        osk = bool(cfg.get("osk_in_hmi", True) and OSK_JS.exists())
        accent = json.dumps(self.accent_hex())
        if osk:
            # The accent first: osk.js colours itself with it (setAccent).
            ucm.add_script(WebKit.UserScript.new(
                f"window.__kioskOskAccent = {accent};\n" + OSK_JS.read_text(),
                WebKit.UserContentInjectedFrames.ALL_FRAMES,
                WebKit.UserScriptInjectionTime.END, None, None))
            # A new accent: the open page's keyboard recoloured at once (its
            # main frame; other frames get it with their next load).
            if self.hmi_started and getattr(self, "osk_accent", accent) != accent:
                self.hmi.evaluate_javascript(
                    f"window.__kioskOskSetAccent ? window.__kioskOskSetAccent({accent})"
                    f" : (window.__kioskOskAccent = {accent})", -1, None, None, None, None, None)
        self.osk_accent = accent
        # A user script only takes effect on the next page load: a changed
        # OSK option reloads the HMI, or the open page keeps the old one.
        osk_changed = getattr(self, "osk_loaded", osk) != osk
        self.osk_loaded = osk
        if self.hmi_started and (cfg.get("hmi_url") != self.loaded_url or osk_changed):
            self.load_hmi()

    def place_corners(self):
        """The Settings corner where configured, the update card in the same
        corner under it: the hold still works over the card (its text may sit
        under the corner), and the card's buttons go to its side away from
        the corner. Re-added rather than re-aligned: GTK doesn't move a
        placed overlay child; the corner re-added last stays on top."""
        corner = self.cfg.get("settings_corner", "top-right")
        if corner not in CORNERS:
            corner = "top-right"
        h, v = CORNERS[corner]
        self.overlay.remove_overlay(self.hotcorner)
        self.overlay.remove_overlay(self.upd_card)
        self.upd_card.set_halign(h)
        self.upd_card.set_valign(v)
        right = h == Gtk.Align.END
        # Hide / Cancel left of the text in a right corner, right of it in a left one.
        self.upd_head.reorder_child_after(self.upd_hide, None if right else self.upd_texts)
        self.upd_actions.set_halign(Gtk.Align.START if right else Gtk.Align.END)
        self.overlay.add_overlay(self.upd_card)
        self.hotcorner.set_halign(h)
        self.hotcorner.set_valign(v)
        self.overlay.add_overlay(self.hotcorner)

    def apply_scale(self):
        """Screen scaling is WebKit zoom; the HMI also gets its own zoom."""
        if not hasattr(self, "settings"):
            return  # before setup(): it applies the scale itself
        scale = screen_scale(self.cfg)
        try:
            zoom = float(self.cfg.get("zoom", 1.0))
        except (TypeError, ValueError):
            zoom = 1.0
        self.set_zoom(self.settings, scale)
        if self.hmi:
            self.set_zoom(self.hmi, scale * zoom)

    @staticmethod
    def set_zoom(view, level):
        if abs(view.get_zoom_level() - level) >= 0.001:
            view.set_zoom_level(level)

    def reload_config(self):
        try:
            self.cfg = api_get("/api/config")
        except OSError as e:
            log("reload config:", e)
            return
        apply_output(self.cfg)
        self.apply_colours()  # the accent may have changed
        if self.hmi:
            self.apply_hmi_config()
        self.apply_scale()

    # -- HMI loading
    def load_hmi(self):
        """The HMI's page, once probe_hmi has its server answering. Never
        straight to WebKit: offline it can render a stale copy of the HMI
        (its cache or the HMI's service worker) whose buttons do nothing."""
        self.cancel_retry()
        url = self.cfg.get("hmi_url")
        self.loaded_url = url
        self.probe_gen += 1
        self.hmi_ready = False
        self.hmi_loading = bool(url)
        if not url:
            # No address (cleared): no HMI and nothing to wait for.
            self.hmi_error = False
            self.waiting_for_hmi = False
            if self.stack.get_visible_child_name() in ("hmi", "connecting"):
                self.show("settings")
            return
        gen = self.probe_gen

        def probe():
            err = probe_hmi(url)
            GLib.idle_add(self.after_probe, gen, url, err)
        threading.Thread(target=probe, daemon=True).start()

    def after_probe(self, gen, url, err):
        if gen != self.probe_gen:
            return GLib.SOURCE_REMOVE  # a newer load_hmi took over
        if err is None:
            self.hmi_error = False
            self.hmi.load_uri(url)
        else:
            self.hmi_failed(self.probe_reason(err))
        return GLib.SOURCE_REMOVE

    def probe_reason(self, err):
        """probe_hmi's failure in words (Settings' language)."""
        if isinstance(err, urllib.error.URLError) and isinstance(err.reason, BaseException):
            err = err.reason
        if isinstance(err, int):
            return self.t(f"Serwer odpowiada błędem {err}: wizualizacja jeszcze nie działa.",
                          f"The server answers with error {err}: the HMI isn't running yet.")
        if isinstance(err, socket.gaierror):
            return self.t("Adres nie jest znany w tej sieci. Czy kiosk jest w sieci HMI?",
                          "The address isn't known on this network. Is the kiosk on the HMI's network?")
        if isinstance(err, (socket.timeout, TimeoutError)):
            return self.t("Serwer nie odpowiada.", "The server doesn't answer.")
        if isinstance(err, ConnectionRefusedError):
            return self.t("Serwer odrzuca połączenie (zły port albo HMI nie działa).",
                          "The server refuses the connection (wrong port, or the HMI isn't running).")
        if isinstance(err, OSError) and err.errno in (errno.ENETUNREACH, errno.EHOSTUNREACH, errno.ENETDOWN):
            return self.t("Brak drogi do serwera: kiosk nie jest w sieci HMI.",
                          "No route to the server: the kiosk isn't on the HMI's network.")
        return self.t("Serwer nie odpowiada poprawnie.", "The server doesn't answer properly.")

    def cancel_retry(self):
        if self.retry_source:
            GLib.source_remove(self.retry_source)
            self.retry_source = None

    def schedule_retry(self):
        self.cancel_retry()
        # With Settings open, kioskd's check (on_hmi_state) loads the HMI as
        # soon as it answers; this retries a page that failed to load.

        def fire():
            self.retry_source = None
            self.load_hmi()
            return GLib.SOURCE_REMOVE
        self.retry_source = GLib.timeout_add_seconds(RETRY_S, fire)

    def t(self, pl, en):
        """kiosk-shell's own texts in Settings' language (English by default)."""
        return pl if (self.cfg or {}).get("language", "en") == "pl" else en

    def hmi_failed(self, reason):
        """No HMI for now: tried again shortly, and the connecting screen
        instead of it if it's on screen. Settings stays."""
        log("HMI:", reason)
        self.hmi_error = True
        self.hmi_ready = False
        self.hmi_loading = False
        self.ensure_settings()
        self.schedule_retry()
        if self.stack.get_visible_child_name() == "hmi":
            self.waiting_for_hmi = True
            self.show("connecting")

    def on_hmi_load_failed(self, view, event, uri, error):
        if is_benign(error):
            return False
        self.hmi_failed(error.message)
        return True

    def on_hmi_tls_error(self, view, uri, certificate, errors):
        host = urlsplit(uri).hostname or ""
        hmi_host = urlsplit(self.cfg.get("hmi_url", "")).hostname or ""
        if self.cfg.get("accept_self_signed", True) and host and host == hmi_host:
            # The HMI's self-signed certificate, for the HMI host only.
            self.hmi_session.allow_tls_certificate_for_host(certificate, host)
            view.load_uri(uri)
            return True
        self.hmi_failed(self.t(f"Serwer {host} przedstawił niezaufany certyfikat. "
                               "Włącz „Akceptuj certyfikat serwera HMI” w Ustawieniach.",
                               f"The server {host} presented an untrusted certificate. "
                               "Turn on “Accept the HMI server's certificate” in Settings."))
        return True

    def on_any_load_changed(self, view, event):
        """The first page rendered by any view means the boot is good
        (kioskd tells boot-counter; see automatic rollback)."""
        if event == WebKit.LoadEvent.FINISHED and view is self.settings and self.pending == "settings":
            self.reveal()
        if event == WebKit.LoadEvent.FINISHED and not self.ok_reported:
            self.ok_reported = True
            threading.Thread(target=self.report_boot_ok, daemon=True).start()

    def report_boot_ok(self):
        for _ in range(10):
            try:
                api_post("/api/boot/ok", {}, timeout=150)
                return
            except (OSError, ValueError) as e:
                log("boot ok:", e)
                GLib.usleep(5_000_000)

    def on_hmi_load_changed(self, view, event):
        self.on_any_load_changed(view, event)
        if self.hmi_error:
            return  # a failed load's end, or its retry would be cancelled
        if event == WebKit.LoadEvent.COMMITTED:
            self.cancel_retry()
        elif event == WebKit.LoadEvent.FINISHED:
            self.hmi_ready = True
            self.hmi_loading = False
            if self.waiting_for_hmi:
                # The start-up / connecting screen until now: the HMI replaces it.
                self.waiting_for_hmi = False
                if self.stack.get_visible_child_name() in ("splash", "connecting"):
                    self.show("hmi")
            # Settings opened on purpose meanwhile: the HMI is ready behind it.
            self.boot_hmi_now()
            # Settings loads now, behind it, after a head start for the HMI's scripts.
            GLib.timeout_add_seconds(3, self.ensure_settings)

    def boot_hmi_now(self):
        """Settings' boot timing: the HMI on screen, once per boot -- when the
        splash or "Connecting…" gives way to it (show), or when it has loaded
        behind Settings opened on purpose. Timed here, on the same clock as
        the journal (CLOCK_MONOTONIC): kioskd may handle the report later."""
        if not self.boot_reported:
            self.boot_reported = True
            threading.Thread(target=self.report_hmi_shown, args=(time.monotonic(),), daemon=True).start()

    @staticmethod
    def report_hmi_shown(at):
        """`at`: CLOCK_MONOTONIC seconds; None: no HMI address at boot."""
        for _ in range(5):
            try:
                api_post("/api/boot/hmi", {"unconfigured": True} if at is None else {"at": at}, timeout=10)
                return
            except (OSError, ValueError) as e:
                log("boot timing:", e)
                GLib.usleep(3_000_000)

    def on_hmi_create(self, view, action):
        uri = action.get_request().get_uri()
        if uri:
            view.load_uri(uri)
        return None

    # -- settings view
    def settings_policy(self, view, decision, kind):
        if kind == WebKit.PolicyDecisionType.NAVIGATION_ACTION:
            uri = decision.get_navigation_action().get_request().get_uri()
            if not uri.startswith(API + "/"):
                decision.ignore()
                return True
        elif kind == WebKit.PolicyDecisionType.NEW_WINDOW_ACTION:
            decision.ignore()
            return True
        return False

    def settings_load_failed(self, view, event, uri, error):
        if is_benign(error):
            return False
        GLib.timeout_add_seconds(2, lambda: (view.load_uri(SETTINGS_URL), GLib.SOURCE_REMOVE)[1])
        view.load_alternate_html("<body style='background:#10151c;color:#9aa7b4;font:20px sans-serif;"
                                 "display:grid;place-items:center;height:100vh;margin:0'>" +
                                 self.t("Uruchamianie…", "Starting…") + "</body>",
                                 uri, None)
        return True

    def on_settings_message(self, ucm, value):
        try:
            msg = json.loads(value.to_string())
        except ValueError:
            return
        cmd = msg.get("cmd")
        if cmd == "show-hmi":
            self.show("hmi")
        elif cmd == "config-changed":
            self.reload_config()


def main():
    app = KioskShell()
    return app.run(sys.argv[:1])


if __name__ == "__main__":
    sys.exit(main())
