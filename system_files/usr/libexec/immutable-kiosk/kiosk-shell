def is_benign(error):
    """A load replaced by another one (navigation, our own retry) -- not a failure."""
    if error.domain == "WebKitNetworkError":
        return error.code == int(WebKit.NetworkError.CANCELLED)
    if error.domain == "WebKitPolicyError":
        return error.code == int(WebKit.PolicyError.FRAME_LOAD_INTERRUPTED_BY_POLICY_CHANGE)
    return False


def esc(s):
    return (str(s).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;"))


# ------------------------------------------------------------ app

class KioskShell(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="io.github.lukemech.ImmutableKiosk")
        self.cfg = None
        self.retry_source = None
        self.loaded_url = None
        self.hmi = None
        self.settings_loaded = False
        self.hmi_error = False
        self.boot_reported = False
        self.ok_reported = False
        self.pending = None  # view to reveal once its first page is rendered
        # The HMI loads only after Settings' first page (start_hmi).
        self.hmi_started = False
        # From the start until the HMI has loaded: Settings shows, and the
        # HMI replaces it by itself once its server answers.
        self.waiting_for_hmi = False
        self.probe_gen = 0  # the newest probe_hmi; older answers are dropped

    # -- setup
    def do_activate(self):
        """kiosk-splash animates while this starts; the window maps over it
        see-through until the first page is rendered."""
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        # WebKitGTK zooms pages by gtk-xft-dpi / 96, or, when that's unset
        # (as in cage), by the monitor's physical DPI: 1.97x on the 408.
        # 1 CSS px = 1 screen px; Settings' scaling is the zoom on top.
        Gtk.Settings.get_default().set_property("gtk-xft-dpi", 96 * 1024)

        self.cfg = self.wait_for_config()
        apply_output(self.cfg)  # before the first frame: no portrait flash

        self.win = Gtk.ApplicationWindow(application=self, title="Kiosk")
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, transition_duration=200)
        self.overlay = Gtk.Overlay(child=self.stack)
        self.win.set_child(self.overlay)
        self.win.add_css_class("splashing")
        splash = Gtk.Box(halign=Gtk.Align.FILL, valign=Gtk.Align.FILL)
        splash.add_css_class("splash")
        self.stack.add_named(splash, "splash")
        # WebKit loads only after the window's first frame (on_first_map):
        # loading it takes seconds, and the splash must stay smooth meanwhile.
        self.win.fullscreen()
        self.win.connect("map", self.on_first_map)
        self.win.present()

    def on_first_map(self, win):
        """After the window's first painted frame: set up WebKit."""
        clock = win.get_frame_clock()
        state = {}

        def painted(_clock):
            clock.disconnect(state["id"])
            GLib.idle_add(self.setup_once)
            self.report_drawn()
        state["id"] = clock.connect("after-paint", painted)

    # -- display
    def report_drawn(self):
        """The kiosk has drawn: kioskd quits plymouth (deactivated until now)."""
        def report():
            try:
                api_post("/api/display", {}, timeout=5)
            except (OSError, ValueError) as e:
                log("display report:", e)
        threading.Thread(target=report, daemon=True).start()

    def setup_once(self):
        if not getattr(self, "set_up", False):
            self.set_up = True
            self.setup()
        return GLib.SOURCE_REMOVE

    def setup(self):
        load_webkit()
        self.settings = self.make_settings_view()
        self.stack.add_named(self.settings, "settings")

        if self.cfg.get("mode") != "installer":
            (DATA / "hmi").mkdir(parents=True, exist_ok=True)
            CACHE.mkdir(parents=True, exist_ok=True)
            # Persistent session and cookies: an HMI login with an expiry
            # survives a reboot (session-only cookies don't, by design).
            self.hmi_session = WebKit.NetworkSession.new(str(DATA / "hmi"), str(CACHE / "hmi"))
            self.hmi_session.get_cookie_manager().set_persistent_storage(
                str(DATA / "hmi" / "cookies.sqlite"), WebKit.CookiePersistentStorage.SQLITE)
            self.hmi = self.make_hmi_view()
            self.stack.add_named(self.hmi, "hmi")
            self.hotcorner = self.make_hotcorner()
            self.overlay.add_overlay(self.hotcorner)
            self.apply_hmi_config()
            if not self.cfg.get("hmi_url"):
                # No address at boot: an HMI set up later says nothing about
                # boot time, so the boot timing stops here.
                self.boot_reported = True
                threading.Thread(target=self.report_hmi_shown, args=(False,), daemon=True).start()
        self.apply_scale()

        # Settings first, always: the HMI only once its server answers
        # (start_hmi, after Settings' first page). The splash stays until
        # that page is rendered, at most 30 s.
        self.pending = "settings"
        self.ensure_settings()
        GLib.timeout_add_seconds(30, self.reveal)
        threading.Thread(target=self.listen_events, daemon=True).start()

    def start_hmi(self):
        """After Settings' first page: two web processes starting at once
        slow both down on an Atom."""
        if self.hmi and not self.hmi_started:
            self.hmi_started = True
            if self.cfg.get("hmi_url"):
                self.set_waiting(True)
            self.load_hmi()

    def listen_events(self):
        """kioskd's live events: a network change retries an unreachable HMI
        at once. (The stream is reopened after a minute without events.)"""
        while True:
            try:
                req = urllib.request.Request(API + "/api/events")
                with urllib.request.urlopen(req, timeout=60) as r:
                    for raw in r:
                        line = raw.decode(errors="replace").strip()
                        if line.startswith("data:") and "net" in json.loads(line[5:]):
                            GLib.idle_add(self.on_net_change)
            except (OSError, ValueError):
                pass
            GLib.usleep(3_000_000)

    def on_net_change(self):
        if self.hmi and self.hmi_error and self.retry_source:
            self.load_hmi()
        return GLib.SOURCE_REMOVE

    def set_waiting(self, on):
        self.waiting_for_hmi = on
        self.tell_settings_waiting()

    def tell_settings_waiting(self):
        if self.settings_loaded:
            self.settings.evaluate_javascript(
                f"window.kioskWaiting && window.kioskWaiting({'true' if self.waiting_for_hmi else 'false'})",
                -1, None, None, None, None, None)

    def reveal(self):
        if self.pending:
            name, self.pending = self.pending, None
            self.show(name)
        self.start_hmi()
        return GLib.SOURCE_REMOVE

    def splash_over(self):
        """After the crossfade to the first view: window opaque, splash gone."""
        if not self.win.has_css_class("splashing") or getattr(self, "splash_ending", False):
            return
        self.splash_ending = True

        def finish():
            self.win.remove_css_class("splashing")
            end_splash()
            return GLib.SOURCE_REMOVE
        GLib.timeout_add(self.stack.get_transition_duration() + 150, finish)

    def wait_for_config(self):
        # kioskd starts first, but may be slow on eMMC.
        for _ in range(60):
            try:
                return api_get("/api/config")
            except OSError:
                GLib.usleep(500_000)
        log("kioskd unreachable, starting with defaults")
        return {"mode": "kiosk", "hmi_url": "", "rotation_effective": "landscape",
                "osk_in_hmi": True, "accept_self_signed": True, "zoom": 1.0, "retry_seconds": 10}

    def common_view_setup(self, view):
        s = view.get_settings()
        s.set_enable_developer_extras(False)
        s.set_javascript_can_open_windows_automatically(False)
        s.set_enable_back_forward_navigation_gestures(False)
        view.connect("context-menu", lambda *a: True)
        # No pinch zoom: a two-finger pinch is claimed here, in the capture
        # phase, so WebKit's own zoom gesture never gets it.
        pinch = Gtk.GestureZoom()
        pinch.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        pinch.connect("begin", lambda g, _seq: g.set_state(Gtk.EventSequenceState.CLAIMED))
        view.add_controller(pinch)

    def make_settings_view(self):
        ucm = WebKit.UserContentManager()
        ucm.register_script_message_handler("kiosk", None)
        ucm.connect("script-message-received::kiosk", self.on_settings_message)
        view = WebKit.WebView(user_content_manager=ucm,
                              network_session=WebKit.NetworkSession.new_ephemeral())
        self.common_view_setup(view)
        view.connect("decide-policy", self.settings_policy)
        view.connect("web-process-terminated", lambda v, r: v.load_uri(SETTINGS_URL))
        # kioskd restarting / not up yet: keep trying.
        view.connect("load-failed", self.settings_load_failed)
        view.connect("load-changed", self.on_any_load_changed)
        return view

    def make_hmi_view(self):
        ucm = WebKit.UserContentManager()
        ucm.register_script_message_handler("kioskNav", None)
        ucm.connect("script-message-received::kioskNav", self.on_hmi_nav)
        view = WebKit.WebView(user_content_manager=ucm, network_session=self.hmi_session)
        self.common_view_setup(view)
        view.connect("load-failed", self.on_hmi_load_failed)
        view.connect("load-failed-with-tls-errors", self.on_hmi_tls_error)
        view.connect("load-changed", self.on_hmi_load_changed)
        view.connect("web-process-terminated", lambda v, r: self.load_hmi())
        # target=_blank / window.open: stay in the same view, there are no other windows.
        view.connect("create", self.on_hmi_create)
        return view

    def make_hotcorner(self):
        box = Gtk.Box(width_request=72, height_request=72)
        box.add_css_class("hotcorner")
        press = Gtk.GestureLongPress(touch_only=False)
        # ~1 s, GTK's maximum (larger factors are rejected).
        press.set_delay_factor(2.0)
        press.connect("begin", lambda *a: box.add_css_class("armed"))
        press.connect("end", lambda *a: box.remove_css_class("armed"))
        press.connect("cancelled", lambda *a: box.remove_css_class("armed"))
        press.connect("pressed", lambda *a: self.show("settings"))
        box.add_controller(press)
        return box

    # -- switching
    def ensure_settings(self):
        if not self.settings_loaded:
            self.settings_loaded = True
            self.settings.load_uri(SETTINGS_URL)
        return GLib.SOURCE_REMOVE

    def show(self, name):
        if name == "hmi" and not self.hmi:
            return
        self.pending = None  # an explicit switch ends the start-up screen
        if name == "settings":
            self.ensure_settings()
        self.stack.set_visible_child_name(name)
        self.splash_over()
        if self.hmi:
            self.hotcorner.set_visible(name == "hmi")
        # Settings runs behind the HMI: it refreshes on events only while shown.
        if name == "settings":
            self.settings.evaluate_javascript("window.kioskShown && window.kioskShown()", -1,
                                              None, None, None, None, None)
            self.tell_settings_waiting()
        elif self.settings_loaded:
            self.settings.evaluate_javascript("window.kioskHidden && window.kioskHidden()", -1,
                                              None, None, None, None, None)

    # -- config
    def apply_hmi_config(self):
        cfg = self.cfg
        self.place_corners()

        ucm = self.hmi.get_user_content_manager()
        ucm.remove_all_scripts()
        osk = bool(cfg.get("osk_in_hmi", True) and OSK_JS.exists())
        if osk:
            ucm.add_script(WebKit.UserScript.new(
                OSK_JS.read_text(), WebKit.UserContentInjectedFrames.ALL_FRAMES,
                WebKit.UserScriptInjectionTime.END, None, None))
        # A user script only takes effect on the next page load: a changed
        # OSK option reloads the HMI, or the open page keeps the old one.
        osk_changed = getattr(self, "osk_loaded", osk) != osk
        self.osk_loaded = osk
        if self.hmi_started and (cfg.get("hmi_url") != self.loaded_url or osk_changed):
            self.load_hmi()

    def place_corners(self):
        """The Settings corner where configured. Re-added rather than
        re-aligned: GTK doesn't move a placed overlay child."""
        corner = self.cfg.get("settings_corner", "top-right")
        if corner not in CORNERS:
            corner = "top-right"
        h, v = CORNERS[corner]
        self.overlay.remove_overlay(self.hotcorner)
        self.hotcorner.set_halign(h)
        self.hotcorner.set_valign(v)
        self.overlay.add_overlay(self.hotcorner)

    def apply_scale(self):
        """Screen scaling is WebKit zoom; the HMI also gets its own zoom."""
        if not hasattr(self, "settings"):
            return  # before setup(): it applies the scale itself
        scale = screen_scale(self.cfg)
        try:
            zoom = float(self.cfg.get("zoom", 1.0))
        except (TypeError, ValueError):
            zoom = 1.0
        self.set_zoom(self.settings, scale)
        if self.hmi:
            self.set_zoom(self.hmi, scale * zoom)

    @staticmethod
    def set_zoom(view, level):
        if abs(view.get_zoom_level() - level) >= 0.001:
            view.set_zoom_level(level)

    def reload_config(self):
        try:
            self.cfg = api_get("/api/config")
        except OSError as e:
            log("reload config:", e)
            return
        apply_output(self.cfg)
        if self.hmi:
            self.apply_hmi_config()
        self.apply_scale()

    # -- HMI loading
    def load_hmi(self):
        """The HMI's page, once probe_hmi has its server answering. Never
        straight to WebKit: offline it can render a stale copy of the HMI
        (its cache or the HMI's service worker) whose buttons do nothing."""
        self.cancel_retry()
        url = self.cfg.get("hmi_url")
        self.loaded_url = url
        self.probe_gen += 1
        if not url:
            self.show_error(self.t("Brak adresu HMI", "No HMI address"),
                            self.t("Ustaw adres wizualizacji w Ustawieniach.", "Set the HMI's address in Settings."),
                            None)
            return
        gen = self.probe_gen

        def probe():
            err = probe_hmi(url)
            GLib.idle_add(self.after_probe, gen, url, err)
        threading.Thread(target=probe, daemon=True).start()

    def after_probe(self, gen, url, err):
        if gen != self.probe_gen:
            return GLib.SOURCE_REMOVE  # a newer load_hmi took over
        if err is None:
            self.hmi_error = False
            self.hmi.load_uri(url)
        else:
            self.show_error(self.t("Brak połączenia z HMI", "Can't reach the HMI"),
                            self.t("Nie można otworzyć", "Couldn't open") +
                            f" <code>{esc(url)}</code>.<br>{esc(self.probe_reason(err))}", url)
        return GLib.SOURCE_REMOVE

    def probe_reason(self, err):
        """probe_hmi's failure in words (Settings' language)."""
        if isinstance(err, urllib.error.URLError) and isinstance(err.reason, BaseException):
            err = err.reason
        if isinstance(err, int):
            return self.t(f"Serwer odpowiada błędem {err}: wizualizacja jeszcze nie działa.",
                          f"The server answers with error {err}: the HMI isn't running yet.")
        if isinstance(err, socket.gaierror):
            return self.t("Adres nie jest znany w tej sieci. Czy kiosk jest w sieci HMI?",
                          "The address isn't known on this network. Is the kiosk on the HMI's network?")
        if isinstance(err, (socket.timeout, TimeoutError)):
            return self.t("Serwer nie odpowiada.", "The server doesn't answer.")
        if isinstance(err, ConnectionRefusedError):
            return self.t("Serwer odrzuca połączenie (zły port albo HMI nie działa).",
                          "The server refuses the connection (wrong port, or the HMI isn't running).")
        if isinstance(err, OSError) and err.errno in (errno.ENETUNREACH, errno.EHOSTUNREACH, errno.ENETDOWN):
            return self.t("Brak drogi do serwera: kiosk nie jest w sieci HMI.",
                          "No route to the server: the kiosk isn't on the HMI's network.")
        return self.t("Serwer nie odpowiada poprawnie.", "The server doesn't answer properly.")

    def cancel_retry(self):
        if self.retry_source:
            GLib.source_remove(self.retry_source)
            self.retry_source = None

    def schedule_retry(self):
        self.cancel_retry()
        secs = int(self.cfg.get("retry_seconds", 10))
        if self.waiting_for_hmi:
            secs = min(secs, 5)  # Settings shows meanwhile: retry often

        def fire():
            self.retry_source = None
            self.load_hmi()
            return GLib.SOURCE_REMOVE
        self.retry_source = GLib.timeout_add_seconds(secs, fire)
        return secs

    def t(self, pl, en):
        """kiosk-shell's own texts in Settings' language (English by default)."""
        return pl if (self.cfg or {}).get("language", "en") == "pl" else en

    def show_error(self, title, detail, failing_uri):
        self.hmi_error = True
        self.ensure_settings()  # the error page's "Settings" button is the way out
        secs = self.schedule_retry() if failing_uri else 0
        html = ERROR_PAGE.format(
            title=esc(title), detail=detail, retry=secs, lang=(self.cfg or {}).get("language", "en"),
            retry_in=self.t("Ponowna próba za", "Trying again in"), settings=self.t("Ustawienia", "Settings"),
            retry_now=self.t("Spróbuj teraz", "Try now"))
        self.hmi.load_alternate_html(html, failing_uri or "about:blank", None)

    def on_hmi_load_failed(self, view, event, uri, error):
        if is_benign(error):
            return False
        self.show_error(self.t("Brak połączenia z HMI", "Can't reach the HMI"),
                        self.t("Nie można otworzyć", "Couldn't open") +
                        f" <code>{esc(uri)}</code>.<br>{esc(error.message)}", uri)
        return True

    def on_hmi_tls_error(self, view, uri, certificate, errors):
        host = urlsplit(uri).hostname or ""
        hmi_host = urlsplit(self.cfg.get("hmi_url", "")).hostname or ""
        if self.cfg.get("accept_self_signed", True) and host and host == hmi_host:
            # The HMI's self-signed certificate, for the HMI host only.
            self.hmi_session.allow_tls_certificate_for_host(certificate, host)
            view.load_uri(uri)
            return True
        self.show_error(self.t("Niezaufany certyfikat", "Untrusted certificate"),
                        self.t(f"Serwer <code>{esc(host)}</code> przedstawił niezaufany certyfikat. "
                               "Włącz „Akceptuj certyfikat HMI” w Ustawieniach.",
                               f"The server <code>{esc(host)}</code> presented an untrusted certificate. "
                               "Turn on “Accept the HMI's certificate” in Settings."), uri)
        return True

    def on_any_load_changed(self, view, event):
        """The first page rendered by any view means the boot is good
        (kioskd tells boot-counter; see automatic rollback)."""
        if event == WebKit.LoadEvent.FINISHED and view is self.settings:
            self.tell_settings_waiting()  # a reloaded page has lost it
        if event == WebKit.LoadEvent.FINISHED and view is self.settings and self.pending == "settings":
            self.reveal()
        if event == WebKit.LoadEvent.FINISHED and not self.ok_reported:
            self.ok_reported = True
            threading.Thread(target=self.report_boot_ok, daemon=True).start()

    def report_boot_ok(self):
        for _ in range(10):
            try:
                api_post("/api/boot/ok", {}, timeout=150)
                return
            except (OSError, ValueError) as e:
                log("boot ok:", e)
                GLib.usleep(5_000_000)

    def on_hmi_load_changed(self, view, event):
        self.on_any_load_changed(view, event)
        if self.hmi_error:
            return  # the error page, or its retry would be cancelled
        if event == WebKit.LoadEvent.COMMITTED:
            self.cancel_retry()
        elif event == WebKit.LoadEvent.FINISHED:
            if self.waiting_for_hmi:
                # Settings until now: the HMI replaces it by itself.
                self.set_waiting(False)
                if self.stack.get_visible_child_name() == "settings":
                    self.show("hmi")
            if not self.boot_reported:
                # For Settings' boot timing.
                self.boot_reported = True
                threading.Thread(target=self.report_hmi_shown, daemon=True).start()

    @staticmethod
    def report_hmi_shown(configured=True):
        try:
            api_post("/api/boot/hmi", {} if configured else {"unconfigured": True}, timeout=5)
        except (OSError, ValueError) as e:
            log("boot timing:", e)

    def on_hmi_create(self, view, action):
        uri = action.get_request().get_uri()
        if uri:
            view.load_uri(uri)
        return None

    def on_hmi_nav(self, ucm, value):
        cmd = value.to_string()
        if cmd == "settings":
            self.show("settings")
        elif cmd == "retry":
            self.load_hmi()

    # -- settings view
    def settings_policy(self, view, decision, kind):
        if kind == WebKit.PolicyDecisionType.NAVIGATION_ACTION:
            uri = decision.get_navigation_action().get_request().get_uri()
            if not uri.startswith(API + "/"):
                decision.ignore()
                return True
        elif kind == WebKit.PolicyDecisionType.NEW_WINDOW_ACTION:
            decision.ignore()
            return True
        return False

    def settings_load_failed(self, view, event, uri, error):
        if is_benign(error):
            return False
        GLib.timeout_add_seconds(2, lambda: (view.load_uri(SETTINGS_URL), GLib.SOURCE_REMOVE)[1])
        view.load_alternate_html("<body style='background:#10151c;color:#9aa7b4;font:20px sans-serif;"
                                 "display:grid;place-items:center;height:100vh;margin:0'>" +
                                 self.t("Uruchamianie…", "Starting…") + "</body>",
                                 uri, None)
        return True

    def on_settings_message(self, ucm, value):
        try:
            msg = json.loads(value.to_string())
        except ValueError:
            return
        cmd = msg.get("cmd")
        if cmd == "show-hmi":
            self.show("hmi")
        elif cmd == "config-changed":
            self.reload_config()
        elif cmd == "reload-hmi" and self.hmi:
            self.load_hmi()
            self.show("hmi")


def main():
    app = KioskShell()
    return app.run(sys.argv[:1])


if __name__ == "__main__":
    sys.exit(main())
