def version_label(v):
    """As Settings' labelVersion: "v45.20261122.1-778b844" -> "v45.20261122.1"."""
    m = re.match(r"^(v\d+\.\d{8}(?:\.\d+)?)-[0-9a-f]{7,}$", v or "")
    return m.group(1) if m else (v or "")

