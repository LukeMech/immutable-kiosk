def api_get(path, timeout=2):
    req = urllib.request.Request(API + path, headers={"X-Kiosk": "1"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read())


def api_post(path, data, timeout=20):
    req = urllib.request.Request(API + path, data=json.dumps(data).encode(), method="POST",
                                 headers={"X-Kiosk": "1", "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read())


# ------------------------------------------------------------ rotation

# Built-in panels first: the touchscreen sits on them.
INTERNAL_OUTPUTS = ("eDP", "DSI", "LVDS")

def wlr_outputs():
    """[(name, width, height)] of enabled outputs, the current mode in the
    panel's native orientation."""
    try:
        out = subprocess.run(["wlr-randr", "--json"], capture_output=True, text=True, timeout=5)
        outputs = json.loads(out.stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired) as e:
        log("wlr-randr failed:", e)
        return []
    result = []
    for o in outputs:
        if not o.get("enabled", True):
            continue
        mode = next((m for m in o.get("modes", []) if m.get("current")), None)
        if mode:
            result.append((o["name"], mode["width"], mode["height"]))
    return result


def screen_scale(cfg):
    try:
        return min(2.0, max(1.0, float(cfg.get("scale", 1.0))))
    except (TypeError, ValueError):
        return 1.0


def apply_output(cfg):
    """Rotation for every output, never a mode (a modeset blanks the DSI
    panel for a second or two). The compositor scale stays 1:
    screen scaling is WebKit zoom (KioskShell.apply_scale), since a
    fractional output scale rendered wrong and stuck until cage restarted."""
    rotation = cfg.get("rotation_effective", "landscape")
    scale = 1
    outputs = sorted(wlr_outputs(), key=lambda o: not o[0].startswith(INTERNAL_OUTPUTS))
    touch_transform = None
    panel = ""
    applied = []
    for name, w, h in outputs:
        if rotation == "portrait":
            transform = "90" if w > h else "normal"
        elif rotation == "landscape":
            transform = "90" if h > w else "normal"
        else:
            transform = rotation
        subprocess.run(["wlr-randr", "--output", name, "--transform", transform,
                        "--scale", str(scale)], timeout=5)
        applied.append(f"{name} {transform}\n")
        if touch_transform is None:
            touch_transform = transform
            panel = name if name.startswith(INTERNAL_OUTPUTS) else ""
    # kiosk-session applies these at the next start, before the first frame.
    try:
        CACHE.mkdir(parents=True, exist_ok=True)
        (CACHE / "outputs.tmp").write_text("".join(applied))
        (CACHE / "outputs.tmp").replace(CACHE / "outputs")
    except OSError as e:
        log("output cache:", e)
    # Touch and the boot splash follow the panel (kioskd r_touch_set). In
    # the background: at start-up this runs before the first frame.
    if touch_transform:
        def set_touch():
            try:
                api_post("/api/touch", {"transform": touch_transform, "output": panel})
            except (OSError, ValueError) as e:
                log("touch rotation:", e)
        threading.Thread(target=set_touch, daemon=True).start()


# kiosk-splash (started by kiosk-session); not passed on to WebKit's processes.
SPLASH_PID = os.environ.pop("KIOSK_SPLASH_PID", "")


def end_splash():
    """Stop kiosk-splash once this window shows something."""
    if SPLASH_PID.isdigit():
        try:
            os.kill(int(SPLASH_PID), signal.SIGTERM)
        except OSError:
            pass


# ------------------------------------------------------------ HMI probe

class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *a, **kw):
        return None  # a redirect (e.g. to the login page) is an answer too


def probe_hmi(url):
    """None if the HMI's server answers over HTTP(S) now, else why not (an
    exception, or a gateway error's status: the proxy is up, the HMI behind
    it isn't). Any certificate: this only asks whether the server is there,
    WebKit then checks the certificate itself."""
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), _NoRedirect,
                                         urllib.request.HTTPSHandler(context=ctx))
    try:
        with opener.open(urllib.request.Request(url, headers={"Cache-Control": "no-cache"}), timeout=5) as r:
            status = r.status
    except urllib.error.HTTPError as e:
        status = e.code
    except (OSError, ValueError, http.client.HTTPException) as e:
        return e
    return status if status in (502, 503, 504) else None


# ------------------------------------------------------------ helpers

def is_benign(error):
    """A load replaced by another one (navigation, our own retry) -- not a failure."""
    if error.domain == "WebKitNetworkError":
        return error.code == int(WebKit.NetworkError.CANCELLED)
    if error.domain == "WebKitPolicyError":
        return error.code == int(WebKit.PolicyError.FRAME_LOAD_INTERRUPTED_BY_POLICY_CHANGE)
    return False


