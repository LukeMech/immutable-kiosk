def api_get(path, timeout=2):
    req = urllib.request.Request(API + path, headers={"X-Kiosk": "1"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read())


def api_post(path, data, timeout=20):
    req = urllib.request.Request(API + path, data=json.dumps(data).encode(), method="POST",
                                 headers={"X-Kiosk": "1", "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read())


# ------------------------------------------------------------ rotation

# Built-in panels first: that's the one the touchscreen sits on.
INTERNAL_OUTPUTS = ("eDP", "DSI", "LVDS")

def wlr_outputs():
    """[(name, width, height)] of enabled outputs, size in the panel's native orientation."""
    try:
        out = subprocess.run(["wlr-randr", "--json"], capture_output=True, text=True, timeout=5)
        outputs = json.loads(out.stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired) as e:
        log("wlr-randr failed:", e)
        return []
    result = []
    for o in outputs:
        if not o.get("enabled", True):
            continue
        mode = next((m for m in o.get("modes", []) if m.get("current")), None)
        if mode:
            result.append((o["name"], mode["width"], mode["height"]))
    return result


def wlr_state():
    """[{name, mode: [w, h], transform, scale}] of enabled outputs, as cage has them."""
    try:
        out = subprocess.run(["wlr-randr", "--json"], capture_output=True, text=True, timeout=5)
        outputs = json.loads(out.stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return []
    result = []
    for o in outputs:
        if not o.get("enabled", True):
            continue
        mode = next((m for m in o.get("modes", []) if m.get("current")), {})
        result.append({"name": o.get("name"), "mode": [mode.get("width"), mode.get("height")],
                       "transform": o.get("transform"), "scale": o.get("scale"),
                       "modes": [{"w": m.get("width"), "h": m.get("height"),
                                  "refresh": round(m.get("refresh") or 0, 2),
                                  "preferred": bool(m.get("preferred"))} for m in o.get("modes", [])]})
    return result


def screen_scale(cfg):
    try:
        return min(2.0, max(1.0, float(cfg.get("scale", 1.0))))
    except (TypeError, ValueError):
        return 1.0


def apply_output(cfg):
    """Rotation for every output.

    The compositor's scale stays at 1, always set explicitly: a fractional
    output scale (wlr-randr --scale 1.25) made GTK/WebKit render far bigger
    than 125 %, and going back to 1 didn't undo it until cage restarted.
    Screen scaling (Settings > Ekran) is WebKit zoom on both views instead
    (KioskShell.apply_scale) -- sharp at any step, and it can't get stuck.
    """
    rotation = cfg.get("rotation_effective", "landscape")
    scale = 1
    outputs = sorted(wlr_outputs(), key=lambda o: not o[0].startswith(INTERNAL_OUTPUTS))
    touch_transform = None
    panel = ""
    applied = []
    for name, w, h in outputs:
        if rotation == "portrait":
            transform = "90" if w > h else "normal"
        elif rotation == "landscape":
            transform = "90" if h > w else "normal"
        else:
            transform = rotation
        # The mode (Ekran > Rozdzielczość) only for the built-in panel; any
        # other output keeps its preferred one.
        res = cfg.get("resolution") if name.startswith(INTERNAL_OUTPUTS) else None
        mode = ["--mode", res.replace("@", "@") + ("Hz" if "@" in res else "")] if res else ["--preferred"]
        log(f"output {name} {w}x{h}: transform {transform} ({rotation}), mode {res or 'preferred'}")
        subprocess.run(["wlr-randr", "--output", name, *mode, "--transform", transform,
                        "--scale", str(scale)], timeout=5)
        applied.append(f"{name} {transform} {res or 'preferred'}\n")
        if touch_transform is None:
            touch_transform = transform
            panel = name if name.startswith(INTERNAL_OUTPUTS) else ""
    # kiosk-session applies these at the next start before anything is drawn:
    # kiosk-splash comes up rotated already.
    try:
        CACHE.mkdir(parents=True, exist_ok=True)
        (CACHE / "outputs.tmp").write_text("".join(applied))
        (CACHE / "outputs.tmp").replace(CACHE / "outputs")
    except OSError as e:
        log("output cache:", e)
    # Touch follows the panel: kioskd sets libinput's calibration matrix
    # (udev) and restarts cage once if it changed -- see kioskd r_touch_set.
    # The built-in panel's name lets kioskd turn the boot splash too.
    # In the background: at start-up this runs before the first frame.
    if touch_transform:
        def set_touch():
            try:
                r = api_post("/api/touch", {"transform": touch_transform, "output": panel})
                if r.get("restart"):
                    log(f"touch matrix changed to transform {touch_transform}, cage restarts")
            except (OSError, ValueError) as e:
                log("touch rotation:", e)
        threading.Thread(target=set_touch, daemon=True).start()


def end_splash():
    """kiosk-splash (kiosk-session) has been on screen under our window:
    once the first page shows, it's not needed any more."""
    pid = os.environ.pop("KIOSK_SPLASH_PID", "")
    if pid.isdigit():
        try:
            os.kill(int(pid), signal.SIGTERM)
        except OSError:
            pass


