#!/bin/sh
# cage's client: restore kiosk-shell's last rotation before the first frame,
# start kiosk-splash, then exec kiosk-shell (it ends the splash; cage exits with it).
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/immutable-kiosk"
if [ -r "$CACHE/outputs" ]; then
    while read -r name transform res; do
        [ -n "$name" ] && [ -n "$transform" ] || continue
        # The preferred mode is already up: no mode means no modeset (the DSI
        # panel would go dark for a second or two).
        case "$res" in
            ""|preferred) mode="" ;;
            *@*) mode="--mode ${res}Hz" ;;
            *) mode="--mode $res" ;;
        esac
        # shellcheck disable=SC2086
        wlr-randr --output "$name" $mode --transform "$transform" --scale 1 2>/dev/null
    done < "$CACHE/outputs"
fi
/usr/libexec/immutable-kiosk/kiosk-splash &
KIOSK_SPLASH_PID=$!
export KIOSK_SPLASH_PID
exec /usr/libexec/immutable-kiosk/kiosk-shell
