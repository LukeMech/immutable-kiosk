KIOSK_SPLASH = "/usr/libexec/immutable-kiosk/kiosk-splash"


def power_off(action):
    """systemctl reboot / poweroff, with the kiosk's restart / power-off
    screen up first: it shows at once, not when systemd gets to cage, and it
    is what stays on screen until Plymouth's identical one (kiosk-splash
    --shutdown). kiosk-splash returns once it's on screen (at most ~3 s)."""
    import pwd
    try:
        pw = pwd.getpwnam("kiosk")
    except KeyError:
        pw = None
    runtime = f"/run/user/{pw.pw_uid}" if pw else None
    if pw:
        try:
            subprocess.run([KIOSK_SPLASH, "--shutdown", "reboot" if action == "reboot" else "shutdown"],
                           user=pw.pw_uid, group=pw.pw_gid, extra_groups=[], cwd="/",
                           env={"PATH": "/usr/bin", "HOME": pw.pw_dir, "XDG_RUNTIME_DIR": runtime},
                           stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, timeout=10)
        except (OSError, subprocess.SubprocessError) as e:
            print(f"kioskd: shutdown screen: {e}", flush=True)
    p = subprocess.run(["systemctl", action], capture_output=True, text=True, timeout=30)
    if p.returncode != 0:
        # No shutdown after all: the kiosk again (the screen's pid: its marker).
        if runtime:
            try:
                pid = int(Path(runtime, "kiosk-shutdown-screen").read_text().strip())
                if b"kiosk-splash" in Path(f"/proc/{pid}/cmdline").read_bytes():
                    os.kill(pid, 9)
            except (OSError, ValueError):
                pass
        raise ApiError(cmd_error(p, "systemctl"))


def touchscreens():
    found = []
    for ev in Path("/sys/class/input").glob("event*"):
        props = subprocess.run(["udevadm", "info", "-q", "property", str(ev)],
                               capture_output=True, text=True, timeout=5).stdout
        if "ID_INPUT_TOUCHSCREEN=1" in props.splitlines():
            found.append(str(ev))
    return found


def r_touch_set(body, q):
    """Make touch follow the panel transform kiosk-shell reports.

    libinput reads the matrix only when a device is added: each touchscreen
    is removed and added again (udev events), and cage picks it up as a
    hotplugged device -- no restart.
    """
    transform = str(body.get("transform", ""))
    matrix = TOUCH_MATRICES.get(transform)
    if not matrix:
        raise ApiError("Unknown orientation")
    # The boot splash follows the built-in panel (kiosk-shell names it) and
    # the accent and language (re-checked at every start: a new deployment's
    # boot entries come without the extra initramfs).
    def splash():
        set_splash_orientation(str(body.get("output") or ""), transform)
        set_splash_look()
        set_grub_splash(str(body.get("output") or ""), transform)
    threading.Thread(target=splash, daemon=True).start()
    rule = (
        "# Written by kioskd: touch follows the screen rotation "
        f"(wlr-randr transform {transform}).\n"
        'ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", '
        f'ENV{{ID_INPUT_TOUCHSCREEN}}=="1", ENV{{LIBINPUT_CALIBRATION_MATRIX}}="{matrix}"\n'
    )
    try:
        current = TOUCH_RULE.read_text()
    except OSError:
        current = None
    if current == rule:
        return {"changed": False, "restart": False}
    TOUCH_RULE.parent.mkdir(parents=True, exist_ok=True)
    tmp = TOUCH_RULE.with_suffix(".tmp")
    tmp.write_text(rule)
    tmp.replace(TOUCH_RULE)
    run(["udevadm", "control", "--reload"], timeout=10)
    devices = touchscreens()
    for action in ("remove", "add"):
        for dev in devices:
            run(["udevadm", "trigger", f"--action={action}", dev], check=False, timeout=10)
        run(["udevadm", "settle", "--timeout=5"], check=False, timeout=10)
    return {"changed": True, "restart": False}


def r_system(body, q):
    # During upgrade/switch `bootc status` blocks on the sysroot lock: use the
    # last good status.
    job = CURRENT_JOB
    cached = LAST_STATUS["value"]
    if job and job.state == "running" and job.kind != "install" and cached:
        st = dict(cached, checked=LAST_CHECK, busy=True)
    else:
        st = bootc_status()
        if not st.get("available") and cached:
            st = dict(cached, checked=LAST_CHECK, stale=st.get("error"))
    # Written by boot-counter after an automatic fallback to the previous version.
    try:
        st["fallback"] = json.loads(BOOT_FALLBACK_NOTE.read_text())
    except (OSError, ValueError):
        st["fallback"] = None
    # Used by Settings to label old builds' "latest.<date>-<sha>" versions.
    try:
        st["fedora"] = next((ln.split("=", 1)[1].strip().strip('"') for ln in
                             Path("/usr/lib/os-release").read_text().splitlines()
                             if ln.startswith("VERSION_ID=")), None)
    except OSError:
        st["fedora"] = None
    st["components"] = components()
    return st


