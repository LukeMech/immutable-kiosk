    if not st.get("available"):
        raise ApiError(st.get("error") or "bootc is unavailable")
    current = (st.get("staged") or st.get("booted") or {}).get("image", "")
    if not current:
        raise ApiError("Can't tell which image the system runs from")
    repo, _ = split_image(current)
    image = f"{repo}:{CHANNELS[channel]['tag']}"
    if image == current:
        raise ApiError(Msg("The system is already on the {channel} channel", channel=CHANNELS[channel]["name"]))
    return start_job("switch", Msg("Switching to the {channel} channel", channel=CHANNELS[channel]["name"]),
                     job_switch(image), BOOTC_STEPS).as_dict()


ROLLBACK_STEPS = [("rollback", "Set the previous version as default"),
                  ("reboot", "Restart")]


def job_rollback(job):
    """bootc rollback, then reboot; if already queued only reboot (rollback toggles)."""
    st = bootc_status()
    if not st.get("available"):
        raise RuntimeError(st.get("error") or "bootc is unavailable")
    prev = st.get("rollback")
    if not prev:
        raise RuntimeError("There's no previous version")
    job.step("rollback", f"Version {prev.get('version') or prev.get('digest', '')[7:19]}")
    if st.get("rollback_queued"):
        job.add_log("Rollback already set: restart only")
    else:
        for line in run(["bootc", "rollback"], timeout=180).splitlines():
            job.add_log(line)
    job.result = bootc_status()
    job.step("reboot", "The system restarts into the previous version")
    time.sleep(2)  # the page gets to show this step
    power_off("reboot")
    # The reboot should have ended this process.
    time.sleep(120)
    raise RuntimeError("The system didn't restart — the previous version will start on the next boot")


def r_system_rollback(body, q):
    return start_job("rollback", "Restoring the previous version", job_rollback, ROLLBACK_STEPS).as_dict()


