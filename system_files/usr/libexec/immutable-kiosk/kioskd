# ---------------------------------------------------------------- touch rotation
#
# cage maps touch to an output only if the device names one, which these
# touchscreens don't, so touch keeps the panel's native axes. A udev rule
# sets LIBINPUT_CALIBRATION_MATRIX to match the output transform:
# x' = a*x + b*y + c, y' = d*x + e*y + f on normalized (0..1) coordinates.
TOUCH_MATRICES = {
    "normal": "1 0 0 0 1 0",
    "90": "0 -1 1 1 0 0",
    "180": "-1 0 1 0 -1 1",
    "270": "0 1 0 -1 0 1",
}
TOUCH_RULE = Path("/etc/udev/rules.d/99-immutable-kiosk-touch.rules")
CAGE_UNIT = "immutable-kiosk-cage.service"

# Plymouth learns rotation only from video=<connector>:panel_orientation=.
# A Settings rotation rewrites it in the BLS entries' options lines; ostree
# reads kargs back from there, so it survives bootc upgrade. (Not `ostree
# admin kargs edit-in-place`: it only appends, and the kernel takes the
# first video=<connector>.) HP 408: left_side_up is the kiosk's "90".
PANEL_ORIENTATIONS = {"normal": "normal", "90": "left_side_up",
                      "180": "upside_down", "270": "right_side_up"}
BLS_ENTRIES = Path("/boot/loader/entries")
_splash_lock = threading.Lock()
# GET /api/splash: rewriting takes seconds; a restart mid-way keeps the old rotation.
SPLASH_STATE = {"state": None, "orientation": None, "error": None,
                "look": {"state": None, "what": None, "error": None}}


def splash_state(**changes):
    SPLASH_STATE.update(changes)
    EVENTS.emit("splash")


def set_splash_orientation(output, transform):
    orientation = PANEL_ORIENTATIONS.get(transform)
    if not orientation or not re.fullmatch(r"[A-Za-z]+-[A-Za-z0-9-]+", output or ""):
        return
    prefix = f"video={output}:panel_orientation="
    want = prefix + orientation
    with _splash_lock:
        present = set()
        for entry in BLS_ENTRIES.glob("*.conf"):
            try:
                lines = entry.read_text().splitlines()
            except OSError:
                continue
            for line in lines:
                if line.startswith("options "):
                    present.update(a for a in line.split()[1:] if a.startswith(prefix))
        if present == {want}:
            return
        splash_state(state="working", orientation=orientation, error=None)
        try:
            for entry in sorted(BLS_ENTRIES.glob("*.conf")):
                text = entry.read_text()
                lines = []
                for line in text.splitlines():
                    if line.startswith("options "):
                        args = [a for a in line.split()[1:] if not a.startswith(prefix)] + [want]
                        line = "options " + " ".join(args)
                    lines.append(line)
                new = "\n".join(lines) + "\n"
                if new != text:
                    p = subprocess.run([BOOT_COUNTER, "write-boot", str(entry.resolve())], input=new.encode(),
                                       capture_output=True, timeout=60)
                    if p.returncode != 0:
                        raise ApiError(p.stderr.decode(errors="replace").strip() or f"write-boot: {p.returncode}")
            splash_state(state="done")
        except (ApiError, OSError, subprocess.TimeoutExpired) as e:
            print(f"kioskd: boot splash orientation {want}: {e}", flush=True)
            splash_state(state="failed", error=text_of(e))


SPLASH_DATA = Path("/usr/share/immutable-kiosk/splash-bar.json")
# ostree's own place for extra initramfs images ("overlay initrds"): it only
# accepts /ostree/initramfs-overlays/<sha256>.img in a boot entry -- any other
# extra initrd line breaks `bootc status` (and with it updates and rollback).
OVERLAYS = Path("/boot/ostree/initramfs-overlays")
OLD_ACCENT_INITRD = "immutable-kiosk-accent.img"   # 2a89877's, rejected by ostree


def png_bytes(w, h, rgba):
    """rgba: w*h (r, g, b, a) tuples, straight alpha 0..255."""
    def chunk(tag, data):
        return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)
    raw = b"".join(b"\0" + b"".join(bytes(rgba[y * w + x]) for x in range(w)) for y in range(h))
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 6, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(raw, 9)) + chunk(b"IEND", b""))


def cpio_newc(files):
    """An uncompressed initramfs (newc cpio): [(path, data or None for a dir)]."""
    out = bytearray()

    def add(ino, name, mode, data):
        name = name.encode() + b"\0"
        fields = (ino, mode, 0, 0, 1, 0, len(data), 0, 0, 0, 0, len(name), 0)
        out.extend(b"070701" + "".join(f"{v:08X}" for v in fields).encode() + name)
        out.extend(b"\0" * (-len(out) % 4))
        out.extend(data)
        out.extend(b"\0" * (-len(out) % 4))
    for ino, (path, data) in enumerate(files, 1):
        add(ino, path, 0o040755 if data is None else 0o100644, b"" if data is None else data)
    add(0, "TRAILER!!!", 0, b"")
    return bytes(out)


def cleanup_overlays():
    """Overlay initramfs images no boot entry uses any more (an old accent or
    language), and 2a89877's misnamed one, go."""
    used = set()
    for entry in BLS_ENTRIES.glob("*.conf"):
        try:
            used.update(Path(ln.split()[1]).name for ln in entry.read_text().splitlines()
                        if ln.startswith("initrd ") and len(ln.split()) > 1)
        except OSError:
            continue
    old = [f for f in OVERLAYS.glob("*.img") if f.name not in used] if OVERLAYS.is_dir() else []
    old += [p for p in (Path("/boot") / OLD_ACCENT_INITRD,) if p.exists()]
    for f in old:
        p = subprocess.run([BOOT_COUNTER, "remove-boot", str(f)], capture_output=True, timeout=60)
        if p.returncode != 0:
            print(f"kioskd: removing {f}: {p.stderr.decode(errors='replace').strip()}", flush=True)


def set_splash_look(what=""):
    """The boot screen in Settings' accent and language. Plymouth can't read
    the settings: its script loads the accent's bar pieces and a language
    marker from the overrides directory when they're there (splash-bar.json
    "overrides", /etc/immutable-kiosk/splash). At shutdown that's this
    system's /etc; at boot plymouth runs from the image's initramfs, so the
    same files also go into an ostree overlay initramfs on /boot, loaded
    after it (a second `initrd` line in every boot entry). Defaults (blue, English): no
    files, no extra initramfs. `what` -- "accent" or "language" -- is the
    card in Settings that shows the progress."""
    try:
        d = json.loads(SPLASH_DATA.read_text())
    except (OSError, ValueError) as e:
        print(f"kioskd: boot screen look: {e}", flush=True)
        return
    cfg = load_config()
    accent = cfg.get("accent") if cfg.get("accent") in d["accents"] else d["default_accent"]
    files = {}
    if accent != d["default_accent"]:
        r, g, b = d["accents"][accent]
        cap, bh = d["bar"]["cap"], d["bar"]["h"]
        for end in ("l", "r"):
            files[f"fill-{end}.png"] = png_bytes(cap, bh, [(r, g, b, a) for a in base64.b64decode(d[f"cap_{end}"])])
        files["fill-m.png"] = png_bytes(1, bh, [(r, g, b, 255)] * bh)
    if cfg.get("language") == "pl":
        files["lang-pl.png"] = png_bytes(1, 1, [(0, 0, 0, 0)])
    overrides = Path(d["overrides"])
    def ours(path):
        return "/ostree/initramfs-overlays/" in path or path.endswith(f"/{OLD_ACCENT_INITRD}")
    with _splash_lock:
        try:
            # What has to change: /etc's files, the extra initramfs, the entries.
            stale = [f for f in overrides.glob("*") if f.name not in files] if overrides.is_dir() else []
            etc_new = {n: v for n, v in files.items()
                       if not (overrides / n).exists() or (overrides / n).read_bytes() != v}
            boot = []
            if files:
                tree = []
                parts = overrides.relative_to("/").parts
                for i in range(1, len(parts) + 1):
                    tree.append(("/".join(parts[:i]), None))
                tree += [(f"{'/'.join(parts)}/{n}", v) for n, v in sorted(files.items())]
                image = cpio_newc(tree)
                target = OVERLAYS / f"{hashlib.sha256(image).hexdigest()}.img"
                if not target.exists():
                    boot.append((target, image))
            for entry in sorted(BLS_ENTRIES.glob("*.conf")):
                text = entry.read_text()
                lines = [ln for ln in text.splitlines()
                         if not (ln.startswith("initrd ") and ln.split()[1:2] and ours(ln.split()[1]))]
                if files:
                    initrds = [i for i, ln in enumerate(lines) if ln.startswith("initrd ")]
                    if not initrds:
                        continue
                    # The same root as the entry's own initramfs (/ or /boot).
                    own = lines[initrds[-1]].split()[1]
                    prefix = "/boot" if own.startswith("/boot/") else ""
                    lines.insert(initrds[-1] + 1, f"initrd {prefix}/ostree/initramfs-overlays/{target.name}")
                new = "\n".join(lines) + "\n"
                if new != text:
                    boot.append((entry.resolve(), new.encode()))
            if not (stale or etc_new or boot):
                cleanup_overlays()
                return
            # Shown in Settings (accent or language card), as the rotation is.
            splash_state(look={"state": "working", "what": what, "error": None})
            overrides.mkdir(parents=True, exist_ok=True)
            for f in stale:
                f.unlink()
            for n, v in etc_new.items():
                tmp = overrides / f".{n}.tmp"
                tmp.write_bytes(v)
                tmp.replace(overrides / n)
            for path, data in boot:
                p = subprocess.run([BOOT_COUNTER, "write-boot", str(path)], input=data,
                                   capture_output=True, timeout=60)
                if p.returncode != 0:
                    raise ApiError(p.stderr.decode(errors="replace").strip() or f"write-boot: {p.returncode}")
            cleanup_overlays()
            splash_state(look={"state": "done", "what": what, "error": None})
        except (ApiError, OSError, subprocess.TimeoutExpired) as e:
            print(f"kioskd: boot screen look: {e}", flush=True)
            splash_state(look={"state": "failed", "what": what, "error": text_of(e)})


# ---------------------------------------------------------------- GRUB's boot screen
#
# Until i915 is up (~8 s) Plymouth can't draw, and GRUB reading the kernel
# and the initramfs through the firmware is most of that. So GRUB shows the
# boot screen's first frame -- the empty bar, "Starting…" -- from its start,
# and that frame stays while the kernel boots (fbcon waits for text, quiet
# prints none, i915.fastboot keeps the firmware's framebuffer) until
# Plymouth draws the same frame there (immutable-kiosk.script: no fade-in).
#
# Fedora's signed GRUB has no PNG background without a module it doesn't
# contain (gfxterm_background), and can't load one under Secure Boot. What
# it has built in: gfxterm and fonts. So the frame becomes a font: its 8x16
# tiles, already turned for the panel, as glyphs (kiosk-splash.pf2), printed
# in GRUB's 16 colours, dithered where the colour lies between one and black.
#
# console.cfg (bootupd's grub.cfg sources it before the boot entries; ours
# alone, nothing else writes it) loads the fonts, switches to gfxterm, draws
# the frame, and sets blsuki_save_default / save_default: every boot entry
# then starts with "savedefault" -- defined there to draw the frame again,
# after GRUB clears the screen to boot. Entries' commands must not fail (an
# error holds the boot 10 s for "Press any key"), so the entries only call
# it when everything worked; no console.cfg, no "savedefault" either.

GRUB_DIR = Path("/boot/grub2")
GRUB_CONSOLE_CFG = GRUB_DIR / "console.cfg"
GRUB_FONT = GRUB_DIR / "kiosk-splash.pf2"
GRUB_FONT_NAME = "kiosk-splash"
CELL_W, CELL_H = 8, 16          # glyph cell (Unifont's, the menu's fallback font)
FONT_DESCENT = 2                # below the baseline, of CELL_H (as Unifont)
GFXTERM_BORDER = 10             # gfxterm's text starts this far in (DEFAULT_BORDER_WIDTH)
# GRUB's palette (grub_video_fbstd_colors), black left out: it's the background.
GRUB_COLORS = {"blue": (0, 0, 168), "green": (0, 168, 0), "cyan": (0, 168, 168),
               "red": (168, 0, 0), "magenta": (168, 0, 168), "brown": (168, 84, 0),
               "light-gray": (168, 168, 168), "dark-gray": (84, 84, 84),
               "light-blue": (84, 84, 254), "light-green": (84, 254, 84),
               "light-cyan": (84, 254, 254), "light-red": (254, 84, 84),
               "light-magenta": (254, 84, 254), "yellow": (254, 254, 84), "white": (254, 254, 254)}
BAYER = (0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5)
# The panel the kiosk last reported (r_touch_set): output, wlr-randr transform.
_panel = {"output": None, "transform": None}


def native_mode(output):
    """(w, h) of a connector's preferred mode -- the size of the firmware's
    framebuffer GRUB draws into. No output named: the first connected one."""
    drm = Path("/sys/class/drm")
    dirs = sorted(drm.glob(f"card*-{output}")) if output else []
    if not dirs:
        dirs = [d for d in sorted(drm.glob("card*-*"))
                if (d / "status").is_file() and (d / "status").read_text().strip() == "connected"]
    for d in dirs:
        try:
            first = (d / "modes").read_text().split()
        except OSError:
            continue
        m = re.fullmatch(r"(\d+)x(\d+)\D*", first[0]) if first else None
        if m:
            return int(m[1]), int(m[2])
    return None


def boot_frame(nw, nh, transform, d, accent, lang):
    """Plymouth's first boot frame (immutable-kiosk.script at stage 0: the
    track, set_fill(0, 2 * CAP), label-0) on black, RGB, in the panel's
    native nw x nh, turned the way Plymouth turns it (wlr-randr transform:
    content rotated that many degrees counter-clockwise). Also returns the
    native bounding box of what was drawn."""
    lw, lh = (nh, nw) if transform in ("90", "270") else (nw, nh)
    buf = bytearray(nw * nh * 3)
    box = [nw, nh, -1, -1]

    def blend(u, v, rgb, a):
        if a <= 0 or not (0 <= u < lw and 0 <= v < lh):
            return
        if transform == "90":
            x, y = v, lw - 1 - u
        elif transform == "180":
            x, y = nw - 1 - u, nh - 1 - v
        elif transform == "270":
            x, y = nw - 1 - v, u
        else:
            x, y = u, v
        i = (y * nw + x) * 3
        for c in range(3):
            buf[i + c] = (rgb[c] * a + buf[i + c] * (255 - a) + 127) // 255
        box[:] = [min(box[0], x), min(box[1], y), max(box[2], x), max(box[3], y)]

    bar = d["bar"]
    bh, cap = bar["h"], bar["cap"]
    # The script's sums: BW, BX, BY, LY; the label centred (Math.Int).
    bw = int(min(lw * bar["frac"], bar["max"]) / 2) * 2
    bx, by = (lw - bw) // 2, lh // 2 - bh // 2
    ly = by + bh + bar["gap"]
    cap_l, cap_r = base64.b64decode(d["cap_l"]), base64.b64decode(d["cap_r"])

    def piece(x0, w, alphas, rgb):
        for j in range(bh):
            for i in range(w):
                blend(x0 + i, by + j, rgb, alphas[j * w + i] if alphas else 255)
    track, fill = tuple(d["track"]), tuple(d["accents"][accent])
    piece(bx, cap, cap_l, track)
    piece(bx + cap, bw - 2 * cap, None, track)
    piece(bx + bw - cap, cap, cap_r, track)
    piece(bx + cap, 1, None, fill)          # the fill's middle, 1 px under its ends
    piece(bx, cap, cap_l, fill)
    piece(bx + cap, cap, cap_r, fill)
    lab = d["boot_labels"][lang]
    a = base64.b64decode(lab["a"])
    lx = (lw - lab["w"]) // 2
    text = tuple(d["text"])
    for j in range(lab["h"]):
        for i in range(lab["w"]):
            blend(lx + i, ly + j, text, a[j * lab["w"] + i])
    return buf, box


def nearest_grub_colour(rgb):
    return min(GRUB_COLORS, key=lambda n: sum((a - b) ** 2 for a, b in zip(GRUB_COLORS[n], rgb)))


def accent_grub_colour(rgb):
    """The GRUB colour that best gives rgb as a share of it on black, as
    frame_tiles draws: the hue counts, not the plain distance (that made
    green dark-gray -- a white dot on the 408)."""
    def err(n):
        f = GRUB_COLORS[n]
        sh = min(max(sum(a * b for a, b in zip(rgb, f)) / sum(b * b for b in f), 0.0), 1.0)
        return sum((a - sh * b) ** 2 for a, b in zip(rgb, f))
    return min(GRUB_COLORS, key=err)


def frame_tiles(buf, nw, nh, box, palette):
    """The frame in gfxterm's grid: {(col, row): (colour name, bits)}, bits
    CELL_W x CELL_H 0/1 row-major. Per cell the colour of `palette` (GRUB
    colour names) that best gives its pixels as a share of that colour on
    black; a dim share is Bayer-dithered (continuous across cells)."""
    c0, r0 = (box[0] - GFXTERM_BORDER) // CELL_W, (box[1] - GFXTERM_BORDER) // CELL_H
    c1, r1 = (box[2] - GFXTERM_BORDER) // CELL_W, (box[3] - GFXTERM_BORDER) // CELL_H
    tiles = {}
    for row in range(max(r0, 0), r1 + 1):
        for col in range(max(c0, 0), c1 + 1):
            px = []
            for j in range(CELL_H):
                y = GFXTERM_BORDER + row * CELL_H + j
                for i in range(CELL_W):
                    x = GFXTERM_BORDER + col * CELL_W + i
                    k = (y * nw + x) * 3 if x < nw and y < nh else -1
                    px.append((x, y, tuple(buf[k:k + 3]) if k >= 0 else (0, 0, 0)))
            if all(max(t) < 6 for _, _, t in px):
                continue
            # Per distinct colour, not per pixel: a cell has only a few
            # (the track one or two), and this runs on the Atom.
            counts = {}
            for _, _, t in px:
                counts[t] = counts.get(t, 0) + 1
            best = None
            for name in palette:
                f = GRUB_COLORS[name]
                ff = f[0] * f[0] + f[1] * f[1] + f[2] * f[2]
                err, share = 0, {}
                for t, n in counts.items():
                    sh = min(max((t[0] * f[0] + t[1] * f[1] + t[2] * f[2]) / ff, 0.0), 1.0)
                    err += n * ((t[0] - sh * f[0]) ** 2 + (t[1] - sh * f[1]) ** 2 + (t[2] - sh * f[2]) ** 2)
                    share[t] = sh
                if best is None or err < best[0]:
                    best = (err, name, share)
            _, name, share = best
            shares = [share[t] for _, _, t in px]
            # Something solid in it (text, the accent's dot): crisp edges.
            # Only a dim colour (the track) is dithered -- as a share of
            # light, not of sRGB values: the eye averages light, and an sRGB
            # share lit the track up far brighter than Plymouth's.
            if max(shares) > 0.85:
                bits = tuple(1 if s >= 0.5 else 0 for s in shares)
            else:
                lf = [(c / 255) ** 2.2 for c in GRUB_COLORS[name]]
                lff = sum(c * c for c in lf)
                lin = {t: min(max(sum((c / 255) ** 2.2 * f for c, f in zip(t, lf)) / lff, 0.0), 1.0)
                       for t in counts}
                bits = tuple(1 if lin[t] * 16 > BAYER[(y % 4) * 4 + x % 4] + 0.5 else 0
                             for x, y, t in px)
            if any(bits):
                tiles[col, row] = (name, bits)
    return tiles


def pf2_font(glyphs):
    """A GRUB PFF2 font: glyphs {code: bits}, CELL_W x CELL_H each, filling
    the cell, plus an empty space. Ascent 14 + descent 2 as Unifont's (the
    fallback font is drawn on our baseline); GRUB refuses a font whose
    descent is 0 ("missing some required data")."""
    def sec(tag, data):
        return tag + struct.pack(">I", len(data)) + data
    u16 = lambda v: struct.pack(">H", v)
    head = (sec(b"FILE", b"PFF2") + sec(b"NAME", GRUB_FONT_NAME.encode() + b"\0")
            + sec(b"FAMI", GRUB_FONT_NAME.encode() + b"\0") + sec(b"WEIG", b"normal\0")
            + sec(b"SLAN", b"normal\0") + sec(b"PTSZ", u16(CELL_H)) + sec(b"MAXW", u16(CELL_W))
            + sec(b"MAXH", u16(CELL_H)) + sec(b"ASCE", u16(CELL_H - FONT_DESCENT))
            + sec(b"DESC", u16(FONT_DESCENT)))
    glyphs = {**glyphs, 32: (0,) * (CELL_W * CELL_H)}
    codes = sorted(glyphs)
    data_at = len(head) + 8 + 9 * len(codes) + 8
    index, data = bytearray(), bytearray()
    for code in codes:
        bits = glyphs[code]
        index += struct.pack(">IBI", code, 0, data_at + len(data))
        packed = bytearray((len(bits) + 7) // 8)
        for i, b in enumerate(bits):
            if b:
                packed[i // 8] |= 0x80 >> (i % 8)
        # Top at the cell's top: baseline (ascent) - y offset - height.
        data += struct.pack(">HHhhh", CELL_W, CELL_H, 0, -FONT_DESCENT, CELL_W) + packed
    return head + sec(b"CHIX", bytes(index)) + b"DATA" + struct.pack(">I", 0xFFFFFFFF) + bytes(data)


def grub_splash_files(nw, nh, transform, d, accent, lang, key=""):
    """(console.cfg text, kiosk-splash.pf2 bytes), or None if the frame
    doesn't fit gfxterm's grid. `key`: console.cfg's first line, what it
    was made from (set_grub_splash)."""
    buf, box = boot_frame(nw, nh, transform, d, accent, lang)
    if box[2] < 0:
        return None
    # Two colours: the text's (the track too, dithered) and the accent's.
    # GRUB puts the whole screen through the firmware at every echo -- a
    # second or more on the 408 for one echo per row; this way the frame
    # takes as many echos as colour changes: two or three.
    palette = {nearest_grub_colour(d["text"]), accent_grub_colour(d["accents"][accent])}
    tiles = frame_tiles(buf, nw, nh, box, palette)
    columns = (nw - 2 * GFXTERM_BORDER) // CELL_W
    rows = (nh - 2 * GFXTERM_BORDER) // CELL_H
    # Lines shorter than the screen (a full one wraps), none scrolled away.
    if not tiles or max(c for c, _ in tiles) >= columns - 1 or max(r for _, r in tiles) >= rows - 2:
        return None
    codes, glyphs = {}, {}
    for _, bits in tiles.values():
        if bits not in codes:
            codes[bits] = 0xE000 + len(codes)    # Private Use Area
            glyphs[codes[bits]] = bits
    # The grid row by row as one text (line breaks as echo -e's backslash-n),
    # a new part only where the colour changes (spaces and breaks take any).
    parts = []                                  # [colour or None, text]
    last = max(r for _, r in tiles)
    for row in range(last + 1):
        col = 0
        for c in sorted(c for c, r in tiles if r == row):
            name, bits = tiles[c, row]
            if not parts or parts[-1][0] not in (name, None):
                parts.append([name, ""])
            parts[-1][0] = name
            parts[-1][1] += " " * (c - col) + chr(codes[bits])
            col = c + 1
        if row < last:
            if not parts:
                parts.append([None, ""])
            parts[-1][1] += "\\n"
    lines = []
    for name, text in parts:
        if name:
            lines.append(f"  set color_normal={name}/black")
        lines.append(f"  echo -e -n '{text}'")
    cfg = f"""\
# key: {key}
# immutable-kiosk boot screen -- written by kioskd (set_grub_splash) with
# kiosk-splash.pf2 for this panel, its rotation, the accent and the
# language; edits here are overwritten. Sourced by grub.cfg before the boot
# entries. Plymouth's first frame, drawn in gfxterm with the tiles of that
# frame as glyphs; it stays up through the kernel's start.
set kiosk_splash_ok=0
if [ -f "$prefix/{GRUB_FONT.name}" ]; then
  if [ -f "(memdisk)/fonts/unicode.pf2" ]; then
    set kiosk_text_font="(memdisk)/fonts/unicode.pf2"
  elif [ -f "$prefix/fonts/unicode.pf2" ]; then
    set kiosk_text_font="$prefix/fonts/unicode.pf2"
  fi
  # Unifont for the menu (Esc) and messages, the tiles in ours on top.
  if [ -n "$kiosk_text_font" ]; then
    if loadfont "$kiosk_text_font"; then
      if loadfont "$prefix/{GRUB_FONT.name}"; then
        set gfxterm_font={GRUB_FONT_NAME}
        set gfxmode=auto
        set gfxpayload=keep
        if terminal_output gfxterm; then
          set kiosk_splash_ok=1
        fi
      fi
    fi
  fi
fi

# Nothing in here can fail (see kioskd). Ends in black: the cursor and any
# text after it don't show.
function kiosk_splash {{
  clear
{chr(10).join(lines)}
  set color_normal=black/black
  echo " "
}}

# Boot entries start with "savedefault" when these are set (blsuki; older
# blscfg: save_default): GRUB has just cleared the screen, the kernel and
# the initramfs are about to be read. Drawn only then, once: drawn before
# the menu's wait too, it blinked as GRUB cleared the screen to boot.
function savedefault {{
  if [ "$kiosk_splash_ok" = 1 ]; then
    kiosk_splash
  fi
}}

if [ "$kiosk_splash_ok" = 1 ]; then
  set blsuki_save_default=true
  set save_default=true
fi
"""
    return cfg, pf2_font(glyphs)


def set_grub_splash(output=None, transform=None):
    """Bring GRUB's boot screen (console.cfg, kiosk-splash.pf2) in line with
    the panel the kiosk reports (output, transform; None: the last one) and
    Settings' accent and language. Nothing until the kiosk has reported its
    panel. Cheap when nothing changed (console.cfg's key line); otherwise
    drawn by `kioskd --grub-splash` at the lowest priority -- seconds of CPU
    on the Atom, which in here held up the API (a restart from Settings
    waited for it)."""
    if output is not None:
        _panel.update(output=output, transform=transform)
    output, transform = _panel["output"], _panel["transform"]
    if transform is None or mode() == "installer" or not GRUB_DIR.is_dir():
        return
    try:
        raw = SPLASH_DATA.read_bytes()
        d = json.loads(raw)
        if "boot_labels" not in d:
            return
        size = native_mode(output)
        if not size:
            print("kioskd: GRUB boot screen: no display mode found", flush=True)
            return
        cfg = load_config()
        accent = cfg.get("accent") if cfg.get("accent") in d["accents"] else d["default_accent"]
        lang = cfg.get("language") if cfg.get("language") in d["boot_labels"] else "en"
        # What the files come from: the panel, the look, the bar's data and
        # this program (a new version may draw differently) -- redrawn once
        # after an update, otherwise left alone.
        code = hashlib.sha256(Path(os.path.abspath(__file__)).read_bytes()).hexdigest()[:12]
        key = (f"{size[0]}x{size[1]} {transform} {accent} {lang} "
               f"{hashlib.sha256(raw).hexdigest()[:12]} {code}")
        try:
            if GRUB_FONT.is_file() and GRUB_CONSOLE_CFG.read_text().startswith(f"# key: {key}\n"):
                return
        except OSError:
            pass
        with _splash_lock:
            p = subprocess.run(["nice", "-n", "19", sys.executable, os.path.abspath(__file__), "--grub-splash",
                                key, str(size[0]), str(size[1]), transform, accent, lang],
                               capture_output=True, text=True, timeout=600)
        for line in (p.stdout + p.stderr).strip().splitlines():
            print(f"kioskd: GRUB boot screen: {line}", flush=True)
    except (OSError, ValueError, KeyError, subprocess.TimeoutExpired) as e:
        print(f"kioskd: GRUB boot screen: {e}", flush=True)


def write_grub_splash(key, w, h, transform, accent, lang):
    """`kioskd --grub-splash`: draw and write the files (set_grub_splash)."""
    d = json.loads(SPLASH_DATA.read_text())
    files = grub_splash_files(w, h, transform, d, accent, lang, key)
    if files is None:
        print(f"the frame doesn't fit {w}x{h}")
        return 1
    # The font first: console.cfg only uses it when it's there.
    for path, data in ((GRUB_FONT, files[1]), (GRUB_CONSOLE_CFG, files[0].encode())):
        try:
            if path.read_bytes() == data:
                continue
        except OSError:
            pass
        p = subprocess.run([BOOT_COUNTER, "write-boot", str(path)], input=data, capture_output=True, timeout=60)
        if p.returncode != 0:
            print(p.stderr.decode(errors="replace").strip() or f"write-boot {path}: {p.returncode}")
            return 1
    return 0


