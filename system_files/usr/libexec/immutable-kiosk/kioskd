# ---------------------------------------------------------------- helpers

class Msg(str):
    """English text for Settings with values in it, which keeps what it was
    made from: Msg("Invalid DNS server: {dns}", dns=d). The page translates
    the template and fills in the values (i18n.js): send_json lists every
    Msg in an answer under "_i18n". Values: str or numbers, or Msg."""

    def __new__(cls, template, **values):
        self = super().__new__(cls, template.format(**values))
        self.template, self.values = template, values
        return self


def i18n_of(obj, out):
    """Every Msg in obj (and in Msg values) -> out[text] = [template, values]."""
    if isinstance(obj, Msg):
        out[str(obj)] = [obj.template, obj.values]
        for v in obj.values.values():
            i18n_of(v, out)
    elif isinstance(obj, dict):
        for v in obj.values():
            i18n_of(v, out)
    elif isinstance(obj, (list, tuple)):
        for v in obj:
            i18n_of(v, out)
    return out


def text_of(e):
    """An exception's message, a Msg if it was raised with one."""
    a = e.args[0] if e.args else None
    return a if isinstance(a, Msg) else str(e)


def run(cmd, check=True, timeout=60, **kw):
    """Run a command, return stdout (str). Raises ApiError with stderr on failure."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, **kw)
    except subprocess.TimeoutExpired:
        raise ApiError(Msg("{program}: timed out ({secs} s)", program=cmd[0], secs=timeout))
    except FileNotFoundError:
        raise ApiError(Msg("program not found: {program}", program=cmd[0]))
    if check and p.returncode != 0:
        raise ApiError(cmd_error(p, cmd[0]))
    return p.stdout


# What nmcli says when a connection fails (English: LC_MESSAGES above) ->
# Settings' wording (translated by the page). First match wins.
NM_ERRORS = [
    (r"secrets were required|802\.1x supplicant|no secrets", "Wrong password"),
    (r"wireless-security\.psk.*invalid|psk: property is invalid",
     "The password must be 8 to 63 characters (or 64 hex digits)"),
    (r"no network with ssid ['\"]?(?P<ssid>.+?)['\"]? found", "Network “{ssid}” not found"),
    (r"wi-?fi network could not be found|ssid not found", "The network is out of range"),
    (r"ip configuration could not be reserved|dhcp", "No IP address: the network's DHCP server didn't answer"),
    (r"timeout expired|timed out", "The connection timed out"),
    (r"carrier", "No cable connected"),
    (r"networkmanager is not running", "The network service isn't running"),
    (r"device ['\"]?.+?['\"]? not found|no wi-?fi device", "No network adapter found"),
    (r"radio.*disabled|rfkill|wi-?fi is disabled", "Wi-Fi is off"),
]


def cmd_error(p, name):
    """A failed command's message as Settings shows it: never its raw hints
    (nmcli's "Hint: use 'journalctl -xe ...'", systemctl's "See
    'systemctl status ...' and 'journalctl -xeu ...'"); nmcli's errors in
    plain words (NM_ERRORS), others' without "Error: "."""
    lines = [l.strip() for l in (p.stderr or p.stdout).splitlines()]
    lines = [l for l in lines if l and "journalctl" not in l and "systemctl status" not in l
             and not l.lower().startswith(("hint:", "see "))]
    text = " ".join(lines)
    if name == "nmcli":
        for rx, msg in NM_ERRORS:
            m = re.search(rx, text, re.I)
            if m:
                return Msg(msg, **m.groupdict())
        if text:
            # "Error: Connection activation failed: <reason>." -> "<reason>"
            text = re.sub(r"^(error:\s*)?(connection activation failed:\s*)?(\(\d+\)\s*)?", "", text, flags=re.I)
            return Msg("Couldn't connect: {reason}", reason=text.rstrip("."))
        return "Couldn't connect"
    text = re.sub(r"^error:\s*", "", "\n".join(lines), flags=re.I)
    return text or Msg("{program} exited with code {code}", program=name, code=p.returncode)


class ApiError(Exception):
    def __init__(self, message, status=HTTPStatus.BAD_REQUEST):
        super().__init__(message)
        self.status = status


def mode():
    try:
        return MODE_FILE.read_text().strip() or "kiosk"
    except FileNotFoundError:
        return "kiosk"


def read_dmi(field):
    try:
        return Path(f"/sys/class/dmi/id/{field}").read_text().strip()
    except OSError:
        return ""


def default_rotation():
    """Rotation for this DMI product name from DEFAULT_ROTATION_FILE, else its default."""
    try:
        table = json.loads(DEFAULT_ROTATION_FILE.read_text())
    except (OSError, ValueError):
        table = {}
    product = read_dmi("product_name").lower()
    for dev in table.get("devices", []):
        if dev.get("dmi_product") and dev["dmi_product"].lower() in product and dev.get("rotation") in ROTATIONS:
            return dev["rotation"]
    return table.get("default") if table.get("default") in ROTATIONS else "landscape"


def load_config():
    cfg = json.loads(json.dumps(DEFAULT_CONFIG))
    try:
        stored = json.loads(CONFIG_FILE.read_text())
    except (OSError, ValueError):
        stored = {}
    for k, v in stored.items():
        if k == "hmi" and isinstance(v, dict):
            cfg["hmi"].update(v)
        elif k in cfg:
            cfg[k] = v
    return cfg


def backlight():
    """The panel's backlight device, preferring firmware > platform > raw (as systemd/GNOME do)."""
    order = {"firmware": 0, "platform": 1, "raw": 2}
    best = None
    for d in BACKLIGHT_DIR.glob("*"):
        try:
            kind = (d / "type").read_text().strip()
            int((d / "max_brightness").read_text())
        except (OSError, ValueError):
            continue
        rank = order.get(kind, 3)
        if best is None or rank < best[0]:
            best = (rank, d)
    return best[1] if best else None


def brightness_get():
    """Current backlight in percent, or None if there's no backlight device."""
    d = backlight()
    if not d:
        return None
    try:
        cur = int((d / "brightness").read_text())
        mx = int((d / "max_brightness").read_text())
    except (OSError, ValueError):
        return None
    return round(cur * 100 / mx) if mx > 0 else None


def brightness_set(percent):
    d = backlight()
    if not d:
        raise ApiError("This screen has no brightness control")
    percent = max(BRIGHTNESS_MIN, min(100, int(percent)))
    mx = int((d / "max_brightness").read_text())
    (d / "brightness").write_text(str(max(1, round(mx * percent / 100))))


def effective_config():
    cfg = load_config()
    cfg["rotation_effective"] = cfg["rotation"] or default_rotation()
    cfg["brightness_now"] = brightness_get()
    cfg["hmi_url"] = hmi_url(cfg["hmi"])
    cfg["mode"] = mode()
    return cfg


def hmi_url(h):
    host = (h.get("host") or "").strip()
    if not host:
        return ""
    if ":" in host and not host.startswith("["):  # bare IPv6
        host = f"[{host}]"
    scheme = h.get("scheme") or "https"
    port = h.get("port")
    default_port = {"http": 80, "https": 443}[scheme]
    path = h.get("path") or "/"
    if not path.startswith("/"):
        path = "/" + path
    port_part = f":{port}" if port and int(port) != default_port else ""
    return f"{scheme}://{host}{port_part}{path}"


def parse_port(port):
    """A port number, or None (empty): the scheme's default, 80 or 443."""
    if port is None or str(port).strip() == "":
        return None
    try:
        port = int(str(port).strip())
    except ValueError:
        raise ApiError("Port must be a number")
    if not 1 <= port <= 65535:
        raise ApiError("Port must be 1-65535")
    return port


def save_config(update):
    cfg = load_config()
    if "hmi" in update:
        h = update["hmi"]
        if not isinstance(h, dict):
            raise ApiError("hmi: expected an object")
        scheme = h.get("scheme", cfg["hmi"]["scheme"])
        if scheme not in ("http", "https"):
            raise ApiError("Protocol must be http or https")
        host = str(h.get("host", cfg["hmi"]["host"])).strip()
        if host and not re.fullmatch(r"[A-Za-z0-9.\-:\[\]]+", host):
            raise ApiError("Invalid IP address / host name")
        port = parse_port(h.get("port", cfg["hmi"]["port"]))
        path = str(h.get("path", cfg["hmi"]["path"])).strip() or "/"
        cfg["hmi"] = {"scheme": scheme, "host": host, "port": port, "path": path}
    if "rotation" in update:
        r = update["rotation"]
        if r is not None and r not in ROTATIONS:
            raise ApiError("Invalid orientation")
        cfg["rotation"] = r
    for key in ("osk_in_hmi", "accept_self_signed"):
        if key in update:
            cfg[key] = bool(update[key])
    if "zoom" in update:
        z = float(update["zoom"])
        if not 0.5 <= z <= 3.0:
            raise ApiError("Zoom: 50-300%")
        cfg["zoom"] = round(z, 2)
    if "scale" in update:
        try:
            s = float(update["scale"])
        except (TypeError, ValueError):
            raise ApiError("Scaling must be a number")
        if not 1.0 <= s <= 2.0:
            raise ApiError("Screen scaling: 100-200%")
        cfg["scale"] = round(s, 2)  # WebKit zoom of both views (kiosk-shell apply_scale)
    if "releases_repo" in update:
        repo = str(update["releases_repo"] or "").strip().removeprefix("https://github.com/").strip("/")
        repo = repo or DEFAULT_CONFIG["releases_repo"]
        if not GITHUB_REPO.match(repo):
            raise ApiError("Repository as owner/name, e.g. LukeMech/immutable-kiosk")
        cfg["releases_repo"] = repo
    if "language" in update:
        if update["language"] not in LANGUAGES:
            raise ApiError("Unknown language")
        cfg["language"] = update["language"]
    if "accent" in update:
        if update["accent"] not in ACCENTS:
            raise ApiError("Unknown accent color")
        cfg["accent"] = update["accent"]
    if "settings_corner" in update:
        if update["settings_corner"] not in CORNERS:
            raise ApiError("Invalid screen corner")
        cfg["settings_corner"] = update["settings_corner"]
    if "retry_seconds" in update:
        cfg["retry_seconds"] = max(3, min(300, int(update["retry_seconds"])))
    if "brightness" in update:
        try:
            b = int(update["brightness"])
        except (TypeError, ValueError):
            raise ApiError("Brightness must be a number")
        if not BRIGHTNESS_MIN <= b <= 100:
            raise ApiError(Msg("Brightness: {min}-100%", min=BRIGHTNESS_MIN))
        brightness_set(b)
        cfg["brightness"] = b
    write_config(cfg)
    return effective_config()


def write_config(cfg):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = CONFIG_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(cfg, indent=2))
    os.chmod(tmp, 0o644)
    tmp.replace(CONFIG_FILE)


