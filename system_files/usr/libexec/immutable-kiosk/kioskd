# ---------------------------------------------------------------- helpers

def run(cmd, check=True, timeout=60, **kw):
    """Run a command, return stdout (str). Raises ApiError with stderr on failure."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, **kw)
    except subprocess.TimeoutExpired:
        raise ApiError(f"{cmd[0]}: timed out ({timeout} s)")
    except FileNotFoundError:
        raise ApiError(f"program not found: {cmd[0]}")
    if check and p.returncode != 0:
        msg = (p.stderr or p.stdout).strip() or f"{cmd[0]} exited with code {p.returncode}"
        raise ApiError(msg)
    return p.stdout


class ApiError(Exception):
    def __init__(self, message, status=HTTPStatus.BAD_REQUEST):
        super().__init__(message)
        self.status = status


def mode():
    try:
        return MODE_FILE.read_text().strip() or "kiosk"
    except FileNotFoundError:
        return "kiosk"


def read_dmi(field):
    try:
        return Path(f"/sys/class/dmi/id/{field}").read_text().strip()
    except OSError:
        return ""


def default_rotation():
    """Rotation for this DMI product name from DEFAULT_ROTATION_FILE, else its default."""
    try:
        table = json.loads(DEFAULT_ROTATION_FILE.read_text())
    except (OSError, ValueError):
        table = {}
    product = read_dmi("product_name").lower()
    for dev in table.get("devices", []):
        if dev.get("dmi_product") and dev["dmi_product"].lower() in product and dev.get("rotation") in ROTATIONS:
            return dev["rotation"]
    return table.get("default") if table.get("default") in ROTATIONS else "landscape"


def load_config():
    cfg = json.loads(json.dumps(DEFAULT_CONFIG))
    try:
        stored = json.loads(CONFIG_FILE.read_text())
    except (OSError, ValueError):
        stored = {}
    for k, v in stored.items():
        if k == "hmi" and isinstance(v, dict):
            cfg["hmi"].update(v)
        elif k in cfg:
            cfg[k] = v
    return cfg


def backlight():
    """The panel's backlight device, preferring firmware > platform > raw (as systemd/GNOME do)."""
    order = {"firmware": 0, "platform": 1, "raw": 2}
    best = None
    for d in BACKLIGHT_DIR.glob("*"):
        try:
            kind = (d / "type").read_text().strip()
            int((d / "max_brightness").read_text())
        except (OSError, ValueError):
            continue
        rank = order.get(kind, 3)
        if best is None or rank < best[0]:
            best = (rank, d)
    return best[1] if best else None


def brightness_get():
    """Current backlight in percent, or None if there's no backlight device."""
    d = backlight()
    if not d:
        return None
    try:
        cur = int((d / "brightness").read_text())
        mx = int((d / "max_brightness").read_text())
    except (OSError, ValueError):
        return None
    return round(cur * 100 / mx) if mx > 0 else None


def brightness_set(percent):
    d = backlight()
    if not d:
        raise ApiError("This screen has no brightness control")
    percent = max(BRIGHTNESS_MIN, min(100, int(percent)))
    mx = int((d / "max_brightness").read_text())
    (d / "brightness").write_text(str(max(1, round(mx * percent / 100))))


def effective_config():
    cfg = load_config()
    cfg["rotation_effective"] = cfg["rotation"] or default_rotation()
    cfg["brightness_now"] = brightness_get()
    cfg["hmi_url"] = hmi_url(cfg["hmi"])
    cfg["mode"] = mode()
    return cfg


def hmi_url(h):
    host = (h.get("host") or "").strip()
    if not host:
        return ""
    if ":" in host and not host.startswith("["):  # bare IPv6
        host = f"[{host}]"
    scheme = h.get("scheme") or "https"
    port = h.get("port")
    default_port = {"http": 80, "https": 443}[scheme]
    path = h.get("path") or "/"
    if not path.startswith("/"):
        path = "/" + path
    port_part = f":{port}" if port and int(port) != default_port else ""
    return f"{scheme}://{host}{port_part}{path}"


def save_config(update):
    cfg = load_config()
    if "hmi" in update:
        h = update["hmi"]
        if not isinstance(h, dict):
            raise ApiError("hmi: expected an object")
        scheme = h.get("scheme", cfg["hmi"]["scheme"])
        if scheme not in ("http", "https"):
            raise ApiError("Protocol must be http or https")
        host = str(h.get("host", cfg["hmi"]["host"])).strip()
        if host and not re.fullmatch(r"[A-Za-z0-9.\-:\[\]]+", host):
            raise ApiError("Invalid IP address / host name")
        port = h.get("port", cfg["hmi"]["port"])
        try:
            port = int(port)
        except (TypeError, ValueError):
            raise ApiError("Port must be a number")
        if not 1 <= port <= 65535:
            raise ApiError("Port must be 1-65535")
        path = str(h.get("path", cfg["hmi"]["path"])).strip() or "/"
        cfg["hmi"] = {"scheme": scheme, "host": host, "port": port, "path": path}
    if "rotation" in update:
        r = update["rotation"]
        if r is not None and r not in ROTATIONS:
            raise ApiError("Invalid orientation")
        cfg["rotation"] = r
    if "resolution" in update:
        r = update["resolution"]
        if r is not None and not re.fullmatch(r"\d{3,5}x\d{3,5}(@\d{1,3}(\.\d{1,3})?)?", str(r)):
            raise ApiError("Invalid resolution")
        cfg["resolution"] = r
    for key in ("osk_in_hmi", "accept_self_signed"):
        if key in update:
            cfg[key] = bool(update[key])
    if "zoom" in update:
        z = float(update["zoom"])
        if not 0.5 <= z <= 3.0:
            raise ApiError("Zoom: 50-300%")
        cfg["zoom"] = round(z, 2)
    if "scale" in update:
        try:
            s = float(update["scale"])
        except (TypeError, ValueError):
            raise ApiError("Scaling must be a number")
        if not 1.0 <= s <= 2.0:
            raise ApiError("Screen scaling: 100-200%")
        cfg["scale"] = round(s, 2)  # WebKit zoom of both views (kiosk-shell apply_scale)
    if "releases_repo" in update:
        repo = str(update["releases_repo"] or "").strip().removeprefix("https://github.com/").strip("/")
        repo = repo or DEFAULT_CONFIG["releases_repo"]
        if not GITHUB_REPO.match(repo):
            raise ApiError("Repository as owner/name, e.g. LukeMech/immutable-kiosk")
        cfg["releases_repo"] = repo
    if "language" in update:
        if update["language"] not in LANGUAGES:
            raise ApiError("Unknown language")
        cfg["language"] = update["language"]
    if "accent" in update:
        if update["accent"] not in ACCENTS:
            raise ApiError("Unknown accent color")
        cfg["accent"] = update["accent"]
    if "settings_corner" in update:
        if update["settings_corner"] not in CORNERS:
            raise ApiError("Invalid screen corner")
        cfg["settings_corner"] = update["settings_corner"]
    if "retry_seconds" in update:
        cfg["retry_seconds"] = max(3, min(300, int(update["retry_seconds"])))
    if "brightness" in update:
        try:
            b = int(update["brightness"])
        except (TypeError, ValueError):
            raise ApiError("Brightness must be a number")
        if not BRIGHTNESS_MIN <= b <= 100:
            raise ApiError(f"Brightness: {BRIGHTNESS_MIN}-100%")
        brightness_set(b)
        cfg["brightness"] = b
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = CONFIG_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(cfg, indent=2))
    os.chmod(tmp, 0o644)
    tmp.replace(CONFIG_FILE)
    return effective_config()


# ---------------------------------------------------------------- nmcli

def nm_split(line):
    """Split one line of `nmcli -t` output on unescaped ':' and unescape."""
    fields, cur, i = [], [], 0
    while i < len(line):
        c = line[i]
        if c == "\\" and i + 1 < len(line):
            cur.append(line[i + 1])
            i += 2
            continue
        if c == ":":
            fields.append("".join(cur))
            cur = []
        else:
            cur.append(c)
        i += 1
    fields.append("".join(cur))
    return fields


def nm_rows(args, timeout=30):
    out = run(["nmcli", "-t"] + args, timeout=timeout)
    return [nm_split(l) for l in out.splitlines() if l]


def nm_kv(args):
    """`nmcli -t -f X con show ...` key:value lines -> dict (multi-values -> list)."""
    out = run(["nmcli", "-t"] + args)
    d = {}
    for line in out.splitlines():
        if ":" not in line:
            continue
        k, v = line.split(":", 1)
        k = re.sub(r"\[\d+\]$", "", k)
        v = v.replace("\\:", ":").replace("\\\\", "\\")
        if k in d:
            d[k] = d[k] if isinstance(d[k], list) else [d[k]]
            d[k].append(v)
        else:
            d[k] = v
    return d


def saved_wifi():
    """[{name, uuid, ssid, active}] for every saved Wi-Fi profile."""
    result = []
    for name, uuid, ctype, dev in nm_rows(["-f", "NAME,UUID,TYPE,DEVICE", "con", "show"]):
        if ctype != "802-11-wireless":
            continue
        ssid = run(["nmcli", "-g", "802-11-wireless.ssid", "con", "show", uuid], check=False).strip()
        result.append({"name": name, "uuid": uuid, "ssid": ssid or name, "active": bool(dev)})
    return result


def wifi_state(rescan):
    radio = run(["nmcli", "radio", "wifi"], check=False).strip() == "enabled"
    saved = saved_wifi()
    saved_ssids = {s["ssid"] for s in saved}
    networks = {}
    if radio:
        rows = nm_rows(["-f", "IN-USE,SSID,SIGNAL,SECURITY", "dev", "wifi", "list",
                        "--rescan", "yes" if rescan else "auto"], timeout=45)
        for in_use, ssid, signal, security in rows:
            if not ssid:
                continue  # hidden network: joined by name instead
            n = networks.get(ssid)
            sig = int(signal or 0)
            if n is None or sig > n["signal"]:
                networks[ssid] = {
                    "ssid": ssid,
                    "signal": sig,
                    "security": security if security not in ("", "--") else "",
                    "in_use": in_use == "*" or (n or {}).get("in_use", False),
                    "saved": ssid in saved_ssids,
                }
            elif in_use == "*":
                n["in_use"] = True
    nets = sorted(networks.values(), key=lambda n: (not n["in_use"], -n["signal"]))
    return {"enabled": radio, "networks": nets, "saved": saved, "device": wifi_device()}


def net_brief():
    """Connected device for the top bar (polled every 5 s, so no rescan);
    Ethernet wins over Wi-Fi. None = offline."""
    try:
        rows = nm_rows(["-f", "DEVICE,TYPE,STATE,CONNECTION", "dev"], timeout=5)
    except ApiError:
        return None
    best = None
    for _dev, typ, state, conn in rows:
        if typ not in ("ethernet", "wifi") or not state.startswith("connected"):
            continue
        item = {"type": typ, "name": conn if conn not in ("", "--") else typ}
        if typ == "ethernet":
            return item
        best = best or item
    if best:
        try:
            for in_use, signal in nm_rows(["-f", "IN-USE,SIGNAL", "dev", "wifi", "list", "--rescan", "no"], timeout=5):
                if in_use == "*":
                    best["signal"] = int(signal or 0)
                    break
        except (ApiError, ValueError):
            pass
    return best


def wifi_device():
    """{device, state (nmcli's), connection, address}; None = no Wi-Fi adapter."""
    try:
        rows = nm_rows(["-f", "DEVICE,TYPE,STATE,CONNECTION", "dev"])
    except ApiError:
        return None
    for dev, typ, state, conn in rows:
        if typ != "wifi":
            continue
        addr = ""
        if state.startswith("connected"):
            a = nm_kv(["-f", "IP4.ADDRESS", "dev", "show", dev]).get("IP4.ADDRESS", "")
            addr = (a[0] if isinstance(a, list) else a).split("/")[0]
        return {"device": dev, "state": state, "connection": "" if conn in ("", "--") else conn, "address": addr}
    return None


def wifi_connect(ssid, password, hidden):
    if not ssid:
        raise ApiError("Enter the network name")
    existing = [s for s in saved_wifi() if s["ssid"] == ssid]
    if existing and not password:
        run(["nmcli", "con", "up", existing[0]["uuid"]], timeout=60)
        return
    # New password = new profile, or the stale one would be tried first.
    for s in existing:
        run(["nmcli", "con", "delete", s["uuid"]], check=False)
    # Password is briefly on nmcli's argv; only root and kiosk users exist.
    cmd = ["nmcli", "dev", "wifi", "connect", ssid]
    if password:
        cmd += ["password", password]
    if hidden:
        cmd += ["hidden", "yes"]
    run(cmd, timeout=90)


def network_state():
    conns = []
    for name, uuid, ctype, dev in nm_rows(["-f", "NAME,UUID,TYPE,DEVICE", "con", "show", "--active"]):
        if ctype == "loopback" or dev == "lo":
            continue
        cfg = nm_kv(["-f", "ipv4.method,ipv4.addresses,ipv4.gateway,ipv4.dns", "con", "show", uuid])
        live = nm_kv(["-f", "IP4", "con", "show", uuid])

        def as_list(v):
            if not v:
                return []
            return v if isinstance(v, list) else [x.strip() for x in v.split(",") if x.strip()]

        addrs = as_list(cfg.get("ipv4.addresses"))
        first = addrs[0] if addrs else ""
        conns.append({
            "name": name,
            "uuid": uuid,
            "type": "wifi" if ctype == "802-11-wireless" else ("ethernet" if ctype == "802-3-ethernet" else ctype),
            "device": dev,
            "method": cfg.get("ipv4.method", "auto"),
            "address": first.split("/")[0] if first else "",
            "prefix": int(first.split("/")[1]) if "/" in first else 24,
            "gateway": cfg.get("ipv4.gateway", "") if cfg.get("ipv4.gateway") != "--" else "",
            "dns": as_list(cfg.get("ipv4.dns")),
            "current": {
                "addresses": as_list(live.get("IP4.ADDRESS")),
                "gateway": live.get("IP4.GATEWAY", "") if isinstance(live.get("IP4.GATEWAY", ""), str) else "",
                "dns": as_list(live.get("IP4.DNS")),
            },
        })
    return {"hostname": socket.gethostname(), "connections": conns}


def network_set(body):
    uuid = body.get("uuid") or ""
    if not re.fullmatch(r"[0-9a-fA-F-]{36}", uuid):
        raise ApiError("No connection to change")
    method = body.get("method")
    if method == "auto":
        args = ["ipv4.method", "auto", "ipv4.addresses", "", "ipv4.gateway", "", "ipv4.dns", ""]
    elif method == "manual":
        try:
            addr = ipaddress.IPv4Address(body.get("address", "").strip())
            prefix = int(body.get("prefix", 24))
            if not 1 <= prefix <= 32:
                raise ValueError
            net = ipaddress.IPv4Network(f"{addr}/{prefix}", strict=False)
        except ValueError:
            raise ApiError("Invalid IP address or mask")
        gw = (body.get("gateway") or "").strip()
        if gw:
            try:
                if ipaddress.IPv4Address(gw) not in net:
                    raise ApiError("Gateway must be in the same subnet")
            except ValueError:
                raise ApiError("Invalid gateway address")
        dns = []
        for d in body.get("dns") or []:
            d = d.strip()
            if not d:
                continue
            try:
                dns.append(str(ipaddress.IPv4Address(d)))
            except ValueError:
                raise ApiError(f"Invalid DNS server: {d}")
        args = ["ipv4.method", "manual", "ipv4.addresses", f"{addr}/{prefix}",
                "ipv4.gateway", gw, "ipv4.dns", " ".join(dns)]
    else:
        raise ApiError("Mode must be auto or manual")
    run(["nmcli", "con", "mod", uuid] + args)
    # Re-activation drops the link briefly: run in background, the page polls.
    threading.Thread(target=run, args=(["nmcli", "con", "up", uuid],),
                     kwargs={"check": False, "timeout": 60}, daemon=True).start()


# ---------------------------------------------------------------- events
#
# GET /api/events (SSE) names changed topics; clients reload that part.
#   net     NetworkManager D-Bus signals
#   power   udev power_supply + periodic battery check
#   disks   udev block events (installer)
#   clock   wall clock was set
#   job     job progress and end
#   device, config, splash, boot, system   kioskd's own changes

class Events:
    def __init__(self):
        self.cond = threading.Condition()
        self.seq = 0
        self.recent = []  # (seq, topic)

    def emit(self, topic):
        with self.cond:
            self.seq += 1
            self.recent.append((self.seq, topic))
            del self.recent[:-200]
            self.cond.notify_all()

    def wait(self, after, timeout):
        """(newest seq, topics newer than `after`) -- empty after timeout."""
        with self.cond:
            self.cond.wait_for(lambda: self.seq > after, timeout)
            return self.seq, sorted({t for n, t in self.recent if n > after})


EVENTS = Events()


class Debounce:
    """A burst of pokes -> one event, `delay` after the first."""

    def __init__(self, topic, delay):
        self.topic, self.delay = topic, delay
        self.timer = None
        self.lock = threading.Lock()

    def poke(self):
        with self.lock:
            if self.timer is None:
                self.timer = threading.Timer(self.delay, self.fire)
                self.timer.daemon = True
                self.timer.start()

    def fire(self):
        with self.lock:
            self.timer = None
        EVENTS.emit(self.topic)


def watch_lines(cmd, debounce, name):
    """Any output line of a monitor command pokes `debounce`; restarted if it exits."""
    while True:
        try:
            p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
            for line in p.stdout:
                if line.strip():
                    debounce.poke()
            p.wait()
        except OSError as e:
            print(f"kioskd: {name} watcher: {e}", flush=True)
        time.sleep(3)


def watch_power():
    """Charger changes come from udev; battery % is also polled every 30 s."""
    poke = Debounce("power", 0.5)
    threading.Thread(target=watch_lines, daemon=True, name="udev-power", args=(
        ["udevadm", "monitor", "--udev", "--subsystem-match=power_supply"], poke, "power")).start()
    last = None
    while True:
        try:
            now = power_state()
        except Exception:  # noqa: BLE001 -- sysfs oddities: try again later
            now = last
        if last is not None and now != last:
            poke.poke()
        last = now
        time.sleep(30)


def watch_clock():
    """Emit "clock" when the wall clock is set (timerfd CANCEL_ON_SET -> ECANCELED)."""
    if not hasattr(os, "timerfd_create"):
        return
    fd = os.timerfd_create(time.CLOCK_REALTIME)
    while True:
        os.timerfd_settime(fd, flags=os.TFD_TIMER_ABSTIME | os.TFD_TIMER_CANCEL_ON_SET,
                           initial=time.time() + 30 * 86400)
        try:
            os.read(fd, 8)
        except OSError as e:
            if e.errno != errno.ECANCELED:
                print(f"kioskd: clock watcher: {e}", flush=True)
                return
            EVENTS.emit("clock")


def start_watchers():
    net = Debounce("net", 1.0)
    threading.Thread(target=watch_lines, daemon=True, name="nm", args=(
        ["gdbus", "monitor", "--system", "--dest", "org.freedesktop.NetworkManager"], net, "NetworkManager")).start()
    # Disk hotplug (installer's list).
    threading.Thread(target=watch_lines, daemon=True, name="udev-block", args=(
        ["udevadm", "monitor", "--udev", "--subsystem-match=block"], Debounce("disks", 1.0), "disks")).start()
    threading.Thread(target=watch_power, daemon=True, name="power").start()
    threading.Thread(target=watch_clock, daemon=True, name="clock").start()


# ---------------------------------------------------------------- jobs
#
# Progress goes out as debounced "job" events; the page then fetches /api/job.
JOB_CHANGED = Debounce("job", 0.3)

class Job:
    """One long-running operation at a time (update, switch, install)."""

    def __init__(self, kind, title, steps=()):
        self.kind = kind
        self.title = title
        self.state = "running"  # running | done | failed
        self.stage = ""
        self.fraction = None  # 0..1 or None (indeterminate)
        self.detail = ""
        self.log = []
        self.result = None
        self.started = time.time()
        self.finished = None
        # Drawn by the page as a chain: done, active, pending.
        self.steps = [{"key": k, "label": label, "state": "pending", "detail": "",
                       "fraction": None, "started": None, "took": None, "pace": None}
                      for k, label in steps]

    def step(self, key, detail=None, fraction=None):
        """Make `key` the active step (earlier ones done or skipped); the job's
        stage/detail/fraction mirror it."""
        idx = next((i for i, st in enumerate(self.steps) if st["key"] == key), None)
        # Never go back: late events of an earlier step are ignored.
        if idx is None or any(st["state"] in ("active", "done") for st in self.steps[idx + 1:]):
            return
        now = time.time()
        for st in self.steps[:idx]:
            if st["state"] == "active":
                st.update(state="done", took=now - st["started"], fraction=None)
            elif st["state"] == "pending":
                st["state"] = "skipped"
        st = self.steps[idx]
        if st["state"] != "active":
            st.update(state="active", started=now, detail="", fraction=None)
        if detail is not None:
            st["detail"] = detail
        st["fraction"] = fraction
        self.stage, self.detail, self.fraction = st["label"], st["detail"], fraction
        JOB_CHANGED.poke()

    def pace(self, key, floor, expect):
        """Time-based bar for a step without byte counts: from `floor` toward
        1 over ~`expect` s (drawn by the page). A higher floor restarts it."""
        st = next((s for s in self.steps if s["key"] == key and s["state"] == "active"), None)
        if st and (not st["pace"] or floor > st["pace"]["floor"]):
            st["pace"] = {"floor": floor, "since": time.time(), "expect": expect}
            JOB_CHANGED.poke()

    def end_steps(self, error=None):
        now = time.time()
        for st in self.steps:
            if st["state"] == "active":
                st.update(state="failed" if error else "done", took=now - st["started"], fraction=None)
                if error:
                    st["detail"] = error
            elif st["state"] == "pending" and not error:
                st["state"] = "skipped"
        JOB_CHANGED.poke()

    # Setting any of these (the installer does directly) emits a "job" event.
    WATCHED = frozenset(("stage", "fraction", "detail", "state", "result", "finished"))

    def __setattr__(self, name, value):
        super().__setattr__(name, value)
        if name in self.WATCHED:
            JOB_CHANGED.poke()

    def add_log(self, line):
        line = line.rstrip()
        if line:
            self.log.append(line)
            del self.log[:-200]
            JOB_CHANGED.poke()

    def as_dict(self):
        return {k: getattr(self, k) for k in
                ("kind", "title", "state", "stage", "fraction", "detail", "result", "started", "finished",
                 "steps")} | {"log": self.log[-40:], "now": time.time()}


JOB_LOCK = threading.Lock()
CURRENT_JOB = None


def start_job(kind, title, target, steps=()):
    global CURRENT_JOB
    with JOB_LOCK:
        if CURRENT_JOB and CURRENT_JOB.state == "running":
            raise ApiError(f"Already running: {CURRENT_JOB.title}", HTTPStatus.CONFLICT)
        job = Job(kind, title, steps)
        CURRENT_JOB = job
    EVENTS.emit("job")

    def wrapper():
        try:
            target(job)
            job.end_steps()
            if job.state == "running":
                job.state = "done"
        except Exception as e:  # noqa: BLE001 -- anything goes to the page
            job.end_steps(error=str(e))
            job.state = "failed"
            job.detail = str(e)
            job.add_log(f"ERROR: {e}")
        finally:
            job.finished = time.time()
            EVENTS.emit("job")

    threading.Thread(target=wrapper, daemon=True).start()
    return job


# "pull" has byte progress; "local" (commit, deploy, prune) has none, so it
# gets a time-paced bar moved along by bootc's stages.
BOOTC_STEPS = [("pull", "Download"), ("local", "Preparing locally")]
UPGRADE_STEPS = [("check", "Check for a new version")] + BOOTC_STEPS
LOCAL_EXPECT_S = 95  # typical "local" duration: ~60 s write + ~35 s stages
# Labels for bootc stages, matched on subtask id or description.
BOOTC_STAGES = {"merging": "Merging the image", "deploying": "Deploying the new version",
                "bound_images": "Fetching bound images", "bound images": "Fetching bound images",
                "cleanup": "Removing old versions", "removing old images": "Removing old versions",
                "pruning": "Removing old versions"}


def stage_name(sub):
    for key in (sub.get("subtask") or "", sub.get("description") or ""):
        k = key.lower()
        for name, label in BOOTC_STAGES.items():
            if name in k:
                return label
    return sub.get("description") or sub.get("subtask") or ""


def decimal(x, digits=1):
    return f"{x:.{digits}f}"


def run_bootc_with_progress(job, args):
    """bootc <args> --progress-fd N, events (JSON Lines) drive job's bar."""
    r, w = os.pipe()
    proc = subprocess.Popen(["bootc"] + args + ["--progress-fd", str(w)],
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                            pass_fds=(w,))
    os.close(w)

    # Speed over a ~5 s window, plus ETA.
    samples = []

    def speed_text(done, total):
        now = time.monotonic()
        if samples and done < samples[-1][1]:
            samples.clear()  # a new download task started from zero
        samples.append((now, done))
        while len(samples) > 2 and now - samples[0][0] > 5:
            samples.pop(0)
        t0, b0 = samples[0]
        if now - t0 < 1 or done <= b0:
            return ""
        rate = (done - b0) / (now - t0)
        left = (total - done) / rate
        eta = f"{left / 60:.0f} min" if left >= 90 else f"{max(1, left):.0f} s"
        return f" · {decimal(rate / 1e6)} MB/s · about {eta} left"

    def read_progress():
        with os.fdopen(r, "r") as f:
            for line in f:
                try:
                    ev = json.loads(line)
                except ValueError:
                    continue
                t, task = ev.get("type"), ev.get("task")
                if t == "Start":
                    job.step("pull")
                elif t == "ProgressBytes" and task == "pulling":
                    done, total = ev.get("bytes") or 0, ev.get("bytesTotal") or 0
                    if total and done < total:
                        job.step("pull", f"{done / 1e6:.0f} / {total / 1e6:.0f} MB" + speed_text(done, total),
                                 done / total)
                    else:
                        # Download complete (or cached): summarize the pull step.
                        pull = job.steps[[st["key"] for st in job.steps].index("pull")] \
                            if any(st["key"] == "pull" for st in job.steps) else None
                        if pull and pull["state"] == "active" and total:
                            secs = time.time() - pull["started"]
                            pull["detail"] = f"{total / 1e6:.0f} MB" + (
                                f" · average {decimal(total / 1e6 / secs)} MB/s" if secs >= 1 else "")
                        cached = ev.get("bytesCached") or 0
                        job.step("local", "Writing the image to disk" if total else
                                 (f"{cached / 1e6:.0f} MB was already on disk" if cached else "Writing the image to disk"))
                        job.pace("local", 0.0, LOCAL_EXPECT_S)
                elif task in ("pulling", "importing"):
                    job.step("local", "Writing the image to disk")
                    job.pace("local", 0.0, LOCAL_EXPECT_S)
                elif task == "staging" or ev.get("stepsTotal"):
                    steps, total = ev.get("steps") or 0, ev.get("stepsTotal") or 0
                    running = next((s for s in ev.get("subtasks") or [] if not s.get("completed")), None)
                    job.step("local", stage_name(running) if running else None)
                    # The write is ~2/3 of "local"; the stages fill the rest.
                    job.pace("local", 2 / 3 + (1 / 3) * (steps / total if total else 0), LOCAL_EXPECT_S)

    t = threading.Thread(target=read_progress, daemon=True)
    t.start()
    for line in proc.stdout:
        job.add_log(line)
    proc.wait()
    t.join(timeout=5)
    if proc.returncode != 0:
        raise RuntimeError(job.log[-1] if job.log else f"bootc exited with code {proc.returncode}")


# Version labels end in the git sha ("v45.20261122.1-778b844", dev
# "v45.3f30f95"); it links a deployment to its GitHub release.
VERSION_SHA = re.compile(r"(?:-|^v\d+\.)([0-9a-f]{7,40})$")

# Last `bootc upgrade --check` in this process; the page re-checks when stale.
LAST_CHECK = {"time": None, "error": None}


LAST_STATUS = {"value": None}  # last good bootc_status(), see r_system

# build.yml: main -> :latest, dev branch -> :dev; any other tag is custom.
CHANNELS = {"stable": {"tag": "latest", "name": "stable"},
            "dev": {"tag": "dev", "name": "testing"}}


def split_image(image):
    """"ghcr.io/o/r:tag" -> ("ghcr.io/o/r", "tag"); no tag means latest."""
    image = image.split("@", 1)[0]
    head, _, last = image.rpartition("/")
    if ":" in last:
        name, tag = last.split(":", 1)
        return f"{head}/{name}" if head else name, tag
    return image, "latest"


def channel_of(image):
    if not image:
        return None
    tag = split_image(image)[1]
    return next((c for c, v in CHANNELS.items() if v["tag"] == tag), "custom")


def bootc_status():
    try:
        st = json.loads(run(["bootc", "status", "--format=json"], timeout=30))
    except (ApiError, ValueError) as e:
        return {"available": False, "error": str(e), "checked": LAST_CHECK}

    def sha(version):
        m = VERSION_SHA.search(version or "")
        return m.group(1) if m else ""

    def entry(e):
        if not e:
            return None
        img = e.get("image") or {}
        ref = (img.get("image") or {})
        cached = e.get("cachedUpdate") or None
        version = img.get("version") or ""
        return {
            "image": ref.get("image", ""),
            "transport": ref.get("transport", ""),
            "version": version,
            "sha": sha(version),
            "timestamp": img.get("timestamp") or "",
            "digest": img.get("imageDigest") or "",
            "update": {
                "version": cached.get("version") or "",
                "sha": sha(cached.get("version")),
                "timestamp": cached.get("timestamp") or "",
                "digest": cached.get("imageDigest") or "",
            } if cached else None,
        }

    s = st.get("status") or {}
    booted = entry(s.get("booted"))
    staged = entry(s.get("staged"))
    rollback = entry(s.get("rollback"))
    update = booted.get("update") if booted else None
    # Not an update if already booted or staged.
    if update and booted and update["digest"] == booted["digest"]:
        update = None
    if update and staged and update["digest"] == staged["digest"]:
        update = None
    # next_channel: where a staged switch goes.
    st = {"available": True, "booted": booted, "staged": staged, "rollback": rollback,
          "update": update, "checked": LAST_CHECK,
          # Rollback done, previous deployment boots next.
          "rollback_queued": bool(s.get("rollbackQueued")),
          "channel": channel_of((booted or {}).get("image")),
          "next_channel": channel_of((staged or booted or {}).get("image"))}
    LAST_STATUS["value"] = st
    return st


def check_for_update(job):
    """bootc upgrade --check (fetches only the manifest), remembered in LAST_CHECK."""
    job.stage = "Checking for updates"
    job.step("check")
    try:
        out = run(["bootc", "upgrade", "--check"], timeout=180)
    except ApiError as e:
        LAST_CHECK.update(time=time.time(), error=str(e))
        raise
    LAST_CHECK.update(time=time.time(), error=None)
    for line in out.splitlines():
        job.add_log(line)
    return bootc_status()


def job_check(job):
    job.result = check_for_update(job)
    job.detail = "New version available" if job.result.get("update") else "System is up to date"


def job_upgrade(job):
    # Always re-check the registry.
    st = check_for_update(job)
    if not st.get("update"):
        job.stage = "Done"
        job.detail = "System is up to date"
        job.result = st
        return
    update = st["update"]
    job.step("check", f"New version: {update.get('version') or update.get('digest', '')[7:19]}")
    run_bootc_with_progress(job, ["upgrade"])
    job.end_steps()
    job.fraction = 1
    job.stage = "Done"
    job.detail = "The new version starts after a restart"
    job.result = bootc_status()


# ---------------------------------------------------------------- changelog

# Notes come from GitHub releases of config "releases_repo". Unauthenticated
# API: 60 req/h per IP, hence the cache. Offline = no notes.
RELEASES_TTL = 15 * 60
_releases_cache = {"time": 0, "repo": None, "data": None}
_releases_lock = threading.Lock()


def _github(repo, path):
    req = urllib.request.Request(f"https://api.github.com/repos/{repo}/{path}", headers={
        "Accept": "application/vnd.github+json", "User-Agent": "immutable-kiosk"})
    with urllib.request.urlopen(req, timeout=10) as r:
        return json.loads(r.read())


def release_notes(body):
    """Release body minus the ISO install section, "Commits" first."""
    sections, cur = [], ["", []]
    for line in (body or "").replace("\r\n", "\n").split("\n"):
        if line.startswith("## "):
            sections.append(cur)
            cur = [line[3:].strip(), [line]]
        else:
            cur[1].append(line)
    sections.append(cur)
    keep = [s for s in sections if s[0] not in ("Installation", "Instalacja") and "\n".join(s[1]).strip()]
    keep.sort(key=lambda s: 0 if s[0] == "Commits" else 1)
    return "\n".join("\n".join(s[1]).strip() + "\n" for s in keep).strip()


def releases(force=False):
    """[{tag, sha, date, prerelease, notes}], newest first; [] if unreachable.
    force bypasses the cache."""
    repo = load_config().get("releases_repo") or DEFAULT_CONFIG["releases_repo"]
    with _releases_lock:
        cached = _releases_cache["data"] if _releases_cache["repo"] == repo else None
        if cached is not None and not force and time.time() - _releases_cache["time"] < RELEASES_TTL:
            return cached
        try:
            rels = _github(repo, "releases?per_page=30")
            tags = {t["name"]: t["commit"]["sha"] for t in _github(repo, "tags?per_page=100")}
        except (OSError, ValueError, KeyError, TypeError) as e:
            print(f"kioskd: releases ({repo}): {e}", flush=True)
            return cached or []
        data = [{"tag": r.get("tag_name", ""), "sha": tags.get(r.get("tag_name", ""), ""),
                 "date": r.get("published_at") or r.get("created_at") or "",
                 "prerelease": bool(r.get("prerelease")),
                 "notes": release_notes(r.get("body"))}
                for r in rels if not r.get("draft")]
        _releases_cache.update(time=time.time(), repo=repo, data=data)
        return data


def changelog():
    """Releases for the booted version and for what an update/restart brings."""
    st = bootc_status()
    # Stable kiosks hide the dev pre-release.
    dev = "dev" in (st.get("channel"), st.get("next_channel"))
    booted = st.get("booted") or {}
    target = st.get("staged") or st.get("update") or None

    def load(force=False):
        return [r for r in releases(force) if dev or not r["prerelease"]]

    def index(rels, sha):
        if not sha:
            return None
        return next((i for i, r in enumerate(rels) if r["sha"].startswith(sha)), None)

    rels = load()
    # Target newer than the cached list: refetch.
    if target and target.get("sha") and index(rels, target["sha"]) is None:
        rels = load(force=True)
    b = index(rels, booted.get("sha"))
    t = index(rels, target.get("sha")) if target else None
    news = []
    if target and t is not None:
        # Target down to (excluding) booted; if booted's release is gone
        # (dev pre-release gets replaced), only the target's.
        news = rels[t:b] if b is not None and b > t else [rels[t]]
    return {
        "repo": load_config().get("releases_repo"),
        "reachable": bool(rels),
        "current": rels[b] if b is not None else None,
        "target": rels[t] if t is not None else None,
        "news": news,
    }


# ---------------------------------------------------------------- boot timing

# CLOCK_MONOTONIC time of the first HMI page load (POST /api/boot/hmi).
HMI_SHOWN = {"at": None}
BOOT_COUNTER = "/usr/libexec/immutable-kiosk/boot-counter"
BOOT_FALLBACK_NOTE = STATE_DIR / "boot-fallback.json"


def parse_span(s):
    """systemd time span ("1min 2.345s", "801ms", "3.758s") -> seconds."""
    units = {"min": 60, "s": 1, "ms": 1e-3, "us": 1e-6, "µs": 1e-6, "h": 3600}
    return sum(float(v) * units[u] for v, u in re.findall(r"([\d.]+)\s*(min|ms|us|µs|s|h)\b", s))


# PID 1's structured job messages (sd-messages.h).
MSG_STARTING = "7d4958e842da4a758f6c1cdc7b36dcc5"   # "Starting X..." / "Mounting X..."
MSG_STARTED = "39f53479d3a045ac8e11786248231fbf"    # "Started/Finished/Mounted X", "Reached target X"
MSG_FAILED = "be02cf6855d2428ba40df7e9d022f03d"

# Unit milestones for the boot timeline, in boot order.
BOOT_MILESTONES = {
    "initrd-root-device.target": "initrd: system disk found",
    "initrd-root-fs.target": "initrd: file system mounted",
    "initrd.target": "initrd: ready to switch",
    "local-fs.target": "File systems mounted",
    "sysinit.target": "System initialization (sysinit)",
    "basic.target": "Basic services (basic)",
    "network.target": "NetworkManager started",
    "immutable-kiosk-backend.service": "kioskd started",
    "immutable-kiosk-cage.service": "Kiosk (cage) started",
    "graphical.target": "Boot finished (graphical)",
}
KERNEL_MILESTONES = [
    (re.compile(r"^Run /init as init process"), "initramfs start"),
    (re.compile(r"^mmcblk\d+: mmc\d+:"), "eMMC detected"),
    (re.compile(r"Initialized i915 "), "GPU ready (i915)"),
]
BOOT_CACHE = {}


def boot_journal():
    """This boot's timeline and slowest units from the journal, initrd included
    (systemd-analyze blame misses the initrd and is skewed by .device units)."""
    try:
        out = run(["journalctl", "-b", "-o", "json", "--no-pager",
                   "--output-fields=MESSAGE,MESSAGE_ID,UNIT,_SOURCE_MONOTONIC_TIMESTAMP,_TRANSPORT,_SYSTEMD_UNIT",
                   "_PID=1", "+", "_TRANSPORT=kernel", "+", f"_SYSTEMD_UNIT={CAGE_UNIT}"], timeout=30)
    except ApiError as e:
        return {"journal_error": str(e)}
    switch = None
    starting, units, marks, failed = {}, [], [], []
    cage_starts = 0
    seen = set()
    for line in out.splitlines():
        try:
            e = json.loads(line)
        except ValueError:
            continue
        msg = e.get("MESSAGE")
        if not isinstance(msg, str):
            continue
        # Kernel lines are logged late: use their source timestamp.
        ts = e.get("_SOURCE_MONOTONIC_TIMESTAMP") or e.get("__MONOTONIC_TIMESTAMP")
        try:
            t = int(ts) / 1e6
        except (TypeError, ValueError):
            continue
        if e.get("_TRANSPORT") == "kernel":
            for rx, label in KERNEL_MILESTONES:
                if label not in seen and rx.search(msg):
                    seen.add(label)
                    marks.append({"t": t, "label": label})
            continue
        # "<prog>: milestone: <label>" lines in cage's unit; first of each.
        if e.get("_SYSTEMD_UNIT") == CAGE_UNIT and e.get("UNIT") is None:
            label = msg.partition("milestone: ")[2].strip()
            if label and label not in seen:
                seen.add(label)
                marks.append({"t": t, "label": label})
            continue
        if msg.startswith("Switching root") and switch is None:
            switch = t
            marks.append({"t": t, "label": "Switch to the system (switch-root)"})
            continue
        unit, mid = e.get("UNIT") or "", e.get("MESSAGE_ID")
        if not unit:
            continue
        if mid == MSG_STARTING:
            starting[unit] = t
            # A second cage start = kiosk restarted (crash, touch matrix).
            if unit == CAGE_UNIT:
                cage_starts += 1
                marks.append({"t": t, "label": "Kiosk: cage starts (plymouth goes away)" if cage_starts == 1
                              else f"Kiosk: cage restarted (start #{cage_starts})"})
        elif mid == MSG_STARTED:
            t0 = starting.pop(unit, None)
            if t0 is not None and not unit.endswith((".device", ".target", ".slice", ".scope")):
                units.append({"unit": unit, "start": t0, "dur": t - t0})
            # initrd also reaches local-fs etc.: before switch-root only initrd-* count.
            if (unit in BOOT_MILESTONES and unit not in seen
                    and unit.startswith("initrd") == (switch is None)):
                seen.add(unit)
                marks.append({"t": t, "label": BOOT_MILESTONES[unit]})
        elif mid == MSG_FAILED:
            failed.append(unit)
    for u in units:
        u["phase"] = "initrd" if switch is not None and u["start"] < switch else "system"
    units.sort(key=lambda u: -u["dur"])
    marks.sort(key=lambda m: m["t"])
    return {"switch_root": switch, "milestones": marks, "slowest": units[:15],
            "failed": sorted(set(failed))}


# PID 1's own work before starting units (initrd and after switch-root),
# from manager *TimestampMonotonic properties (µs).
MANAGER_PHASES = [
    ("InitRDSecurity", "initrd", "PID 1: SELinux policy"),
    ("InitRDGenerators", "initrd", "PID 1: generators"),
    ("InitRDUnitsLoad", "initrd", "PID 1: loading units"),
    ("Security", "system", "PID 1: SELinux policy"),
    ("Generators", "system", "PID 1: generators"),
    ("UnitsLoad", "system", "PID 1: loading units"),
]


def manager_phases():
    props = [f"{p}{edge}TimestampMonotonic" for p, _, _ in MANAGER_PHASES for edge in ("Start", "Finish")]
    try:
        out = run(["systemctl", "show", *[a for p in props for a in ("-p", p)]], timeout=10)
    except ApiError:
        return []
    v = dict(line.split("=", 1) for line in out.splitlines() if "=" in line)
    phases = []
    for name, phase, label in MANAGER_PHASES:
        try:
            start = int(v.get(f"{name}StartTimestampMonotonic", 0))
            finish = int(v.get(f"{name}FinishTimestampMonotonic", 0))
        except ValueError:
            continue
        if start and finish >= start:
            phases.append({"unit": label, "start": start / 1e6, "dur": (finish - start) / 1e6, "phase": phase})
    return phases


CHAIN_LINE = re.compile(r"^[\s│└├─]*([^\s@]+)(?:\s+@(.+?))?(?:\s+\+(.+))?\s*$")


def critical_chain(unit):
    """`unit`'s critical chain as [{unit, at, took}]; `at` is seconds since
    kernel start (systemd-analyze counts from userspace start)."""
    try:
        out = run(["systemd-analyze", "critical-chain", "--no-pager", unit], timeout=20)
        base = int(run(["systemctl", "show", "-p", "UserspaceTimestampMonotonic", "--value"],
                       timeout=10).strip() or 0) / 1e6
    except (ApiError, ValueError):
        return []
    chain = []
    for line in out.splitlines():
        if not line.strip() or line.startswith("The time"):
            continue
        m = CHAIN_LINE.match(line)
        if not m or "." not in m.group(1):
            continue
        name, at, took = m.groups()
        chain.append({"unit": name, "at": base + parse_span(at) if at else None,
                      "took": parse_span(took) if took else None})
    return chain


def boot_timing():
    if "done" in BOOT_CACHE:
        out = dict(BOOT_CACHE["done"])
    else:
        out = {}
        try:
            line = run(["systemd-analyze", "time", "--no-pager"], timeout=20).splitlines()[0]
            # "Startup finished in 3.2s (firmware) + 1.1s (loader) + ... = 25.4s"
            out["phases"] = [{"name": n, "time": t, "sec": parse_span(t)}
                             for t, n in re.findall(r"([\d.]+(?:min|ms|s|us)(?: [\d.]+(?:ms|s|us))*) \((\w+)\)", line)]
            m = re.search(r"= (.+)$", line)
            out["total"] = m.group(1).strip() if m else ""
        except (ApiError, IndexError) as e:
            out["error"] = str(e)  # "Bootup is not yet finished" until graphical.target
        out.update(boot_journal())
        # Rank PID 1's own phases among the units.
        out["slowest"] = sorted(out.get("slowest", []) + manager_phases(), key=lambda u: -u["dur"])[:15]
        # The two waits that matter: root file systems and the kiosk.
        out["chains"] = [
            {"title": "file systems mounted (local-fs)", "steps": critical_chain("local-fs.target")},
            {"title": "the kiosk starting (cage)", "steps": critical_chain(CAGE_UNIT)},
        ]
        # A finished boot never changes: cache it.
        if out.get("total") and "journal_error" not in out:
            BOOT_CACHE["done"] = dict(out)
    out["hmi_shown"] = HMI_SHOWN["at"]
    out["uptime"] = time.monotonic()
    return out


