DEFAULT_CONFIG = {
    # TwinCAT HMI Server (TF2000) listens on 1010 (HTTP) / 1020 (HTTPS) by default.
    "hmi": {"scheme": "https", "host": "", "port": 1020, "path": "/"},
    # None = the device's default from devices.toml.
    "rotation": None,
    # Our on-screen keyboard injected into the HMI page as well (TwinCAT HMI's
    # login page has no keyboard of its own).
    "osk_in_hmi": True,
    # TwinCAT HMI ships a self-signed certificate: accept it, but only for the
