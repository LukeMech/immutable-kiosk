def r_installer(body, q):
    if mode() != "installer":
        raise ApiError("Only available on the installation drive", HTTPStatus.NOT_FOUND)
    return installer_state()


def r_installer_start(body, q):
    if mode() != "installer":
        raise ApiError("Only available on the installation drive", HTTPStatus.NOT_FOUND)
    name = str(body.get("disk", ""))
    disk = next((d for d in list_disks() if d["name"] == name), None)
    if not disk:
        raise ApiError("No such disk")
    if disk["is_boot_medium"]:
        raise ApiError("This is the drive the installer was started from")
    payload = payload_info()
    if payload and payload.get("size") and disk["size"] < int(payload["size"]):
        raise ApiError("The disk is too small for the system")
    return start_job("install", f"Installing to {disk['path']}", job_install(disk["path"])).as_dict()


