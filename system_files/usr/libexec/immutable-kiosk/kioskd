def forget_networks():
    """Every saved connection (Wi-Fi networks, IP settings) deleted; Wi-Fi on.
    NetworkManager makes a fresh DHCP one for a plugged-in cable by itself."""
    out = run(["nmcli", "-t", "-f", "UUID,TYPE", "connection", "show"], timeout=20)
    for line in out.splitlines():
        uuid, _, kind = line.partition(":")
        if uuid and kind != "loopback":
            run(["nmcli", "connection", "delete", uuid], check=False, timeout=30)
    run(["nmcli", "radio", "wifi", "on"], check=False)


def reset_part(part):
    """One Settings tab back to the defaults: "network" forgets every
    connection; the others reset their RESET_KEYS, and their side effects:
    screen the backlight (full) and the boot screen's color, system the
    language (system locale, boot screen), host name and time zone."""
    if part == "network":
        forget_networks()
        nm_changed()
        return
    cfg = load_config()
    for k in RESET_KEYS[part]:
        cfg[k] = json.loads(json.dumps(DEFAULT_CONFIG[k]))
    write_config(cfg)
    HMI_WAKE.set()
    if part == "screen":
        try:
            brightness_set(100)  # the default leaves the backlight alone: full
        except (ApiError, OSError, ValueError):
            pass
    if part in ("screen", "system"):
        what = "accent" if part == "screen" else "language"
        threading.Thread(target=lambda: (set_splash_look(what), set_grub_splash()), daemon=True).start()
    if part == "system":
        set_system_locale()
        run(["hostnamectl", "set-hostname", ""], check=False, timeout=20)
        run(["timedatectl", "set-timezone", DEFAULT_TIMEZONE], check=False, timeout=20)
        time.tzset()
        EVENTS.emit("device")
    EVENTS.emit("config")


def reset_everything():
    """Factory reset: every tab's reset (reset_part), the HMI's browser data
    (logins, cache) and kiosk-shell's cache, then the kiosk restarts.
    Runs in a thread after the reply (request comes from inside cage)."""
    import pwd
    import shutil
    time.sleep(1.0)
    for part in RESET_PARTS:
        try:
            reset_part(part)
        except (ApiError, OSError) as e:
            print(f"kioskd: reset {part}: {e}", flush=True)
    try:
        home = Path(pwd.getpwnam("kiosk").pw_dir)
    except KeyError:
        home = None
    if home:
        for d in (home / ".local/share/immutable-kiosk/hmi", home / ".cache/immutable-kiosk"):
            shutil.rmtree(d, ignore_errors=True)
    subprocess.run(["systemctl", "restart", CAGE_UNIT])


