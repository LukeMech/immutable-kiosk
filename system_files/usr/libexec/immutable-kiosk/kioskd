    if not IMAGE_REF.match(image):
        raise ApiError("Invalid image name (e.g. ghcr.io/lukemech/immutable-kiosk-x86:latest)")
    return start_job("switch", f"Switching image to {image}", job_switch(image), BOOTC_STEPS).as_dict()


def r_system_channel(body, q):
    """Follow the other channel: the same image repository, its tag."""
    channel = body.get("channel")
    if channel not in CHANNELS:
        raise ApiError("Unknown channel")
    st = bootc_status()
    if not st.get("available"):
        raise ApiError(st.get("error") or "bootc is unavailable")
    current = (st.get("staged") or st.get("booted") or {}).get("image", "")
    if not current:
        raise ApiError("Can't tell which image the system runs from")
    repo, _ = split_image(current)
    image = f"{repo}:{CHANNELS[channel]['tag']}"
    if image == current:
        raise ApiError(f"The system is already on the {CHANNELS[channel]['name']} channel")
    return start_job("switch", f"Switching to the {CHANNELS[channel]['name']} channel",
                     job_switch(image), BOOTC_STEPS).as_dict()


ROLLBACK_STEPS = [("rollback", "Set the previous version as default"),
                  ("reboot", "Restart")]


def job_rollback(job):
    """bootc rollback, then reboot; if already queued only reboot (rollback toggles)."""
    st = bootc_status()
    if not st.get("available"):
        raise RuntimeError(st.get("error") or "bootc is unavailable")
    prev = st.get("rollback")
    if not prev:
        raise RuntimeError("There's no previous version")
    job.step("rollback", f"Version {prev.get('version') or prev.get('digest', '')[7:19]}")
    if st.get("rollback_queued"):
        job.add_log("Rollback already set: restart only")
    else:
        for line in run(["bootc", "rollback"], timeout=180).splitlines():
            job.add_log(line)
    job.result = bootc_status()
    job.step("reboot", "The screen goes dark for a moment, then the previous version starts")
    time.sleep(2)  # the page gets to show this step
    run(["systemctl", "reboot"], timeout=30)
    # The reboot should have ended this process.
    time.sleep(120)
    raise RuntimeError("The system didn't restart — the previous version will start on the next boot")


def r_system_rollback(body, q):
    return start_job("rollback", "Restoring the previous version", job_rollback, ROLLBACK_STEPS).as_dict()


DEFAULT_TIMEZONE = "Europe/Warsaw"  # the image's (build_files/05-base.sh)


def reset_everything():
    """Factory reset, then restart the kiosk: kioskd config, HMI browser data,
    kiosk-shell cache, all NM connections, hostname and time zone.
    Runs in a thread after the reply (request comes from inside cage)."""
    import pwd
    import shutil
    time.sleep(1.0)
    try:
        CONFIG_FILE.unlink()
    except FileNotFoundError:
        pass
    try:
        home = Path(pwd.getpwnam("kiosk").pw_dir)
    except KeyError:
        home = None
    if home:
        for d in (home / ".local/share/immutable-kiosk/hmi", home / ".cache/immutable-kiosk"):
            shutil.rmtree(d, ignore_errors=True)
    try:
        out = run(["nmcli", "-t", "-f", "UUID,TYPE", "connection", "show"], timeout=20)
        for line in out.splitlines():
            uuid, _, kind = line.partition(":")
            if uuid and kind != "loopback":
                run(["nmcli", "connection", "delete", uuid], check=False, timeout=30)
    except ApiError as e:
        print(f"kioskd: reset: network: {e}", flush=True)
    run(["hostnamectl", "set-hostname", ""], check=False, timeout=20)
    run(["timedatectl", "set-timezone", DEFAULT_TIMEZONE], check=False, timeout=20)
    time.tzset()
    print("kioskd: everything reset to the defaults, restarting the kiosk", flush=True)
    EVENTS.emit("config")
    EVENTS.emit("device")
    subprocess.run(["systemctl", "restart", CAGE_UNIT])


def r_settings_reset(body, q):
    """Factory reset (see reset_everything)."""
    threading.Thread(target=reset_everything, daemon=True).start()
    return {"ok": True}


def r_power(body, q):
    action = body.get("action")
    if action not in ("reboot", "poweroff"):
        raise ApiError("Unknown action")
    # Reply first, act a moment later.
    threading.Timer(1.0, subprocess.run, args=(["systemctl", action],)).start()
    return {"ok": True}


