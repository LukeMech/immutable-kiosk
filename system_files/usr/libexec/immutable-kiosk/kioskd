        return os.readlink("/etc/localtime").split("zoneinfo/", 1)[1]
    except (OSError, IndexError):
        return "UTC"


LANGUAGES = ("pl", "en")
# The system locale (/etc/locale.conf) follows Settings' language: dates,
# number formats and GTK/WebKit's own strings (glibc-langpack-en/-pl,
# 05-base.sh). Programs started afterwards pick it up.
SYSTEM_LOCALES = {"en": "en_US.UTF-8", "pl": "pl_PL.UTF-8"}
LOCALE_CONF = Path("/etc/locale.conf")


def set_system_locale():
    lang = SYSTEM_LOCALES.get(load_config().get("language"), SYSTEM_LOCALES["en"])
    want = f"LANG={lang}\n"
    try:
        if LOCALE_CONF.read_text() == want:
            return
    except OSError:
        pass
    try:
        tmp = LOCALE_CONF.with_name(".locale.conf.tmp")
        tmp.write_text(want)
        tmp.replace(LOCALE_CONF)
    except OSError as e:
        print(f"kioskd: system locale {lang}: {e}", flush=True)


def cpu_model():
    try:
        for line in Path("/proc/cpuinfo").read_text().splitlines():
            if line.startswith("model name"):
                return " ".join(line.split(":", 1)[1].split())
    except OSError:
        pass
    return ""


def meminfo():
    """/proc/meminfo in kB ({} if unreadable)."""
    vals = {}
    try:
        for line in Path("/proc/meminfo").read_text().splitlines():
            k, _, v = line.partition(":")
            if v.split():
                vals[k] = int(v.split()[0])
    except (OSError, ValueError):
        pass
    return vals


def memory_mb():
    kb = meminfo().get("MemTotal")
    return kb // 1024 if kb else None


def zram_swap():
    """The zram swap (immutable-kiosk-zram.service): {size_mb, packed_mb}, or
    None. packed: what the swapped-out pages take in RAM, compressed."""
    try:
        if "/dev/zram0" not in Path("/proc/swaps").read_text():
            return None
        size = int(Path("/sys/block/zram0/disksize").read_text())
        # mm_stat: orig_data_size compr_data_size mem_used_total ...
        packed = int(Path("/sys/block/zram0/mm_stat").read_text().split()[2])
        return {"size_mb": size // 2**20, "packed_mb": packed // 2**20}
    except (OSError, ValueError, IndexError):
        return None


def cpu_temp():
    """The processor's temperature (°C), the hottest reading: coretemp's
    sensors, else CPU thermal zones (x86_pkg_temp, soc_dts* on Bay Trail),
    else ACPI's. None if the device has none."""
    def read(f):
        try:
            t = int(Path(f).read_text()) / 1000
        except (OSError, ValueError):
            return None
        return t if 0 < t < 150 else None
    for hw in Path("/sys/class/hwmon").glob("hwmon*"):
        try:
            if (hw / "name").read_text().strip() != "coretemp":
                continue
        except OSError:
            continue
        temps = [t for t in map(read, hw.glob("temp*_input")) if t is not None]
        if temps:
            return round(max(temps))
    zones = {}
    for z in Path("/sys/class/thermal").glob("thermal_zone*"):
        try:
            kind = (z / "type").read_text().strip()
        except OSError:
            continue
        t = read(z / "temp")
        if t is not None:
            zones.setdefault(kind, []).append(t)
    cpu = [t for k, ts in zones.items() for t in ts
           if k == "x86_pkg_temp" or k.startswith(("soc_dts", "cpu", "TCPU", "B0D4"))]
    other = zones.get("acpitz", [])
    return round(max(cpu or other)) if cpu or other else None


_cpu = {"sample": None, "busy": None, "at": 0.0}


def cpu_busy():
    """All cores' use (%) since the previous sample (taken at most every
    second; the first one: since boot)."""
    now = time.monotonic()
    if _cpu["busy"] is not None and now - _cpu["at"] < 1:
        return _cpu["busy"]
    try:
        f = [int(x) for x in Path("/proc/stat").read_text().splitlines()[0].split()[1:9]]
    except (OSError, ValueError, IndexError):
        return None
    total, idle = sum(f), f[3] + f[4]  # idle + iowait
    prev = _cpu["sample"] or (0, 0)
    dt = total - prev[0]
    _cpu.update(sample=(total, idle), at=now,
                busy=round(100 * (1 - (idle - prev[1]) / dt)) if dt > 0 else _cpu["busy"])
    return _cpu["busy"]


def usage_sample():
    m = meminfo()
    mb = lambda k: m.get(k, 0) // 1024  # noqa: E731
    return {
        "cpu": cpu_busy(),
        "cores": os.cpu_count(),
        "load": round(os.getloadavg()[0], 2),
        "temp_c": cpu_temp(),
        "mem": {"total_mb": mb("MemTotal"), "used_mb": mb("MemTotal") - mb("MemAvailable")},
        "swap": {"total_mb": mb("SwapTotal"), "used_mb": mb("SwapTotal") - mb("SwapFree"), "zram": zram_swap()},
    }


# The last minute, every 2 s (usage_loop): the Usage tiles' columns are there
# the moment System opens. A few /proc and /sys reads: nothing on the Atom.
USAGE_EVERY_S, USAGE_KEEP = 2, 30
USAGE = {"now": None, "history": []}


def usage_loop():
    pct = lambda a, b: round(100 * a / b) if b else 0  # noqa: E731
    while True:
        s = usage_sample()
        USAGE["now"] = s
        point = {
            "cpu": s["cpu"], "temp_c": s["temp_c"],
            "mem": pct(s["mem"]["used_mb"], s["mem"]["total_mb"]), "mem_mb": s["mem"]["used_mb"],
            "swap": pct(s["swap"]["used_mb"], s["swap"]["total_mb"]), "swap_mb": s["swap"]["used_mb"],
        }
        USAGE["history"] = (USAGE["history"] + [point])[-USAGE_KEEP:]
        try:
            track_peaks(point)
        except OSError as e:
            print(f"kioskd: usage peaks: {e}", flush=True)
        time.sleep(USAGE_EVERY_S)


# ---- High usage: a measure at PEAK_AT or more (% or °C), from the first
# sample there to the first below. Each one is kept (PEAKS_FILE, the last
# PEAKS_KEEP) with its highest value, the other measures then, and what
# used the most (top_cpu / top_mem); and goes to the journal when it ends.
PEAK_AT = 85
PEAKS_FILE = STATE_DIR / "usage-peaks.json"
PEAKS_KEEP = 100
PEAK_TOP = {"cpu": "cpu", "temp_c": "cpu", "mem": "VmRSS", "swap": "VmSwap"}
PEAK_UNIT = {"cpu": "%", "temp_c": " °C", "mem": "%", "swap": "%"}
_peaks = {"open": {}, "done": None}


def proc_dirs():
    return [d for d in Path("/proc").iterdir() if d.name.isdigit()]


def top_cpu(window=0.5, n=3):
    """The programs using the most processor over `window` s, in % of the
    whole machine (all cores); a program's processes counted together."""
    def times():
        out = {}
        for d in proc_dirs():
            try:
                st = (d / "stat").read_text()
                f = st[st.rindex(")") + 2:].split()
                out[d.name] = (st[st.index("(") + 1:st.rindex(")")], int(f[11]) + int(f[12]))  # utime + stime
            except (OSError, ValueError, IndexError):
                pass
        return out
    a = times()
    time.sleep(window)
    b = times()
    per = {}
    for pid, (name, t) in b.items():
        if pid in a:
            per[name] = per.get(name, 0) + t - a[pid][1]
    whole = window * os.sysconf("SC_CLK_TCK") * (os.cpu_count() or 1)
    best = sorted(per.items(), key=lambda kv: -kv[1])[:n]
    return [{"name": k, "pct": round(100 * v / whole)} for k, v in best if v > 0]


def top_mem(field="VmRSS", n=3):
    """The programs holding the most memory (VmRSS) or swap (VmSwap), in MB."""
    per = {}
    for d in proc_dirs():
        try:
            name, kb = None, 0
            for line in (d / "status").read_text().splitlines():
                if line.startswith("Name:"):
                    name = line.split(None, 1)[1] if len(line.split()) > 1 else "?"
                elif line.startswith(field + ":"):
                    kb = int(line.split()[1])
            if name and kb:
                per[name] = per.get(name, 0) + kb
        except (OSError, ValueError, IndexError):
            pass
    best = sorted(per.items(), key=lambda kv: -kv[1])[:n]
    return [{"name": k, "mb": round(v / 1024)} for k, v in best if v >= 1024]


def peaks_done():
    if _peaks["done"] is None:
        try:
            _peaks["done"] = json.loads(PEAKS_FILE.read_text())[-PEAKS_KEEP:]
        except (OSError, ValueError):
            _peaks["done"] = []
    return _peaks["done"]


def track_peaks(point):
    now = time.time()
    for key in PEAK_TOP:
        v, ev = point.get(key), _peaks["open"].get(key)
        if v is not None and v >= PEAK_AT:
            if ev is None or v > ev["peak"]:
                top = top_cpu() if PEAK_TOP[key] == "cpu" else top_mem(PEAK_TOP[key])
                if ev is None:
                    ev = _peaks["open"][key] = {"what": key, "start": now}
                ev.update(peak=v, mb=point.get(f"{key}_mb"), top=top,
                          then={k: point.get(k) for k in ("cpu", "temp_c", "mem", "swap")})
        elif ev is not None:
            del _peaks["open"][key]
            ev["seconds"] = max(USAGE_EVERY_S, round(now - ev["start"]))
            done = peaks_done()
            done.append(ev)
            del done[:-PEAKS_KEEP]
            PEAKS_FILE.parent.mkdir(parents=True, exist_ok=True)
            tmp = PEAKS_FILE.with_suffix(".tmp")
            tmp.write_text(json.dumps(done))
            tmp.replace(PEAKS_FILE)
            tops = ", ".join(f"{t['name']} {t['pct']}%" if "pct" in t else f"{t['name']} {t['mb']} MB"
                             for t in ev["top"])
            print(f"kioskd: high usage: {key} {ev['peak']}{PEAK_UNIT[key]} for {ev['seconds']} s"
                  + (f" ({tops})" if tops else ""), flush=True)


def r_usage(body, q):
    """Settings > System > Usage: now, the last minute (oldest first) and the
    high-usage events (newest first, one still going included)."""
    now = time.time()
    going = [{**ev, "seconds": round(now - ev["start"]), "going": True} for ev in _peaks["open"].values()]
    return {**(USAGE["now"] or usage_sample()), "history": USAGE["history"], "every_s": USAGE_EVERY_S,
            "peak_at": PEAK_AT, "peaks": sorted(going, key=lambda e: -e["start"]) + peaks_done()[::-1]}


def r_usage_peaks_clear(body, q):
    _peaks["done"] = []
    PEAKS_FILE.unlink(missing_ok=True)
    return {"ok": True}


