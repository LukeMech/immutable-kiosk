def main():
    mimetypes.add_type("application/javascript", ".js")
    mimetypes.add_type("text/css", ".css")
    ThreadingHTTPServer.allow_reuse_address = True
    srv = ThreadingHTTPServer(LISTEN, Handler)
    srv.daemon_threads = True
    start_watchers()
    # systemd-backlight only restores after a clean shutdown.
    saved = load_config().get("brightness")
    if saved is not None:
        try:
            brightness_set(saved)
        except (ApiError, OSError, ValueError) as e:
            print(f"kioskd: brightness {saved}%: {e}", flush=True)
    # A language set before this version, or the image's default: in step.
    if mode() != "installer":
        set_system_locale()
        threading.Thread(target=usage_loop, daemon=True).start()
        threading.Thread(target=hmi_watch, daemon=True).start()
    srv.serve_forever()


if __name__ == "__main__":
    # immutable-kiosk-splash-entries.service, at shutdown after an update's
    # boot entries are written: give them the boot screen's look too.
    if sys.argv[1:] == ["--splash-look"]:
        set_splash_look()
        sys.exit(0)
    # set_grub_splash: the drawing, in its own low-priority process.
    if sys.argv[1:2] == ["--grub-splash"] and len(sys.argv) == 8:
        k, gw, gh, gt, ga, gl = sys.argv[2:]
        sys.exit(write_grub_splash(k, int(gw), int(gh), gt, ga, gl))
    main()
