def main():
    mimetypes.add_type("application/javascript", ".js")
    mimetypes.add_type("text/css", ".css")
    ThreadingHTTPServer.allow_reuse_address = True
    srv = ThreadingHTTPServer(LISTEN, Handler)
    srv.daemon_threads = True
    start_watchers()
    # systemd-backlight only restores after a clean shutdown.
    saved = load_config().get("brightness")
    if saved is not None:
        try:
            brightness_set(saved)
        except (ApiError, OSError, ValueError) as e:
            print(f"kioskd: brightness {saved}%: {e}", flush=True)
    print(f"kioskd: listening on http://{LISTEN[0]}:{LISTEN[1]} (mode: {mode()})", flush=True)
    srv.serve_forever()


if __name__ == "__main__":
    main()
