# ---- Is the HMI there? Checked in the background (hmi_watch): Settings shows
# it and greys out "Back to HMI" while it isn't. The same test as
# kiosk-shell's before it loads the HMI: an HTTP(S) answer from the server
# (any certificate: only whether it's there), a gateway error (502-504: the
# proxy is up, the HMI behind it isn't) counting as none.
HMI_STATE = {"url": "", "ok": None, "message": "", "checked": None}
HMI_WAKE = threading.Event()
HMI_EVERY_S = 3


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *a, **kw):
        return None  # a redirect (e.g. to the login page) is an answer too


def hmi_probe(url):
    """(ok, message) for the HMI at url."""
    import http.client
    import ssl
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), _NoRedirect,
                                         urllib.request.HTTPSHandler(context=ctx))
    t0 = time.monotonic()
    try:
        with opener.open(urllib.request.Request(url, headers={"Cache-Control": "no-cache"}), timeout=5) as r:
            status = r.status
    except urllib.error.HTTPError as e:
        status = e.code
    except (OSError, ValueError, http.client.HTTPException) as e:
        err = e.reason if isinstance(e, urllib.error.URLError) and isinstance(e.reason, BaseException) else e
        if isinstance(err, socket.gaierror):
            return False, "The address isn't known on this network"
        if isinstance(err, (socket.timeout, TimeoutError)):
            return False, "The server doesn't answer"
        if isinstance(err, ConnectionRefusedError):
            return False, "The server refuses the connection (wrong port, or the HMI isn't running)"
        if isinstance(err, OSError) and err.errno in (errno.ENETUNREACH, errno.EHOSTUNREACH, errno.ENETDOWN):
            return False, "No route to the server: is the kiosk on its network?"
        return False, "The server doesn't answer properly"
    if status in (502, 503, 504):
        return False, Msg("The server answers {status}: the HMI behind it isn't running", status=status)
    return True, Msg("The HMI answers ({ms} ms)", ms=round((time.monotonic() - t0) * 1000))


def hmi_watch():
    """Every HMI_EVERY_S, and at once after a change of address or network
    (HMI_WAKE). "Not answering" only after two failed checks in a row: a
    blip doesn't take the kiosk out of the HMI (kiosk-shell on_hmi_state)."""
    failed = 0
    while True:
        url = hmi_url(load_config()["hmi"])
        ok, message = hmi_probe(url) if url else (None, "")
        failed = failed + 1 if ok is False and url == HMI_STATE["url"] else 0
        if failed == 1 and HMI_STATE["ok"]:
            HMI_WAKE.wait(1)  # once more, soon, before saying so
            HMI_WAKE.clear()
            continue
        changed = (url, ok) != (HMI_STATE["url"], HMI_STATE["ok"])
        HMI_STATE.update(url=url, ok=ok, message=message, checked=time.time())
        if changed:
            EVENTS.emit("hmi")
        HMI_WAKE.wait(HMI_EVERY_S)
        HMI_WAKE.clear()


