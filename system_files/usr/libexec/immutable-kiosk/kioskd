# ---------------------------------------------------------------- nmcli

def nm_split(line):
    """Split one line of `nmcli -t` output on unescaped ':' and unescape."""
    fields, cur, i = [], [], 0
    while i < len(line):
        c = line[i]
        if c == "\\" and i + 1 < len(line):
            cur.append(line[i + 1])
            i += 2
            continue
        if c == ":":
            fields.append("".join(cur))
            cur = []
        else:
            cur.append(c)
        i += 1
    fields.append("".join(cur))
    return fields


def nm_rows(args, timeout=30):
    out = run(["nmcli", "-t"] + args, timeout=timeout)
    return [nm_split(l) for l in out.splitlines() if l]


def nm_kv(args):
    """`nmcli -t -f X con show ...` key:value lines -> dict (multi-values -> list)."""
    out = run(["nmcli", "-t"] + args)
    d = {}
    for line in out.splitlines():
        if ":" not in line:
            continue
        k, v = line.split(":", 1)
        k = re.sub(r"\[\d+\]$", "", k)
        v = v.replace("\\:", ":").replace("\\\\", "\\")
        if k in d:
            d[k] = d[k] if isinstance(d[k], list) else [d[k]]
            d[k].append(v)
        else:
            d[k] = v
    return d


def parallel(*calls):
    """Run zero-argument callables at once, results in order; the first
    exception is re-raised. Every nmcli start costs ~0.5 s on the Atom
    (mostly loading NetworkManager's objects over D-Bus), one after another
    they added up to many seconds."""
    results, errors = [None] * len(calls), [None] * len(calls)

    def one(i, fn):
        try:
            results[i] = fn()
        except Exception as e:  # noqa: BLE001 -- re-raised below
            errors[i] = e
    threads = [threading.Thread(target=one, args=(i, fn), daemon=True) for i, fn in enumerate(calls)]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    for e in errors:
        if e is not None:
            raise e
    return results


class Coalesce:
    """A read that callers share: one arriving while it runs gets that run's
    result instead of starting another (the page, the top bar and a burst
    of events often ask at once), and a result younger than `ttl` s is
    reused. invalidate() after a change; NetworkManager's signals do too."""

    def __init__(self, fn, ttl):
        self.fn, self.ttl = fn, ttl
        self.lock = threading.Lock()
        self.pending = None     # threading.Event of the run under way
        self.last = None        # (monotonic time, value) of the last good run

    def invalidate(self):
        with self.lock:
            self.last = None

    def __call__(self):
        with self.lock:
            if self.last and time.monotonic() - self.last[0] < self.ttl:
                return self.last[1]
            ev, leader = self.pending, self.pending is None
            if leader:
                ev = self.pending = threading.Event()
                ev.result = (None, None)
                started = time.monotonic()
        if not leader:
            ev.wait()
        else:
            try:
                ev.result = (self.fn(), None)
            except Exception as e:  # noqa: BLE001 -- handed to every waiter
                ev.result = (None, e)
            with self.lock:
                self.pending = None
                # Not if invalidated meanwhile: the result may predate the change.
                if ev.result[1] is None and (self.last is None or self.last[0] < started):
                    self.last = (started, ev.result[0])
            ev.set()
        value, error = ev.result
        if error is not None:
            raise error
        return value


# Saved profile -> its SSID. A profile's SSID doesn't change (a new password
# makes a new profile), so each costs one nmcli call, once.
_ssids = {}


def saved_wifi(rows=None):
    """[{name, uuid, ssid, active}] for every saved Wi-Fi profile; `rows`:
    `nmcli con show` NAME,UUID,TYPE,DEVICE rows if already read."""
    if rows is None:
        rows = nm_rows(["-f", "NAME,UUID,TYPE,DEVICE", "con", "show"])
    wifi = [(name, uuid, dev) for name, uuid, ctype, dev in rows if ctype == "802-11-wireless"]
    missing = [uuid for _, uuid, _ in wifi if uuid not in _ssids]

    def ssid_of(uuid):
        return lambda: run(["nmcli", "-g", "802-11-wireless.ssid", "con", "show", uuid], check=False).strip()
    for uuid, ssid in zip(missing, parallel(*[ssid_of(u) for u in missing])):
        if ssid:
            _ssids[uuid] = ssid
    return [{"name": name, "uuid": uuid, "ssid": _ssids.get(uuid) or name, "active": bool(dev)}
            for name, uuid, dev in wifi]


_scan = {"time": -1e9}


def request_scan():
    """Ask NetworkManager for a fresh scan without waiting for it (it takes
    seconds): the list shows the last results at once, and the new ones
    come as D-Bus signals -> "net" event -> the page reloads. At most every
    30 s."""
    now = time.monotonic()
    if now - _scan["time"] < 30:
        return
    _scan["time"] = now
    threading.Thread(target=run, args=(["nmcli", "dev", "wifi", "rescan"],),
                     kwargs={"check": False, "timeout": 30}, daemon=True).start()


def wifi_state(rescan):
    """rescan: wait for a new scan (the Scan button); otherwise NetworkManager's
    last results."""
    def aps():
        try:
            return nm_rows(["-f", "IN-USE,SSID,SIGNAL,SECURITY", "dev", "wifi", "list",
                            "--rescan", "yes" if rescan else "no"], timeout=45)
        except ApiError as e:
            return e  # fine with the radio off

    def devices():
        try:
            return nm_rows(["-f", "DEVICE,TYPE,STATE,CONNECTION", "dev"])
        except ApiError:
            return None
    radio, con_rows, dev_rows, ap_rows = parallel(
        lambda: run(["nmcli", "radio", "wifi"], check=False).strip() == "enabled",
        lambda: nm_rows(["-f", "NAME,UUID,TYPE,DEVICE", "con", "show"]),
        devices, aps)
    saved = saved_wifi(con_rows)
    saved_ssids = {s["ssid"] for s in saved}
    networks = {}
    if radio:
        if isinstance(ap_rows, ApiError):
            raise ap_rows
        for in_use, ssid, signal, security in ap_rows:
            if not ssid:
                continue  # hidden network: joined by name instead
            n = networks.get(ssid)
            sig = int(signal or 0)
            if n is None or sig > n["signal"]:
                networks[ssid] = {
                    "ssid": ssid,
                    "signal": sig,
                    "security": security if security not in ("", "--") else "",
                    "in_use": in_use == "*" or (n or {}).get("in_use", False),
                    "saved": ssid in saved_ssids,
                }
            elif in_use == "*":
                n["in_use"] = True
    nets = sorted(networks.values(), key=lambda n: (not n["in_use"], -n["signal"]))
    return {"enabled": radio, "networks": nets, "saved": saved, "device": wifi_device(dev_rows)}


WIFI = Coalesce(lambda: wifi_state(False), 3.0)


def net_brief():
    """Connected device for the top bar (no rescan); Ethernet wins over
    Wi-Fi. None = offline."""
    def signal():
        try:
            for in_use, sig in nm_rows(["-f", "IN-USE,SIGNAL", "dev", "wifi", "list", "--rescan", "no"], timeout=5):
                if in_use == "*":
                    return int(sig or 0)
        except (ApiError, ValueError):
            pass
        return None

    def devices():
        try:
            return nm_rows(["-f", "DEVICE,TYPE,STATE,CONNECTION", "dev"], timeout=5)
        except ApiError:
            return None
    rows, sig = parallel(devices, signal)
    best = None
    for _dev, typ, state, conn in rows or []:
        if typ not in ("ethernet", "wifi") or not state.startswith("connected"):
            continue
        item = {"type": typ, "name": conn if conn not in ("", "--") else typ}
        if typ == "ethernet":
            return item
        best = best or item
    if best and sig is not None:
        best["signal"] = sig
    return best


NET_BRIEF = Coalesce(net_brief, 3.0)


def ipv4_address(ifname):
    """The interface's IPv4 address ("" if none), from the kernel (SIOCGIFADDR)
    instead of another nmcli."""
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
            packed = fcntl.ioctl(s.fileno(), 0x8915, struct.pack("256s", ifname[:15].encode()))
        return socket.inet_ntoa(packed[20:24])
    except (OSError, ValueError):
        return ""


def wifi_device(rows=None):
    """{device, state (nmcli's), connection, address}; None = no Wi-Fi adapter.
    `rows`: `nmcli dev` DEVICE,TYPE,STATE,CONNECTION rows if already read
    (None: couldn't be)."""
    if rows is None:
        try:
            rows = nm_rows(["-f", "DEVICE,TYPE,STATE,CONNECTION", "dev"])
        except ApiError:
            return None
    for dev, typ, state, conn in rows:
        if typ != "wifi":
            continue
        addr = ipv4_address(dev) if state.startswith("connected") else ""
        return {"device": dev, "state": state, "connection": "" if conn in ("", "--") else conn, "address": addr}
    return None


def wifi_radio_on():
    """Connect with the radio off: on first, then the adapter up and a fresh
    scan (a saved profile only connects to a network in the scan list)."""
    if run(["nmcli", "radio", "wifi"], check=False).strip() == "enabled":
        return
    run(["nmcli", "radio", "wifi", "on"])
    for _ in range(30):
        dev = wifi_device()
        if dev and not dev["state"].startswith("unavailable"):
            break
        time.sleep(0.5)
    run(["nmcli", "dev", "wifi", "list", "--rescan", "yes"], check=False, timeout=45)


def wifi_connect(ssid, password, hidden, ipv4=None, security=""):
    """ipv4: {method, address, ...} (ipv4_args) for the profile, e.g. a
    static address for a network whose DHCP server doesn't answer; None =
    the saved profile's, or DHCP for a new one. security: the scan's
    (WPA2, WPA3...)."""
    if not ssid:
        raise ApiError("Enter the network name")
    ip = ipv4_args(ipv4) if ipv4 else None
    wifi_radio_on()
    existing = [s for s in saved_wifi() if s["ssid"] == ssid]
    if existing and not password:
        if ip:
            run(["nmcli", "con", "mod", existing[0]["uuid"]] + ip)
        run(["nmcli", "con", "up", existing[0]["uuid"]], timeout=60)
        return
    # New password = new profile, or the stale one would be tried first.
    for s in existing:
        run(["nmcli", "con", "delete", s["uuid"]], check=False)
    # Password is briefly on nmcli's argv; only root and kiosk users exist.
    if not ip:
        cmd = ["nmcli", "dev", "wifi", "connect", ssid]
        if password:
            cmd += ["password", password]
        if hidden:
            cmd += ["hidden", "yes"]
        run(cmd, timeout=90)
        return
    # `nmcli dev wifi connect` only does DHCP: the profile made by hand, then up.
    cmd = ["nmcli", "con", "add", "type", "wifi", "con-name", ssid, "ssid", ssid]
    if password:
        sae = "WPA3" in security and "WPA2" not in security
        cmd += ["wifi-sec.key-mgmt", "sae" if sae else "wpa-psk", "wifi-sec.psk", password]
    if hidden:
        cmd += ["802-11-wireless.hidden", "yes"]
    m = re.search(r"\(([0-9a-fA-F-]{36})\)", run(cmd + ip))
    if not m:
        raise ApiError("Couldn't connect")
    try:
        run(["nmcli", "con", "up", m.group(1)], timeout=90)
    except ApiError:
        # Not kept: a wrong password would be tried again next time.
        run(["nmcli", "con", "delete", m.group(1)], check=False)
        raise


NET_TYPES = ("802-11-wireless", "802-3-ethernet")


def network_state():
    """Connections that are up (or coming up), then saved Wi-Fi/Ethernet ones
    that aren't: their IP settings can be set before they connect (a
    network without DHCP)."""
    conns = []
    rows = [r for r in nm_rows(["-f", "NAME,UUID,TYPE,DEVICE", "con", "show"])
            if r[2] != "loopback" and r[3] != "lo"]
    up = [r for r in rows if r[3] not in ("", "--")]
    active = up + [r for r in rows if r[3] in ("", "--") and r[2] in NET_TYPES]
    # Every connection's profile and live IPv4 at once (see parallel()).
    # (A connection that isn't up has no live IP4.)
    reads = parallel(*[(lambda u=uuid, f=fields: nm_kv(["-f", f, "con", "show", u]))
                       if fields != "IP4" or dev not in ("", "--") else dict
                       for _, uuid, _, dev in active
                       for fields in ("ipv4.method,ipv4.addresses,ipv4.gateway,ipv4.dns", "IP4")])
    for i, (name, uuid, ctype, dev) in enumerate(active):
        cfg, live = reads[2 * i], reads[2 * i + 1]

        def as_list(v):
            if not v:
                return []
            return v if isinstance(v, list) else [x.strip() for x in v.split(",") if x.strip()]

        addrs = as_list(cfg.get("ipv4.addresses"))
        first = addrs[0] if addrs else ""
        conns.append({
            "name": name,
            "uuid": uuid,
            "type": "wifi" if ctype == "802-11-wireless" else ("ethernet" if ctype == "802-3-ethernet" else ctype),
            "device": dev if dev not in ("", "--") else "",
            "active": dev not in ("", "--"),
            "method": cfg.get("ipv4.method", "auto"),
            "address": first.split("/")[0] if first else "",
            "prefix": int(first.split("/")[1]) if "/" in first else 24,
            "gateway": cfg.get("ipv4.gateway", "") if cfg.get("ipv4.gateway") != "--" else "",
            "dns": as_list(cfg.get("ipv4.dns")),
            "current": {
                "addresses": as_list(live.get("IP4.ADDRESS")),
                "gateway": live.get("IP4.GATEWAY", "") if isinstance(live.get("IP4.GATEWAY", ""), str) else "",
                "dns": as_list(live.get("IP4.DNS")),
            },
        })
    return {"hostname": socket.gethostname(), "connections": conns}


NETWORK = Coalesce(network_state, 3.0)


def ipv4_args(body):
    """nmcli ipv4.* arguments for {method: auto|manual, address, prefix,
    gateway, dns: [...]}."""
    method = body.get("method")
    if method == "auto":
        args = ["ipv4.method", "auto", "ipv4.addresses", "", "ipv4.gateway", "", "ipv4.dns", ""]
    elif method == "manual":
        try:
            addr = ipaddress.IPv4Address(body.get("address", "").strip())
            prefix = int(body.get("prefix", 24))
            if not 1 <= prefix <= 32:
                raise ValueError
            net = ipaddress.IPv4Network(f"{addr}/{prefix}", strict=False)
        except ValueError:
            raise ApiError("Invalid IP address or mask")
        gw = (body.get("gateway") or "").strip()
        if gw:
            try:
                if ipaddress.IPv4Address(gw) not in net:
                    raise ApiError("Gateway must be in the same subnet")
            except ValueError:
                raise ApiError("Invalid gateway address")
        dns = []
        for d in body.get("dns") or []:
            d = d.strip()
            if not d:
                continue
            try:
                dns.append(str(ipaddress.IPv4Address(d)))
            except ValueError:
                raise ApiError(Msg("Invalid DNS server: {dns}", dns=d))
        args = ["ipv4.method", "manual", "ipv4.addresses", f"{addr}/{prefix}",
                "ipv4.gateway", gw, "ipv4.dns", " ".join(dns)]
    else:
        raise ApiError("Mode must be auto or manual")
    return args


def network_set(body):
    """The connection's IPv4 settings. One that is up (or coming up, e.g.
    waiting for DHCP) is brought up again with them; a saved one that isn't
    uses them on its next connection."""
    uuid = body.get("uuid") or ""
    if not re.fullmatch(r"[0-9a-fA-F-]{36}", uuid):
        raise ApiError("No connection to change")
    run(["nmcli", "con", "mod", uuid] + ipv4_args(body))
    if not run(["nmcli", "-g", "GENERAL.STATE", "con", "show", uuid], check=False).strip():
        return
    # Re-activation drops the link briefly: run in background, the page polls.
    threading.Thread(target=run, args=(["nmcli", "con", "up", uuid],),
                     kwargs={"check": False, "timeout": 60}, daemon=True).start()


# ---------------------------------------------------------------- events
#
# GET /api/events (SSE) names changed topics; clients reload that part.
#   net     NetworkManager D-Bus signals
#   power   udev power_supply + periodic battery check
#   disks   udev block events (installer)
#   clock   wall clock was set
#   job     job progress and end
#   device, config, splash, boot, system   kioskd's own changes

class Events:
    def __init__(self):
        self.cond = threading.Condition()
        self.seq = 0
        self.recent = []  # (seq, topic)

    def emit(self, topic):
        with self.cond:
            self.seq += 1
            self.recent.append((self.seq, topic))
            del self.recent[:-200]
            self.cond.notify_all()

    def wait(self, after, timeout):
        """(newest seq, topics newer than `after`) -- empty after timeout."""
        with self.cond:
            self.cond.wait_for(lambda: self.seq > after, timeout)
            return self.seq, sorted({t for n, t in self.recent if n > after})


EVENTS = Events()


class Debounce:
    """A burst of pokes -> one event, `delay` after the first."""

    def __init__(self, topic, delay):
        self.topic, self.delay = topic, delay
        self.timer = None
        self.lock = threading.Lock()

    def poke(self):
        with self.lock:
            if self.timer is None:
                self.timer = threading.Timer(self.delay, self.fire)
                self.timer.daemon = True
                self.timer.start()

    def fire(self):
        with self.lock:
            self.timer = None
        EVENTS.emit(self.topic)


def watch_lines(cmd, debounce, name, wanted=None, on_line=None):
    """Any output line of a monitor command (that `wanted` accepts) pokes
    `debounce` and calls `on_line`; restarted if it exits."""
    while True:
        try:
            p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
            for line in p.stdout:
                if line.strip() and (wanted is None or wanted(line)):
                    if on_line:
                        on_line()
                    debounce.poke()
            p.wait()
        except OSError as e:
            print(f"kioskd: {name} watcher: {e}", flush=True)
        time.sleep(3)


def watch_power():
    """Charger changes come from udev; battery % is also polled every 30 s."""
    poke = Debounce("power", 0.5)
    threading.Thread(target=watch_lines, daemon=True, name="udev-power", args=(
        ["udevadm", "monitor", "--udev", "--subsystem-match=power_supply"], poke, "power")).start()
    last = None
    while True:
        try:
            now = power_state()
        except Exception:  # noqa: BLE001 -- sysfs oddities: try again later
            now = last
        if last is not None and now != last:
            poke.poke()
        last = now
        time.sleep(30)


def watch_clock():
    """Emit "clock" when the wall clock is set (timerfd CANCEL_ON_SET -> ECANCELED)."""
    if not hasattr(os, "timerfd_create"):
        return
    fd = os.timerfd_create(time.CLOCK_REALTIME)
    while True:
        os.timerfd_settime(fd, flags=os.TFD_TIMER_ABSTIME | os.TFD_TIMER_CANCEL_ON_SET,
                           initial=time.time() + 30 * 86400)
        try:
            os.read(fd, 8)
        except OSError as e:
            if e.errno != errno.ECANCELED:
                print(f"kioskd: clock watcher: {e}", flush=True)
                return
            EVENTS.emit("clock")


def nm_signal_wanted(line):
    """Not the access points' own property changes: their signal strength
    changes every few seconds, and each reloaded the whole Network tab
    (many nmcli calls) -- the Atom never caught up. Networks appearing or
    going, and new scan results, come on the device's path."""
    return not line.startswith("/org/freedesktop/NetworkManager/AccessPoint/")


def nm_changed():
    for cache in (WIFI, NET_BRIEF, NETWORK):
        cache.invalidate()
    HMI_WAKE.set()  # the HMI may have come or gone with the network


def start_watchers():
    net = Debounce("net", 1.0)
    threading.Thread(target=watch_lines, daemon=True, name="nm", args=(
        ["gdbus", "monitor", "--system", "--dest", "org.freedesktop.NetworkManager"], net, "NetworkManager",
        nm_signal_wanted, nm_changed)).start()
    # Disk hotplug (installer's list).
    threading.Thread(target=watch_lines, daemon=True, name="udev-block", args=(
        ["udevadm", "monitor", "--udev", "--subsystem-match=block"], Debounce("disks", 1.0), "disks")).start()
    threading.Thread(target=watch_power, daemon=True, name="power").start()
    threading.Thread(target=watch_clock, daemon=True, name="clock").start()


# ---------------------------------------------------------------- jobs
#
# Progress goes out as debounced "job" events; the page then fetches /api/job.
JOB_CHANGED = Debounce("job", 0.3)

class Job:
    """One long-running operation at a time (update, switch, install)."""

    def __init__(self, kind, title, steps=()):
        self.kind = kind
        self.title = title
        self.state = "running"  # running | done | failed
        self.stage = ""
        self.fraction = None  # 0..1 or None (indeterminate)
        self.detail = ""
        self.log = []
        self.result = None
        self.started = time.time()
        self.finished = None
        # Drawn by the page as a chain: done, active, pending.
        self.steps = [{"key": k, "label": label, "state": "pending", "detail": "",
                       "fraction": None, "started": None, "took": None, "pace": None}
                      for k, label in steps]

    def step(self, key, detail=None, fraction=None):
        """Make `key` the active step (earlier ones done or skipped); the job's
        stage/detail/fraction mirror it."""
        idx = next((i for i, st in enumerate(self.steps) if st["key"] == key), None)
        # Never go back: late events of an earlier step are ignored.
        if idx is None or any(st["state"] in ("active", "done") for st in self.steps[idx + 1:]):
            return
        now = time.time()
        for st in self.steps[:idx]:
            if st["state"] == "active":
                st.update(state="done", took=now - st["started"], fraction=None)
            elif st["state"] == "pending":
                st["state"] = "skipped"
        st = self.steps[idx]
        if st["state"] != "active":
            st.update(state="active", started=now, detail="", fraction=None)
        if detail is not None:
            st["detail"] = detail
        st["fraction"] = fraction
        self.stage, self.detail, self.fraction = st["label"], st["detail"], fraction
        JOB_CHANGED.poke()

    def pace(self, key, floor, expect):
        """Time-based bar for a step without byte counts: from `floor` toward
        1 over ~`expect` s (drawn by the page, app.js renderSteps, the same
        formula). A higher floor restarts it from there -- or from where the
        bar has got to already, never back."""
        st = next((s for s in self.steps if s["key"] == key and s["state"] == "active"), None)
        if not st:
            return
        now, p = time.time(), st["pace"]
        if p:
            left = 1 - p["floor"]
            shown = p["floor"] + left * (1 - math.exp(-1.5 * max(0, now - p["since"]) / max(1, p["expect"] * left)))
            if floor <= p["floor"]:
                return
            floor = max(floor, shown)
        st["pace"] = {"floor": floor, "since": now, "expect": expect}
        JOB_CHANGED.poke()

    def end_steps(self, error=None):
        now = time.time()
        for st in self.steps:
            if st["state"] == "active":
                st.update(state="failed" if error else "done", took=now - st["started"], fraction=None)
                if error:
                    st["detail"] = error
            elif st["state"] == "pending" and not error:
                st["state"] = "skipped"
        JOB_CHANGED.poke()

    # Setting any of these (the installer does directly) emits a "job" event.
    WATCHED = frozenset(("stage", "fraction", "detail", "state", "result", "finished"))

    def __setattr__(self, name, value):
        super().__setattr__(name, value)
        if name in self.WATCHED:
            JOB_CHANGED.poke()

    def add_log(self, line):
        line = line.rstrip()
        if line:
            self.log.append(line)
            del self.log[:-200]
            JOB_CHANGED.poke()

    def as_dict(self):
        return {k: getattr(self, k) for k in
                ("kind", "title", "state", "stage", "fraction", "detail", "result", "started", "finished",
                 "steps")} | {"log": self.log[-40:], "now": time.time()}


JOB_LOCK = threading.Lock()
CURRENT_JOB = None


def start_job(kind, title, target, steps=()):
    global CURRENT_JOB
    with JOB_LOCK:
        if CURRENT_JOB and CURRENT_JOB.state == "running":
            raise ApiError(Msg("Already running: {title}", title=CURRENT_JOB.title), HTTPStatus.CONFLICT)
        job = Job(kind, title, steps)
        CURRENT_JOB = job
    EVENTS.emit("job")

    def wrapper():
        try:
            target(job)
            job.end_steps()
            if job.state == "running":
                job.state = "done"
        except Exception as e:  # noqa: BLE001 -- anything goes to the page
            job.end_steps(error=text_of(e))
            job.state = "failed"
            job.detail = text_of(e)
            job.add_log(f"ERROR: {e}")
        finally:
            job.finished = time.time()
            EVENTS.emit("job")

    threading.Thread(target=wrapper, daemon=True).start()
    return job


# "pull" has byte progress; "local" (commit, deploy, prune) has none, so it
# gets a time-paced bar moved along by bootc's stages.
BOOTC_STEPS = [("pull", "Download"), ("local", "Preparing locally")]
UPGRADE_STEPS = [("check", "Check for a new version")] + BOOTC_STEPS
LOCAL_EXPECT_S = 95  # typical "local" duration: ~60 s write + ~35 s stages
# Labels for bootc stages, matched on subtask id or description.
BOOTC_STAGES = {"merging": "Merging the image", "deploying": "Deploying the new version",
                "bound_images": "Fetching bound images", "bound images": "Fetching bound images",
                "cleanup": "Removing old versions", "removing old images": "Removing old versions",
                "pruning": "Removing old versions"}
# Where each stage starts on "local"'s bar (the write is the first ~2/3).
STAGE_FLOOR = {"Merging the image": 0.68, "Fetching bound images": 0.74,
               "Deploying the new version": 0.80, "Removing old versions": 0.92}


def stage_name(sub):
    for key in (sub.get("subtask") or "", sub.get("description") or ""):
        k = key.lower()
        for name, label in BOOTC_STAGES.items():
            if name in k:
                return label
    return sub.get("description") or sub.get("subtask") or ""


def decimal(x, digits=1):
    return f"{x:.{digits}f}"


def run_bootc_with_progress(job, args):
    """bootc <args> --progress-fd N, events (JSON Lines) drive job's bar."""
    r, w = os.pipe()
    proc = subprocess.Popen(["bootc"] + args + ["--progress-fd", str(w)],
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                            pass_fds=(w,))
    os.close(w)

    # Speed over a ~5 s window, plus ETA.
    samples = []

    def progress(done, total):
        """"12 / 345 MB", with the speed and time left once known."""
        mb = {"done": f"{done / 1e6:.0f}", "total": f"{total / 1e6:.0f}"}
        now = time.monotonic()
        if samples and done < samples[-1][1]:
            samples.clear()  # a new download task started from zero
        samples.append((now, done))
        while len(samples) > 2 and now - samples[0][0] > 5:
            samples.pop(0)
        t0, b0 = samples[0]
        if now - t0 < 1 or done <= b0:
            return Msg("{done} / {total} MB", **mb)
        rate = (done - b0) / (now - t0)
        left = (total - done) / rate
        eta = f"{left / 60:.0f} min" if left >= 90 else f"{max(1, left):.0f} s"
        return Msg("{done} / {total} MB · {rate} MB/s · about {eta} left", **mb,
                   rate=decimal(rate / 1e6), eta=eta)

    def read_progress():
        with os.fdopen(r, "r") as f:
            for line in f:
                try:
                    ev = json.loads(line)
                except ValueError:
                    continue
                t, task = ev.get("type"), ev.get("task")
                if t == "Start":
                    job.step("pull")
                elif t == "ProgressBytes" and task == "pulling":
                    done, total = ev.get("bytes") or 0, ev.get("bytesTotal") or 0
                    if total and done < total:
                        job.step("pull", progress(done, total),
                                 done / total)
                    else:
                        # Download complete (or cached): summarize the pull step.
                        pull = job.steps[[st["key"] for st in job.steps].index("pull")] \
                            if any(st["key"] == "pull" for st in job.steps) else None
                        if pull and pull["state"] == "active" and total:
                            secs = time.time() - pull["started"]
                            pull["detail"] = (
                                Msg("{total} MB · average {rate} MB/s", total=f"{total / 1e6:.0f}",
                                    rate=decimal(total / 1e6 / secs))
                                if secs >= 1 else Msg("{total} MB", total=f"{total / 1e6:.0f}"))
                        cached = ev.get("bytesCached") or 0
                        job.step("local", "Writing the image to disk" if total else
                                 (Msg("{mb} MB was already on disk", mb=f"{cached / 1e6:.0f}") if cached
                                  else "Writing the image to disk"))
                        job.pace("local", 0.0, LOCAL_EXPECT_S)
                elif task in ("pulling", "importing"):
                    job.step("local", "Writing the image to disk")
                    job.pace("local", 0.0, LOCAL_EXPECT_S)
                elif task == "staging" or ev.get("stepsTotal"):
                    steps, total = ev.get("steps") or 0, ev.get("stepsTotal") or 0
                    running = next((s for s in ev.get("subtasks") or [] if not s.get("completed")), None)
                    name = stage_name(running) if running else None
                    job.step("local", name)
                    # The write is ~2/3 of "local"; the stages fill the rest,
                    # each from its own place (bootc's step counts barely move).
                    floor = STAGE_FLOOR.get(name, 2 / 3 + (1 / 3) * (steps / total if total else 0))
                    job.pace("local", floor, LOCAL_EXPECT_S)

    t = threading.Thread(target=read_progress, daemon=True)
    t.start()
    for line in proc.stdout:
        job.add_log(line)
    proc.wait()
    t.join(timeout=5)
    if proc.returncode != 0:
        raise RuntimeError(job.log[-1] if job.log else f"bootc exited with code {proc.returncode}")


# Version labels end in the git sha ("v45.20261122.1-778b844", dev
# "v45.3f30f95"); it links a deployment to its GitHub release.
VERSION_SHA = re.compile(r"(?:-|^v\d+\.)([0-9a-f]{7,40})$")

# Last `bootc upgrade --check` in this process; the page re-checks when stale.
LAST_CHECK = {"time": None, "error": None}


LAST_STATUS = {"value": None}  # last good bootc_status(), see r_system

# build.yml: main -> :latest, dev branch -> :dev; any other tag is custom.
CHANNELS = {"stable": {"tag": "latest", "name": "stable"},
            "dev": {"tag": "dev", "name": "testing"}}


def split_image(image):
    """"ghcr.io/o/r:tag" -> ("ghcr.io/o/r", "tag"); no tag means latest."""
    image = image.split("@", 1)[0]
    head, _, last = image.rpartition("/")
    if ":" in last:
        name, tag = last.split(":", 1)
        return f"{head}/{name}" if head else name, tag
    return image, "latest"


def channel_of(image):
    if not image:
        return None
    tag = split_image(image)[1]
    return next((c for c, v in CHANNELS.items() if v["tag"] == tag), "custom")


def bootc_status():
    try:
        st = json.loads(run(["bootc", "status", "--format=json"], timeout=30))
    except (ApiError, ValueError) as e:
        return {"available": False, "error": text_of(e), "checked": LAST_CHECK}

    def sha(version):
        m = VERSION_SHA.search(version or "")
        return m.group(1) if m else ""

    def entry(e):
        if not e:
            return None
        img = e.get("image") or {}
        ref = (img.get("image") or {})
        cached = e.get("cachedUpdate") or None
        version = img.get("version") or ""
        return {
            "image": ref.get("image", ""),
            "transport": ref.get("transport", ""),
            "version": version,
            "sha": sha(version),
            "timestamp": img.get("timestamp") or "",
            "digest": img.get("imageDigest") or "",
            "update": {
                "version": cached.get("version") or "",
                "sha": sha(cached.get("version")),
                "timestamp": cached.get("timestamp") or "",
                "digest": cached.get("imageDigest") or "",
            } if cached else None,
        }

    s = st.get("status") or {}
    booted = entry(s.get("booted"))
    staged = entry(s.get("staged"))
    rollback = entry(s.get("rollback"))
    update = booted.get("update") if booted else None
    # kioskd's own check (registry_latest) of the image upgrades come from.
    remote = REMOTE["value"]
    if remote and remote["image"] == (staged or booted or {}).get("image"):
        update = {k: remote[k] for k in ("version", "timestamp", "digest")}
        update["sha"] = sha(update["version"])
    # bootc's cached check result is not an update if it's a version on the
    # disk already: booted, staged, or the rollback one (after going back to
    # the previous version that's the one left -- not offered again). Nor if
    # it isn't newer than the staged one: the cache can predate the update.
    for dep in (booted, staged, rollback):
        if update and dep and update["digest"] == dep["digest"]:
            update = None
    if update and staged and update["timestamp"] and staged["timestamp"] \
            and update["timestamp"] <= staged["timestamp"]:
        update = None
    # next_channel: where a staged switch goes.
    st = {"available": True, "booted": booted, "staged": staged, "rollback": rollback,
          "update": update, "checked": LAST_CHECK,
          # Rollback done, previous deployment boots next.
          "rollback_queued": bool(s.get("rollbackQueued")),
          "channel": channel_of((booted or {}).get("image")),
          "next_channel": channel_of((staged or booted or {}).get("image"))}
    LAST_STATUS["value"] = st
    return st


MANIFEST_TYPES = ("application/vnd.oci.image.manifest.v1+json",
                  "application/vnd.docker.distribution.manifest.v2+json",
                  "application/vnd.oci.image.index.v1+json",
                  "application/vnd.docker.distribution.manifest.list.v2+json")
ARCHES = {"x86_64": "amd64", "aarch64": "arm64"}


def registry_latest(image):
    """{digest, version, timestamp} of `image` ("host/repo:tag") as its
    registry has it now: the manifest and its config, three or four small
    HTTPS requests (an anonymous token first, as ghcr.io wants one even for
    public images). What `bootc upgrade --check` reports, without its image
    proxy, signature lookup and sysroot lock -- most of a minute on the Atom.
    The signature is still checked, by bootc, when the update downloads."""
    repo, tag = split_image(image)
    host, _, path = repo.partition("/")
    if not path or ("." not in host and ":" not in host):
        raise ValueError(f"not a registry reference: {image}")
    base = f"https://{host}/v2/{path}"
    token = None

    def get(url, accept):
        req = urllib.request.Request(url, headers={"Accept": accept, "User-Agent": "immutable-kiosk"})
        if token:
            # Not passed on to the blob storage a blob redirects to.
            req.add_unredirected_header("Authorization", f"Bearer {token}")
        with urllib.request.urlopen(req, timeout=15) as r:
            return r.read()

    def get_auth(url, accept):
        nonlocal token
        try:
            return get(url, accept)
        except urllib.error.HTTPError as e:
            challenge = e.headers.get("WWW-Authenticate", "") if e.code == 401 else ""
            if token or not challenge.lower().startswith("bearer "):
                raise
            params = dict(re.findall(r'(\w+)="([^"]*)"', challenge))
            query = urlencode({"service": params.get("service", host),
                                            "scope": params.get("scope", f"repository:{path}:pull")})
            with urllib.request.urlopen(urllib.request.Request(
                    f"{params['realm']}?{query}", headers={"User-Agent": "immutable-kiosk"}), timeout=15) as r:
                t = json.loads(r.read())
            token = t.get("token") or t.get("access_token")
            return get(url, accept)

    body = get_auth(f"{base}/manifests/{tag}", ", ".join(MANIFEST_TYPES))
    manifest = json.loads(body)
    if "manifests" in manifest:  # a multi-arch index: this machine's image
        arch = ARCHES.get(os.uname().machine, os.uname().machine)
        pick = next(m for m in manifest["manifests"]
                    if (m.get("platform") or {}).get("architecture") == arch
                    and (m.get("platform") or {}).get("os", "linux") == "linux")
        body = get_auth(f"{base}/manifests/{pick['digest']}", ", ".join(MANIFEST_TYPES[:2]))
        manifest = json.loads(body)
    config = json.loads(get_auth(f"{base}/blobs/{manifest['config']['digest']}", "*/*"))
    labels = (config.get("config") or {}).get("Labels") or {}
    created = config.get("created") or labels.get("org.opencontainers.image.created") or ""
    return {"image": image, "digest": "sha256:" + hashlib.sha256(body).hexdigest(),
            "version": labels.get("org.opencontainers.image.version") or "",
            # bootc's form: whole seconds, UTC "Z".
            "timestamp": re.sub(r"\.\d+", "", created).replace("+00:00", "Z")}


# Last registry_latest() result (with its image); bootc_status() prefers it
# to bootc's cached check for that image.
REMOTE = {"value": None}


def check_for_update(job):
    """Ask the registry (registry_latest); `bootc upgrade --check` only if that
    can't be done (an image not from a registry, an unexpected answer).
    Remembered in LAST_CHECK."""
    job.stage = "Checking for updates"
    job.step("check")
    st = LAST_STATUS["value"] or bootc_status()
    target = (st.get("staged") or st.get("booted") or {}) if st.get("available") else {}
    image = target.get("image") if target.get("transport") == "registry" else None
    t0 = time.monotonic()
    try:
        if image:
            try:
                REMOTE["value"] = registry_latest(image)
                job.add_log(f"{image}: {REMOTE['value']['version'] or REMOTE['value']['digest']} "
                            f"({time.monotonic() - t0:.1f} s)")
                LAST_CHECK.update(time=time.time(), error=None)
                return bootc_status()
            except urllib.error.HTTPError as e:
                job.add_log(f"registry: HTTP {e.code}, asking bootc")
            except urllib.error.URLError as e:
                # Offline or no DNS: bootc would fail the same way, only slower.
                raise ApiError(f"Can't reach {split_image(image)[0].split('/')[0]}: {e.reason}")
            except (OSError, ValueError, KeyError, StopIteration, TypeError) as e:
                job.add_log(f"registry: {e!r}, asking bootc")
        REMOTE["value"] = None
        out = run(["bootc", "upgrade", "--check"], timeout=180)
    except ApiError as e:
        LAST_CHECK.update(time=time.time(), error=text_of(e))
        raise
    LAST_CHECK.update(time=time.time(), error=None)
    for line in out.splitlines():
        job.add_log(line)
    return bootc_status()


def job_check(job):
    job.result = check_for_update(job)
    job.detail = "New version available" if job.result.get("update") else "System is up to date"


def job_upgrade(job):
    # Always re-check the registry.
    st = check_for_update(job)
    if not st.get("update"):
        job.stage = "Done"
        job.detail = "System is up to date"
        job.result = st
        return
    update = st["update"]
    job.step("check", Msg("New version: {version}",
                          version=update.get("version") or update.get("digest", "")[7:19]))
    run_bootc_with_progress(job, ["upgrade"])
    job.end_steps()
    job.fraction = 1
    job.stage = "Done"
    job.detail = "The new version starts after a restart"
    job.result = bootc_status()


