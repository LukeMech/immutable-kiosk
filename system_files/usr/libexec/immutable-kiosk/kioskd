# ---------------------------------------------------------------- helpers

def run(cmd, check=True, timeout=60, **kw):
    """Run a command, return stdout (str). Raises ApiError with stderr on failure."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, **kw)
    except subprocess.TimeoutExpired:
        raise ApiError(f"{cmd[0]}: przekroczono czas ({timeout} s)")
    except FileNotFoundError:
        raise ApiError(f"brak programu {cmd[0]}")
    if check and p.returncode != 0:
        msg = (p.stderr or p.stdout).strip() or f"{cmd[0]} zakończył się kodem {p.returncode}"
        raise ApiError(msg)
    return p.stdout


class ApiError(Exception):
    def __init__(self, message, status=HTTPStatus.BAD_REQUEST):
        super().__init__(message)
        self.status = status


def mode():
    try:
        return MODE_FILE.read_text().strip() or "kiosk"
    except FileNotFoundError:
        return "kiosk"


def read_dmi(field):
    try:
        return Path(f"/sys/class/dmi/id/{field}").read_text().strip()
    except OSError:
        return ""


def default_rotation():
    """This model's rotation until one is set in Settings: the entry whose
    dmi_product is in this machine's DMI product name, else the default."""
    try:
        table = json.loads(DEFAULT_ROTATION_FILE.read_text())
    except (OSError, ValueError):
        table = {}
    product = read_dmi("product_name").lower()
    for dev in table.get("devices", []):
        if dev.get("dmi_product") and dev["dmi_product"].lower() in product and dev.get("rotation") in ROTATIONS:
            return dev["rotation"]
    return table.get("default") if table.get("default") in ROTATIONS else "landscape"


def load_config():
    cfg = json.loads(json.dumps(DEFAULT_CONFIG))
    try:
        stored = json.loads(CONFIG_FILE.read_text())
    except (OSError, ValueError):
        stored = {}
    for k, v in stored.items():
        if k == "hmi" and isinstance(v, dict):
            cfg["hmi"].update(v)
        elif k in cfg:
            cfg[k] = v
    return cfg


def backlight():
    """The panel's backlight device, preferring firmware > platform > raw (as systemd/GNOME do)."""
    order = {"firmware": 0, "platform": 1, "raw": 2}
    best = None
    for d in BACKLIGHT_DIR.glob("*"):
        try:
            kind = (d / "type").read_text().strip()
            int((d / "max_brightness").read_text())
        except (OSError, ValueError):
            continue
        rank = order.get(kind, 3)
        if best is None or rank < best[0]:
            best = (rank, d)
    return best[1] if best else None


def brightness_get():
    """Current backlight in percent, or None if there's no backlight device."""
    d = backlight()
    if not d:
        return None
    try:
        cur = int((d / "brightness").read_text())
        mx = int((d / "max_brightness").read_text())
    except (OSError, ValueError):
        return None
    return round(cur * 100 / mx) if mx > 0 else None


def brightness_set(percent):
    d = backlight()
    if not d:
        raise ApiError("Ten ekran nie ma regulacji jasności")
    percent = max(BRIGHTNESS_MIN, min(100, int(percent)))
    mx = int((d / "max_brightness").read_text())
    (d / "brightness").write_text(str(max(1, round(mx * percent / 100))))


def effective_config():
    cfg = load_config()
    cfg["rotation_effective"] = cfg["rotation"] or default_rotation()
    cfg["brightness_now"] = brightness_get()
    cfg["hmi_url"] = hmi_url(cfg["hmi"])
    cfg["mode"] = mode()
    return cfg


def hmi_url(h):
    host = (h.get("host") or "").strip()
    if not host:
        return ""
    if ":" in host and not host.startswith("["):  # bare IPv6
        host = f"[{host}]"
    scheme = h.get("scheme") or "https"
    port = h.get("port")
    default_port = {"http": 80, "https": 443}[scheme]
    path = h.get("path") or "/"
    if not path.startswith("/"):
        path = "/" + path
    port_part = f":{port}" if port and int(port) != default_port else ""
    return f"{scheme}://{host}{port_part}{path}"


def save_config(update):
    cfg = load_config()
    if "hmi" in update:
        h = update["hmi"]
        if not isinstance(h, dict):
            raise ApiError("hmi: oczekiwano obiektu")
        scheme = h.get("scheme", cfg["hmi"]["scheme"])
        if scheme not in ("http", "https"):
            raise ApiError("Protokół musi być http lub https")
        host = str(h.get("host", cfg["hmi"]["host"])).strip()
        if host and not re.fullmatch(r"[A-Za-z0-9.\-:\[\]]+", host):
            raise ApiError("Niepoprawny adres IP / nazwa hosta")
        port = h.get("port", cfg["hmi"]["port"])
        try:
            port = int(port)
        except (TypeError, ValueError):
            raise ApiError("Port musi być liczbą")
        if not 1 <= port <= 65535:
            raise ApiError("Port musi być z zakresu 1-65535")
        path = str(h.get("path", cfg["hmi"]["path"])).strip() or "/"
        cfg["hmi"] = {"scheme": scheme, "host": host, "port": port, "path": path}
    if "rotation" in update:
        r = update["rotation"]
        if r is not None and r not in ROTATIONS:
            raise ApiError("Niepoprawna orientacja")
        cfg["rotation"] = r
    for key in ("osk_in_hmi", "accept_self_signed"):
        if key in update:
            cfg[key] = bool(update[key])
    if "zoom" in update:
        z = float(update["zoom"])
        if not 0.5 <= z <= 3.0:
            raise ApiError("Powiększenie: 50-300%")
        cfg["zoom"] = round(z, 2)
    if "scale" in update:
        try:
            s = float(update["scale"])
        except (TypeError, ValueError):
            raise ApiError("Skalowanie musi być liczbą")
        if not 1.0 <= s <= 2.0:
            raise ApiError("Skalowanie ekranu: 100-200%")
        cfg["scale"] = round(s, 2)  # WebKit zoom of both views (kiosk-shell apply_scale)
    if "releases_repo" in update:
        repo = str(update["releases_repo"] or "").strip().removeprefix("https://github.com/").strip("/")
        repo = repo or DEFAULT_CONFIG["releases_repo"]
        if not GITHUB_REPO.match(repo):
            raise ApiError("Repozytorium w postaci właściciel/nazwa, np. LukeMech/immutable-kiosk")
        cfg["releases_repo"] = repo
    if "accent" in update:
        if update["accent"] not in ACCENTS:
            raise ApiError("Nieznany kolor akcentu")
        cfg["accent"] = update["accent"]
    if "settings_corner" in update:
        if update["settings_corner"] not in CORNERS:
            raise ApiError("Niepoprawny róg ekranu")
        cfg["settings_corner"] = update["settings_corner"]
    if "retry_seconds" in update:
        cfg["retry_seconds"] = max(3, min(300, int(update["retry_seconds"])))
    if "brightness" in update:
        try:
            b = int(update["brightness"])
        except (TypeError, ValueError):
            raise ApiError("Jasność musi być liczbą")
        if not BRIGHTNESS_MIN <= b <= 100:
            raise ApiError(f"Jasność: {BRIGHTNESS_MIN}-100%")
        brightness_set(b)
        cfg["brightness"] = b
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = CONFIG_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(cfg, indent=2))
    os.chmod(tmp, 0o644)
    tmp.replace(CONFIG_FILE)
    return effective_config()


# ---------------------------------------------------------------- nmcli

def nm_split(line):
    """Split one line of `nmcli -t` output on unescaped ':' and unescape."""
    fields, cur, i = [], [], 0
    while i < len(line):
        c = line[i]
        if c == "\\" and i + 1 < len(line):
            cur.append(line[i + 1])
            i += 2
            continue
        if c == ":":
            fields.append("".join(cur))
            cur = []
        else:
            cur.append(c)
        i += 1
    fields.append("".join(cur))
    return fields


def nm_rows(args, timeout=30):
    out = run(["nmcli", "-t"] + args, timeout=timeout)
    return [nm_split(l) for l in out.splitlines() if l]


def nm_kv(args):
    """`nmcli -t -f X con show ...` key:value lines -> dict (multi-values -> list)."""
    out = run(["nmcli", "-t"] + args)
    d = {}
    for line in out.splitlines():
        if ":" not in line:
            continue
        k, v = line.split(":", 1)
        k = re.sub(r"\[\d+\]$", "", k)
        v = v.replace("\\:", ":").replace("\\\\", "\\")
        if k in d:
            d[k] = d[k] if isinstance(d[k], list) else [d[k]]
            d[k].append(v)
        else:
            d[k] = v
    return d


def saved_wifi():
    """[{name, uuid, ssid, active}] for every saved Wi-Fi profile."""
    result = []
    for name, uuid, ctype, dev in nm_rows(["-f", "NAME,UUID,TYPE,DEVICE", "con", "show"]):
        if ctype != "802-11-wireless":
            continue
        ssid = run(["nmcli", "-g", "802-11-wireless.ssid", "con", "show", uuid], check=False).strip()
        result.append({"name": name, "uuid": uuid, "ssid": ssid or name, "active": bool(dev)})
    return result


def wifi_state(rescan):
    radio = run(["nmcli", "radio", "wifi"], check=False).strip() == "enabled"
    saved = saved_wifi()
    saved_ssids = {s["ssid"] for s in saved}
    networks = {}
    if radio:
        rows = nm_rows(["-f", "IN-USE,SSID,SIGNAL,SECURITY", "dev", "wifi", "list",
                        "--rescan", "yes" if rescan else "auto"], timeout=45)
        for in_use, ssid, signal, security in rows:
            if not ssid:
                continue  # hidden network: joined by name instead
            n = networks.get(ssid)
            sig = int(signal or 0)
            if n is None or sig > n["signal"]:
                networks[ssid] = {
                    "ssid": ssid,
                    "signal": sig,
                    "security": security if security not in ("", "--") else "",
                    "in_use": in_use == "*" or (n or {}).get("in_use", False),
                    "saved": ssid in saved_ssids,
                }
            elif in_use == "*":
                n["in_use"] = True
    nets = sorted(networks.values(), key=lambda n: (not n["in_use"], -n["signal"]))
    return {"enabled": radio, "networks": nets, "saved": saved, "device": wifi_device()}


def net_brief():
    """For Settings' top bar (polled every 5 s while it's open), so cheap:
    the connected device -- Ethernet wins over Wi-Fi -- and for Wi-Fi the
    signal from NetworkManager's last scan (no rescan). None = offline."""
    try:
        rows = nm_rows(["-f", "DEVICE,TYPE,STATE,CONNECTION", "dev"], timeout=5)
    except ApiError:
        return None
    best = None
    for _dev, typ, state, conn in rows:
        if typ not in ("ethernet", "wifi") or not state.startswith("connected"):
            continue
        item = {"type": typ, "name": conn if conn not in ("", "--") else typ}
        if typ == "ethernet":
            return item
        best = best or item
    if best:
        try:
            for in_use, signal in nm_rows(["-f", "IN-USE,SIGNAL", "dev", "wifi", "list", "--rescan", "no"], timeout=5):
                if in_use == "*":
                    best["signal"] = int(signal or 0)
                    break
        except (ApiError, ValueError):
            pass
    return best


def wifi_device():
    """The Wi-Fi adapter's state for the status line: {device, state,
    connection, address} -- state is nmcli's (connected, connecting
    (getting IP configuration), disconnected, unavailable...). None = no
    Wi-Fi adapter at all."""
    try:
        rows = nm_rows(["-f", "DEVICE,TYPE,STATE,CONNECTION", "dev"])
    except ApiError:
        return None
    for dev, typ, state, conn in rows:
        if typ != "wifi":
            continue
        addr = ""
        if state.startswith("connected"):
            a = nm_kv(["-f", "IP4.ADDRESS", "dev", "show", dev]).get("IP4.ADDRESS", "")
            addr = (a[0] if isinstance(a, list) else a).split("/")[0]
        return {"device": dev, "state": state, "connection": "" if conn in ("", "--") else conn, "address": addr}
    return None


def wifi_connect(ssid, password, hidden):
    if not ssid:
        raise ApiError("Podaj nazwę sieci")
    existing = [s for s in saved_wifi() if s["ssid"] == ssid]
    if existing and not password:
        run(["nmcli", "con", "up", existing[0]["uuid"]], timeout=60)
        return
    # New password = new profile: an old one with a stale password would
    # otherwise be tried first and fail.
    for s in existing:
        run(["nmcli", "con", "delete", s["uuid"]], check=False)
    # The password ends up on nmcli's command line for a moment; only root
    # and the kiosk user exist on this machine.
    cmd = ["nmcli", "dev", "wifi", "connect", ssid]
    if password:
        cmd += ["password", password]
    if hidden:
        cmd += ["hidden", "yes"]
    run(cmd, timeout=90)


def network_state():
    conns = []
    for name, uuid, ctype, dev in nm_rows(["-f", "NAME,UUID,TYPE,DEVICE", "con", "show", "--active"]):
        if ctype == "loopback" or dev == "lo":
            continue
        cfg = nm_kv(["-f", "ipv4.method,ipv4.addresses,ipv4.gateway,ipv4.dns", "con", "show", uuid])
        live = nm_kv(["-f", "IP4", "con", "show", uuid])

        def as_list(v):
            if not v:
                return []
            return v if isinstance(v, list) else [x.strip() for x in v.split(",") if x.strip()]

        addrs = as_list(cfg.get("ipv4.addresses"))
        first = addrs[0] if addrs else ""
        conns.append({
            "name": name,
            "uuid": uuid,
            "type": "wifi" if ctype == "802-11-wireless" else ("ethernet" if ctype == "802-3-ethernet" else ctype),
            "device": dev,
            "method": cfg.get("ipv4.method", "auto"),
            "address": first.split("/")[0] if first else "",
            "prefix": int(first.split("/")[1]) if "/" in first else 24,
            "gateway": cfg.get("ipv4.gateway", "") if cfg.get("ipv4.gateway") != "--" else "",
            "dns": as_list(cfg.get("ipv4.dns")),
            "current": {
                "addresses": as_list(live.get("IP4.ADDRESS")),
                "gateway": live.get("IP4.GATEWAY", "") if isinstance(live.get("IP4.GATEWAY", ""), str) else "",
                "dns": as_list(live.get("IP4.DNS")),
            },
        })
    return {"hostname": socket.gethostname(), "connections": conns}


def network_set(body):
    uuid = body.get("uuid") or ""
    if not re.fullmatch(r"[0-9a-fA-F-]{36}", uuid):
        raise ApiError("Brak połączenia do zmiany")
    method = body.get("method")
    if method == "auto":
        args = ["ipv4.method", "auto", "ipv4.addresses", "", "ipv4.gateway", "", "ipv4.dns", ""]
    elif method == "manual":
        try:
            addr = ipaddress.IPv4Address(body.get("address", "").strip())
            prefix = int(body.get("prefix", 24))
            if not 1 <= prefix <= 32:
                raise ValueError
            net = ipaddress.IPv4Network(f"{addr}/{prefix}", strict=False)
        except ValueError:
            raise ApiError("Niepoprawny adres IP lub maska")
        gw = (body.get("gateway") or "").strip()
        if gw:
            try:
                if ipaddress.IPv4Address(gw) not in net:
                    raise ApiError("Brama musi być w tej samej podsieci")
            except ValueError:
                raise ApiError("Niepoprawny adres bramy")
        dns = []
        for d in body.get("dns") or []:
            d = d.strip()
            if not d:
                continue
            try:
                dns.append(str(ipaddress.IPv4Address(d)))
            except ValueError:
                raise ApiError(f"Niepoprawny serwer DNS: {d}")
        args = ["ipv4.method", "manual", "ipv4.addresses", f"{addr}/{prefix}",
                "ipv4.gateway", gw, "ipv4.dns", " ".join(dns)]
    else:
        raise ApiError("Tryb musi być auto lub manual")
    run(["nmcli", "con", "mod", uuid] + args)
    # Re-activating drops the link for a moment; that never affects this API
    # (localhost), so it runs in the background and the page polls the result.
    threading.Thread(target=run, args=(["nmcli", "con", "up", uuid],),
                     kwargs={"check": False, "timeout": 60}, daemon=True).start()


# ---------------------------------------------------------------- jobs

class Job:
    """One long-running operation at a time (update, switch, install)."""

    def __init__(self, kind, title):
        self.kind = kind
        self.title = title
        self.state = "running"  # running | done | failed
        self.stage = ""
        self.fraction = None  # 0..1 or None (indeterminate)
        self.detail = ""
        self.log = []
        self.result = None
        self.started = time.time()
        self.finished = None

    def add_log(self, line):
        line = line.rstrip()
        if line:
            self.log.append(line)
            del self.log[:-200]

    def as_dict(self):
        return {k: getattr(self, k) for k in
                ("kind", "title", "state", "stage", "fraction", "detail", "result", "started", "finished")} | {
            "log": self.log[-40:]}


JOB_LOCK = threading.Lock()
CURRENT_JOB = None


def start_job(kind, title, target):
    global CURRENT_JOB
    with JOB_LOCK:
        if CURRENT_JOB and CURRENT_JOB.state == "running":
            raise ApiError(f"Trwa już: {CURRENT_JOB.title}", HTTPStatus.CONFLICT)
        job = Job(kind, title)
        CURRENT_JOB = job

    def wrapper():
        try:
            target(job)
            if job.state == "running":
                job.state = "done"
        except Exception as e:  # noqa: BLE001 -- anything goes to the page
            job.state = "failed"
            job.detail = str(e)
            job.add_log(f"BŁĄD: {e}")
        finally:
            job.finished = time.time()

    threading.Thread(target=wrapper, daemon=True).start()
    return job


BOOTC_STAGES = {"pulling": "Pobieranie", "importing": "Importowanie", "staging": "Przygotowanie"}


def run_bootc_with_progress(job, args):
    """bootc <args> --progress-fd N, events (JSON Lines) drive job's bar."""
    r, w = os.pipe()
    proc = subprocess.Popen(["bootc"] + args + ["--progress-fd", str(w)],
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                            pass_fds=(w,))
    os.close(w)

    # Download speed: bytes over the last ~5 s (one slow layer or a burst
    # doesn't swing it), and what's left at that speed.
    samples = []

    def speed_text(done, total):
        now = time.monotonic()
        if samples and done < samples[-1][1]:
            samples.clear()  # a new download task started from zero
        samples.append((now, done))
        while len(samples) > 2 and now - samples[0][0] > 5:
            samples.pop(0)
        t0, b0 = samples[0]
        if now - t0 < 1 or done <= b0:
            return ""
        rate = (done - b0) / (now - t0)
        left = (total - done) / rate
        eta = f"{left / 60:.0f} min" if left >= 90 else f"{max(1, left):.0f} s"
        return f" · {rate / 1e6:.1f} MB/s · zostało ok. {eta}".replace(".", ",")

    def read_progress():
        with os.fdopen(r, "r") as f:
            for line in f:
                try:
                    ev = json.loads(line)
                except ValueError:
                    continue
                t = ev.get("type")
                if t == "Start":
                    job.stage, job.fraction = "Start", 0
                    continue
                job.stage = BOOTC_STAGES.get(ev.get("task"), ev.get("description") or ev.get("task") or "")
                if t == "ProgressBytes" and ev.get("bytesTotal"):
                    job.fraction = ev["bytes"] / ev["bytesTotal"]
                    job.detail = (f"{ev['bytes'] / 1e6:.0f} / {ev['bytesTotal'] / 1e6:.0f} MB"
                                  + speed_text(ev["bytes"], ev["bytesTotal"]))
                elif ev.get("stepsTotal"):
                    job.fraction = ev.get("steps", 0) / ev["stepsTotal"]
                    running = next((s.get("description") for s in ev.get("subtasks") or []
                                    if not s.get("completed")), "")
                    job.detail = running or f"krok {ev.get('steps', 0)} / {ev['stepsTotal']}"

    t = threading.Thread(target=read_progress, daemon=True)
    t.start()
    for line in proc.stdout:
        job.add_log(line)
    proc.wait()
    t.join(timeout=5)
    if proc.returncode != 0:
        raise RuntimeError(job.log[-1] if job.log else f"bootc zakończył się kodem {proc.returncode}")


# The image's version label is "<tag>.<date>-<git sha>" (Justfile): the sha
# ties a deployment to its commit, and through the release tag on that commit
# to its GitHub release (changelog).
VERSION_SHA = re.compile(r"-([0-9a-f]{7,40})$")

# Last `bootc upgrade --check` (this kioskd's lifetime): the page checks on its
# own when this is old or missing, and shows when it was.
LAST_CHECK = {"time": None, "error": None}


LAST_STATUS = {"value": None}  # last good bootc_status(), see r_system


def bootc_status():
    try:
        st = json.loads(run(["bootc", "status", "--format=json"], timeout=30))
    except (ApiError, ValueError) as e:
        return {"available": False, "error": str(e), "checked": LAST_CHECK}

    def sha(version):
        m = VERSION_SHA.search(version or "")
        return m.group(1) if m else ""

    def entry(e):
        if not e:
            return None
        img = e.get("image") or {}
        ref = (img.get("image") or {})
        cached = e.get("cachedUpdate") or None
        version = img.get("version") or ""
        return {
            "image": ref.get("image", ""),
            "transport": ref.get("transport", ""),
            "version": version,
            "sha": sha(version),
            "timestamp": img.get("timestamp") or "",
            "digest": img.get("imageDigest") or "",
            "update": {
                "version": cached.get("version") or "",
                "sha": sha(cached.get("version")),
                "timestamp": cached.get("timestamp") or "",
                "digest": cached.get("imageDigest") or "",
            } if cached else None,
        }

    s = st.get("status") or {}
    booted = entry(s.get("booted"))
    staged = entry(s.get("staged"))
    rollback = entry(s.get("rollback"))
    update = booted.get("update") if booted else None
    # Nothing to do: already running it, or already downloaded and waiting
    # for the restart.
    if update and booted and update["digest"] == booted["digest"]:
        update = None
    if update and staged and update["digest"] == staged["digest"]:
        update = None
    st = {"available": True, "booted": booted, "staged": staged, "rollback": rollback,
          "update": update, "checked": LAST_CHECK}
    LAST_STATUS["value"] = st
    return st


def check_for_update(job):
    """bootc upgrade --check (fetches only the manifest), remembered in LAST_CHECK."""
    job.stage = "Sprawdzanie aktualizacji"
    try:
        out = run(["bootc", "upgrade", "--check"], timeout=180)
    except ApiError as e:
        LAST_CHECK.update(time=time.time(), error=str(e))
        raise
    LAST_CHECK.update(time=time.time(), error=None)
    for line in out.splitlines():
        job.add_log(line)
    return bootc_status()


def job_check(job):
    job.result = check_for_update(job)
    job.detail = "Dostępna nowa wersja" if job.result.get("update") else "System jest aktualny"


def job_upgrade(job):
    # Always against what's in the registry right now, not an old check.
    st = check_for_update(job)
    if not st.get("update"):
        job.stage = "Gotowe"
        job.detail = "System jest aktualny"
        job.result = st
        return
    run_bootc_with_progress(job, ["upgrade"])
    job.fraction = 1
    job.stage = "Gotowe"
    job.detail = "Nowa wersja zostanie uruchomiona po restarcie"
    job.result = bootc_status()


# ---------------------------------------------------------------- changelog

# Release notes come from the image's GitHub releases (build.yml writes them:
# commits + package changes), repo from config "releases_repo". Public API,
# no token: 60 requests/hour per IP, so cached; a kiosk without internet just
# shows no notes.
RELEASES_TTL = 15 * 60
_releases_cache = {"time": 0, "repo": None, "data": None}
_releases_lock = threading.Lock()


def _github(repo, path):
    req = urllib.request.Request(f"https://api.github.com/repos/{repo}/{path}", headers={
        "Accept": "application/vnd.github+json", "User-Agent": "immutable-kiosk"})
    with urllib.request.urlopen(req, timeout=10) as r:
        return json.loads(r.read())


def release_notes(body):
    """A release body without what only matters on a PC (the ISO install
    steps), commits first: they say what changed, the package tables how."""
    sections, cur = [], ["", []]
    for line in (body or "").replace("\r\n", "\n").split("\n"):
        if line.startswith("## "):
            sections.append(cur)
            cur = [line[3:].strip(), [line]]
        else:
            cur[1].append(line)
    sections.append(cur)
    keep = [s for s in sections if s[0] != "Instalacja" and "\n".join(s[1]).strip()]
    keep.sort(key=lambda s: 0 if s[0] == "Commits" else 1)
    return "\n".join("\n".join(s[1]).strip() + "\n" for s in keep).strip()


def releases():
    """[{tag, sha, date, notes}], newest first; [] when GitHub can't be reached."""
    repo = load_config().get("releases_repo") or DEFAULT_CONFIG["releases_repo"]
    with _releases_lock:
        cached = _releases_cache["data"] if _releases_cache["repo"] == repo else None
        if cached is not None and time.time() - _releases_cache["time"] < RELEASES_TTL:
            return cached
        try:
            rels = _github(repo, "releases?per_page=30")
            tags = {t["name"]: t["commit"]["sha"] for t in _github(repo, "tags?per_page=100")}
        except (OSError, ValueError, KeyError, TypeError) as e:
            print(f"kioskd: releases ({repo}): {e}", flush=True)
            return cached or []
        data = [{"tag": r.get("tag_name", ""), "sha": tags.get(r.get("tag_name", ""), ""),
                 "date": r.get("published_at") or r.get("created_at") or "",
                 "notes": release_notes(r.get("body"))}
                for r in rels if not r.get("draft") and not r.get("prerelease")]
        _releases_cache.update(time=time.time(), repo=repo, data=data)
        return data


def changelog():
    """Releases for the booted version and for what an update/restart brings."""
    st = bootc_status()
    rels = releases()

    def index(sha):
        if not sha:
            return None
        return next((i for i, r in enumerate(rels) if r["sha"].startswith(sha)), None)

    booted = st.get("booted") or {}
    target = st.get("staged") or st.get("update") or None
    b = index(booted.get("sha"))
    t = index(target.get("sha")) if target else None
    news = []
    if target:
        # Newest first: from the target's release down to (not including) the
        # booted one's. Unknown target: everything newer than what runs.
        start = t if t is not None else 0
        end = b if b is not None else len(rels)
        if b is None and booted.get("timestamp"):
            end = next((i for i, r in enumerate(rels) if r["date"] and r["date"] <= booted["timestamp"]), len(rels))
        news = rels[start:end]
    return {
        "repo": load_config().get("releases_repo"),
        "reachable": bool(rels),
        "current": rels[b] if b is not None else None,
        "target": rels[t] if t is not None else (news[0] if news else None),
        "news": news,
    }


# ---------------------------------------------------------------- boot timing

# Set by kiosk-shell (POST /api/boot/hmi) when the HMI page first finished
# loading: seconds since the kernel started (CLOCK_MONOTONIC).
HMI_SHOWN = {"at": None}
BOOT_COUNTER = "/usr/libexec/immutable-kiosk/boot-counter"
BOOT_FALLBACK_NOTE = STATE_DIR / "boot-fallback.json"


def parse_span(s):
    """systemd time span ("1min 2.345s", "801ms", "3.758s") -> seconds."""
    units = {"min": 60, "s": 1, "ms": 1e-3, "us": 1e-6, "µs": 1e-6, "h": 3600}
    return sum(float(v) * units[u] for v, u in re.findall(r"([\d.]+)\s*(min|ms|us|µs|s|h)\b", s))


# PID 1's structured job messages (sd-messages.h).
MSG_STARTING = "7d4958e842da4a758f6c1cdc7b36dcc5"   # "Starting X..." / "Mounting X..."
MSG_STARTED = "39f53479d3a045ac8e11786248231fbf"    # "Started/Finished/Mounted X", "Reached target X"
MSG_FAILED = "be02cf6855d2428ba40df7e9d022f03d"

# Points on the way from kernel to HMI worth showing, in boot order.
BOOT_MILESTONES = {
    "initrd-root-device.target": "initrd: dysk systemowy znaleziony",
    "initrd-root-fs.target": "initrd: system plików zamontowany",
    "initrd.target": "initrd: gotowy do przełączenia",
    "local-fs.target": "Systemy plików zamontowane",
    "sysinit.target": "Inicjalizacja systemu (sysinit)",
    "basic.target": "Usługi podstawowe (basic)",
    "network.target": "NetworkManager uruchomiony",
    "immutable-kiosk-backend.service": "kioskd uruchomiony",
    "immutable-kiosk-cage.service": "Kiosk (cage) uruchomiony",
    "graphical.target": "Start zakończony (graphical)",
}
KERNEL_MILESTONES = [
    (re.compile(r"^Run /init as init process"), "Start initramfs"),
    (re.compile(r"^mmcblk\d+: mmc\d+:"), "eMMC wykryty"),
    (re.compile(r"Initialized i915 "), "GPU gotowe (i915)"),
]
BOOT_CACHE = {}


def boot_journal():
    """Timeline and slowest units of this boot, initrd included, from the
    journal: systemd-analyze blame only sees the real root's manager and is
    dominated by .device units, whose "time" is just when udev got to them."""
    try:
        out = run(["journalctl", "-b", "-o", "json", "--no-pager",
                   "--output-fields=MESSAGE,MESSAGE_ID,UNIT,_SOURCE_MONOTONIC_TIMESTAMP,_TRANSPORT,_SYSTEMD_UNIT",
                   "_PID=1", "+", "_TRANSPORT=kernel", "+", f"_SYSTEMD_UNIT={CAGE_UNIT}"], timeout=30)
    except ApiError as e:
        return {"journal_error": str(e)}
    switch = None
    starting, units, marks, failed = {}, [], [], []
    seen = set()
    for line in out.splitlines():
        try:
            e = json.loads(line)
        except ValueError:
            continue
        msg = e.get("MESSAGE")
        if not isinstance(msg, str):
            continue
        # Kernel lines arrive late (journald reads the ring buffer when it
        # starts): their own timestamp is the one that counts.
        ts = e.get("_SOURCE_MONOTONIC_TIMESTAMP") or e.get("__MONOTONIC_TIMESTAMP")
        try:
            t = int(ts) / 1e6
        except (TypeError, ValueError):
            continue
        if e.get("_TRANSPORT") == "kernel":
            for rx, label in KERNEL_MILESTONES:
                if label not in seen and rx.search(msg):
                    seen.add(label)
                    marks.append({"t": t, "label": label})
            continue
        # kiosk-shell's own start-up points ("kiosk-shell: milestone: <label>"
        # on its stderr, in cage's unit) -- the first of each, this boot.
        if e.get("_SYSTEMD_UNIT") == CAGE_UNIT and e.get("UNIT") is None:
            label = msg.partition("kiosk-shell: milestone: ")[2].strip()
            if label and label not in seen:
                seen.add(label)
                marks.append({"t": t, "label": label})
            continue
        if msg.startswith("Switching root") and switch is None:
            switch = t
            marks.append({"t": t, "label": "Przełączenie na system (switch-root)"})
            continue
        unit, mid = e.get("UNIT") or "", e.get("MESSAGE_ID")
        if not unit:
            continue
        if mid == MSG_STARTING:
            starting[unit] = t
        elif mid == MSG_STARTED:
            t0 = starting.pop(unit, None)
            if t0 is not None and not unit.endswith((".device", ".target", ".slice", ".scope")):
                units.append({"unit": unit, "start": t0, "dur": t - t0})
            # The initrd reaches local-fs/sysinit/basic too: before
            # switch-root only initrd-* count, after it only the rest.
            if (unit in BOOT_MILESTONES and unit not in seen
                    and unit.startswith("initrd") == (switch is None)):
                seen.add(unit)
                marks.append({"t": t, "label": BOOT_MILESTONES[unit]})
        elif mid == MSG_FAILED:
            failed.append(unit)
    for u in units:
        u["phase"] = "initrd" if switch is not None and u["start"] < switch else "system"
    units.sort(key=lambda u: -u["dur"])
    marks.sort(key=lambda m: m["t"])
    return {"switch_root": switch, "milestones": marks, "slowest": units[:15],
            "failed": sorted(set(failed))}


# What PID 1 itself does before it starts any unit -- in the initrd and again
# after switch-root -- as systemd records it (manager properties, CLOCK_MONOTONIC
# in µs). On the tablet 6.5 s passed between switch-root and the first unit.
MANAGER_PHASES = [
    ("InitRDSecurity", "initrd", "PID 1: polityka SELinux"),
    ("InitRDGenerators", "initrd", "PID 1: generatory"),
    ("InitRDUnitsLoad", "initrd", "PID 1: wczytanie jednostek"),
    ("Security", "system", "PID 1: polityka SELinux"),
    ("Generators", "system", "PID 1: generatory"),
    ("UnitsLoad", "system", "PID 1: wczytanie jednostek"),
]


def manager_phases():
    props = [f"{p}{edge}TimestampMonotonic" for p, _, _ in MANAGER_PHASES for edge in ("Start", "Finish")]
    try:
        out = run(["systemctl", "show", *[a for p in props for a in ("-p", p)]], timeout=10)
    except ApiError:
        return []
    v = dict(line.split("=", 1) for line in out.splitlines() if "=" in line)
    phases = []
    for name, phase, label in MANAGER_PHASES:
        try:
            start = int(v.get(f"{name}StartTimestampMonotonic", 0))
            finish = int(v.get(f"{name}FinishTimestampMonotonic", 0))
        except ValueError:
            continue
        if start and finish >= start:
            phases.append({"unit": label, "start": start / 1e6, "dur": (finish - start) / 1e6, "phase": phase})
    return phases


CHAIN_LINE = re.compile(r"^[\s│└├─]*([^\s@]+)(?:\s+@(.+?))?(?:\s+\+(.+))?\s*$")


def critical_chain(unit):
    """What `unit` waited for, as systemd sees it -- each step [{unit, at,
    took}] with `at` in seconds since the kernel started (systemd-analyze
    counts from userspace start). Explains a gap where nothing runs long."""
    try:
        out = run(["systemd-analyze", "critical-chain", "--no-pager", unit], timeout=20)
        base = int(run(["systemctl", "show", "-p", "UserspaceTimestampMonotonic", "--value"],
                       timeout=10).strip() or 0) / 1e6
    except (ApiError, ValueError):
        return []
    chain = []
    for line in out.splitlines():
        if not line.strip() or line.startswith("The time"):
            continue
        m = CHAIN_LINE.match(line)
        if not m or "." not in m.group(1):
            continue
        name, at, took = m.groups()
        chain.append({"unit": name, "at": base + parse_span(at) if at else None,
                      "took": parse_span(took) if took else None})
    return chain


def boot_timing():
    if "done" in BOOT_CACHE:
        out = dict(BOOT_CACHE["done"])
    else:
        out = {}
        try:
            line = run(["systemd-analyze", "time", "--no-pager"], timeout=20).splitlines()[0]
            # "Startup finished in 3.2s (firmware) + 1.1s (loader) + ... = 25.4s"
            out["phases"] = [{"name": n, "time": t, "sec": parse_span(t)}
                             for t, n in re.findall(r"([\d.]+(?:min|ms|s|us)(?: [\d.]+(?:ms|s|us))*) \((\w+)\)", line)]
            m = re.search(r"= (.+)$", line)
            out["total"] = m.group(1).strip() if m else ""
        except (ApiError, IndexError) as e:
            out["error"] = str(e)  # "Bootup is not yet finished" until graphical.target
        # Timeline and slowest units come from the journal (initrd included);
        # systemd-analyze blame/critical-chain added nothing Settings shows.
        out.update(boot_journal())
        # PID 1's own phases ranked among the units: what fills the gap
        # between switch-root and the first unit that starts.
        out["slowest"] = sorted(out.get("slowest", []) + manager_phases(), key=lambda u: -u["dur"])[:15]
        # The two waits that matter: the real root's file systems (udev,
        # /boot, everything before sysinit hangs on them) and the kiosk.
        out["chains"] = [
            {"title": "Do zamontowania systemów plików (local-fs)", "steps": critical_chain("local-fs.target")},
            {"title": "Do startu kiosku (cage)", "steps": critical_chain(CAGE_UNIT)},
        ]
        # Nothing about this boot changes once it has finished.
        if out.get("total") and "journal_error" not in out:
            BOOT_CACHE["done"] = dict(out)
    out["hmi_shown"] = HMI_SHOWN["at"]
    out["uptime"] = time.monotonic()
    return out


def job_switch(image):
    def target(job):
        run_bootc_with_progress(job, ["switch", image])
        job.fraction = 1
        job.stage = "Gotowe"
        job.detail = f"Po restarcie system uruchomi obraz {image}"
        job.result = bootc_status()
    return target


IMAGE_REF = re.compile(r"^[a-z0-9]+([._-][a-z0-9]+)*(:[0-9]+)?(/[a-z0-9]+([._-][a-z0-9]+)*)+(:[A-Za-z0-9_.-]{1,128}|@sha256:[0-9a-f]{64})?$")


# ---------------------------------------------------------------- installer

def power_state():
    """Charger plugged in (True/False/None = can't tell), battery %, battery status.

    Tablets charge over USB: their charger shows up as a "USB*" supply, or
    not at all -- then the battery's own status (Charging/Discharging) is
    the only hint, so it counts too. Only "Mains" was checked before, and
    the 408 showed "—" for the charger.
    """
    ac, battery, status = None, None, None
    for ps in Path("/sys/class/power_supply").glob("*"):
        try:
            kind = (ps / "type").read_text().strip()
            if kind == "Battery":
                battery = int((ps / "capacity").read_text().strip())
                status = (ps / "status").read_text().strip()
            elif kind == "Mains" or kind.startswith("USB") or kind == "Wireless":
                online = (ps / "online").read_text().strip() == "1"
                ac = online or bool(ac)
        except (OSError, ValueError):
            continue
    if status in ("Charging", "Full", "Not charging"):
        ac = True  # some chargers never report online, the battery does
    elif ac is None and status == "Discharging":
        ac = False
    return {"ac_online": ac, "battery": battery, "battery_status": status}


def boot_medium():
    """Kernel name of the disk the live ISO runs from (never a valid target)."""
    try:
        src = run(["findmnt", "-no", "SOURCE", str(LIVE_MOUNT)], check=False).strip()
    except ApiError:
        return None
    if not src.startswith("/dev/"):
        return None
    parent = run(["lsblk", "-no", "PKNAME", src], check=False).strip()
    return parent or Path(src).name


def payload_info():
    raw = PAYLOAD_DIR / "disk.raw.zst"
    if not raw.exists():
        return None
    meta = {}
    try:
        meta = json.loads((PAYLOAD_DIR / "payload.json").read_text())
    except (OSError, ValueError):
        pass
    return {"path": str(raw), "compressed": raw.stat().st_size, **meta}


def list_disks():
    data = json.loads(run(["lsblk", "-J", "-b", "-d", "-o",
                           "NAME,PATH,SIZE,MODEL,TYPE,TRAN,RM,HOTPLUG,RO"]))
    boot = boot_medium()
    disks = []
    for d in data.get("blockdevices", []):
        name = d.get("name", "")
        if d.get("type") != "disk" or d.get("ro") in (True, "1", 1):
            continue
        if re.match(r"^(loop|zram|sr|ram)\d*", name) or re.search(r"(boot\d+|rpmb)$", name):
            continue
        internal = name.startswith(("mmcblk", "nvme")) or not (d.get("rm") or d.get("hotplug"))
        disks.append({
            "name": name,
            "path": d.get("path") or f"/dev/{name}",
            "size": int(d.get("size") or 0),
            "model": (d.get("model") or "").strip() or ("eMMC" if name.startswith("mmcblk") else ""),
            "transport": d.get("tran") or ("mmc" if name.startswith("mmcblk") else ""),
            "internal": bool(internal),
            "is_boot_medium": name == boot,
        })
    # Internal eMMC first: that's the one meant.
    disks.sort(key=lambda d: (d["is_boot_medium"], not d["name"].startswith("mmcblk"), not d["internal"]))
    return disks


def installer_state():
    return {"payload": payload_info(), "disks": list_disks(), "power": power_state()}


CHUNK = 4 * 1024 * 1024
SYNC_EVERY = 64 * 1024 * 1024
LOG_EVERY = 512 * 1024 * 1024  # a progress line in "Szczegóły" every 512 MiB


def _mmss(seconds):
    return f"{int(seconds // 60)} min {int(seconds % 60)} s"


def job_install(disk_path):
    def target(job):
        payload = payload_info()
        if not payload:
            raise RuntimeError("Brak obrazu systemu na nośniku instalacyjnym")
        size = int(payload.get("size") or 0)
        expected = payload.get("sha256") or ""
        job.add_log(f"Obraz: {payload.get('image', '?')} ({payload.get('version', '?')})")
        job.add_log(f"Rozmiar: {size / 1e9:.2f} GB, spakowany {payload['compressed'] / 1e9:.2f} GB")
        job.add_log(f"Dysk docelowy: {disk_path}")

        # Anything mounted from the target (an older install, auto-mounted) goes first.
        job.stage = "Przygotowanie dysku"
        job.add_log(job.stage)
        mounted = run(["lsblk", "-nrpo", "NAME,MOUNTPOINT", disk_path], check=False)
        for line in mounted.splitlines():
            parts = line.split(maxsplit=1)
            if len(parts) == 2 and parts[1]:
                job.add_log(f"  odmontowanie {parts[0]} ({parts[1]})")
                run(["umount", "-l", parts[0]], check=False)
        # Old partition tables, the backup GPT at the end of the disk included.
        for line in run(["wipefs", "-a", disk_path], check=False).splitlines():
            job.add_log(f"  {line}")

        job.stage = "Kopiowanie systemu"
        job.add_log(job.stage)
        next_log = LOG_EVERY
        digest = hashlib.sha256()
        written = 0
        t0 = time.time()
        dec = subprocess.Popen(["zstd", "-dc", payload["path"]], stdout=subprocess.PIPE)
        # O_EXCL on a block device: refuses if anything still has it mounted.
        fd = os.open(disk_path, os.O_WRONLY | os.O_EXCL)
        try:
            since_sync = 0
            while True:
                buf = dec.stdout.read(CHUNK)
                if not buf:
                    break
                digest.update(buf)
                view = memoryview(buf)
                while view:
                    n = os.write(fd, view)
                    view = view[n:]
                written += len(buf)
                since_sync += len(buf)
                # Sync in steps, so the bar shows what actually reached the
                # eMMC instead of racing ahead into the page cache.
                if since_sync >= SYNC_EVERY:
                    os.fdatasync(fd)
                    since_sync = 0
                    _progress(job, written, size, t0)
                    if written >= next_log:
                        job.add_log(f"  {job.detail}")
                        next_log += LOG_EVERY
            os.fdatasync(fd)
            _progress(job, written, size, t0)
            job.add_log(f"  zapisano {written / 1e9:.2f} GB w {_mmss(time.time() - t0)}")
        finally:
            os.close(fd)
        if dec.wait() != 0:
            raise RuntimeError("Obraz systemu na pendrive jest uszkodzony (błąd dekompresji)")
        if size and written != size:
            raise RuntimeError(f"Zapisano {written} B zamiast {size} B")
        if expected and digest.hexdigest() != expected:
            raise RuntimeError("Suma kontrolna obrazu się nie zgadza -- nośnik instalacyjny jest uszkodzony")

        job.add_log(f"  sha256 {digest.hexdigest()[:16]}… zgodna z obrazem" if expected
                    else f"  sha256 {digest.hexdigest()[:16]}…")

        job.stage = "Weryfikacja zapisu"
        job.add_log(job.stage)
        job.fraction = 0
        run(["blockdev", "--flushbufs", disk_path], check=False)
        check = hashlib.sha256()
        read = 0
        t0 = time.time()
        next_log = LOG_EVERY
        fd = os.open(disk_path, os.O_RDONLY)
        try:
            os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_DONTNEED)
            while read < written:
                buf = os.read(fd, min(CHUNK, written - read))
                if not buf:
                    break
                check.update(buf)
                read += len(buf)
                if read % (64 * CHUNK) < CHUNK:
                    _progress(job, read, written, t0)
                if read >= next_log:
                    job.add_log(f"  {job.detail}")
                    next_log += LOG_EVERY
        finally:
            os.close(fd)
        if check.hexdigest() != digest.hexdigest():
            raise RuntimeError("Weryfikacja nieudana: dane na dysku różnią się od obrazu. Spróbuj ponownie.")
        job.add_log(f"  odczytano {read / 1e9:.2f} GB w {_mmss(time.time() - t0)}, dane zgodne")

        job.stage = "Kończenie"
        job.add_log(job.stage)
        # The image is smaller than the eMMC: move the backup GPT to the real
        # end of the disk. The root partition itself grows on first boot.
        for cmd in (["sgdisk", "-e", disk_path], ["blockdev", "--rereadpt", disk_path]):
            p = subprocess.run(cmd, capture_output=True, text=True)
            for line in (p.stdout + p.stderr).splitlines():
                job.add_log(f"  {line}")
        subprocess.run(["sync"])
        job.add_log("Gotowe. Wyjmij pendrive i uruchom ponownie.")
        job.fraction = 1
        job.detail = "System zainstalowany. Wyjmij pendrive i uruchom ponownie."
    return target


def _progress(job, done, total, t0):
    elapsed = max(time.time() - t0, 0.001)
    speed = done / elapsed
    job.fraction = done / total if total else None
    eta = ""
    if total and speed > 0:
        left = (total - done) / speed
        eta = f" · zostało ok. {int(left // 60)} min {int(left % 60)} s"
    job.detail = f"{done / 1e9:.2f} / {total / 1e9:.2f} GB · {speed / 1e6:.0f} MB/s{eta}" if total \
        else f"{done / 1e9:.2f} GB · {speed / 1e6:.0f} MB/s"


# ---------------------------------------------------------------- HTTP

class Handler(BaseHTTPRequestHandler):
    server_version = "kioskd"

    def log_message(self, fmt, *args):  # journal stays readable: errors only
        pass

    # -- plumbing
    def send_json(self, obj, status=HTTPStatus.OK):
        body = json.dumps(obj).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def body(self):
        n = int(self.headers.get("Content-Length") or 0)
        if n > 64 * 1024:
            raise ApiError("Za duże zapytanie")
        if not n:
            return {}
        try:
            data = json.loads(self.rfile.read(n))
        except ValueError:
            raise ApiError("Niepoprawny JSON")
        if not isinstance(data, dict):
            raise ApiError("Oczekiwano obiektu JSON")
        return data

    def guard(self):
        if self.headers.get("Host") not in ALLOWED_HOSTS:
            raise ApiError("forbidden", HTTPStatus.FORBIDDEN)

    def handle_api(self, method):
        self.guard()
        if self.headers.get("X-Kiosk") != "1":
            raise ApiError("forbidden", HTTPStatus.FORBIDDEN)
        url = urlsplit(self.path)
        path = url.path
        query = parse_qs(url.query)
        route = ROUTES.get((method, path))
        if not route:
            raise ApiError("not found", HTTPStatus.NOT_FOUND)
        body = self.body() if method == "POST" else {}
        return route(body, query)

    def dispatch(self, method):
        try:
            if self.path.startswith("/api/"):
                result = self.handle_api(method)
                self.send_json(result if result is not None else {"ok": True})
            elif method == "GET":
                self.guard()
                self.serve_static()
            else:
                raise ApiError("not found", HTTPStatus.NOT_FOUND)
        except ApiError as e:
            self.send_json({"error": str(e)}, e.status)
        except Exception as e:  # noqa: BLE001
            self.send_json({"error": f"Błąd wewnętrzny: {e}"}, HTTPStatus.INTERNAL_SERVER_ERROR)

    def do_GET(self):
        self.dispatch("GET")

    def do_POST(self):
        self.dispatch("POST")

    def serve_static(self):
        rel = urlsplit(self.path).path.lstrip("/") or "index.html"
        f = (WEB_ROOT / rel).resolve()
        if WEB_ROOT.resolve() not in f.parents or not f.is_file():
            raise ApiError("not found", HTTPStatus.NOT_FOUND)
        data = f.read_bytes()
        ctype = mimetypes.guess_type(f.name)[0] or "application/octet-stream"
        if ctype.startswith("text/") or ctype in ("application/javascript",):
            ctype += "; charset=utf-8"
        self.send_response(HTTPStatus.OK)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-cache")
        self.send_header("X-Frame-Options", "DENY")
        self.end_headers()
        self.wfile.write(data)


# ---------------------------------------------------------------- routes

def current_timezone():
    try:
        return os.readlink("/etc/localtime").split("zoneinfo/", 1)[1]
    except (OSError, IndexError):
        return "UTC"


def r_info(body, q):
    time.tzset()  # glibc re-reads /etc/localtime if the time zone was changed
    return {
        "mode": mode(),
        "hostname": socket.gethostname(),
        # What the hardware says about itself (DMI).
        "device": {"product": read_dmi("product_name"), "vendor": read_dmi("sys_vendor")},
        "power": power_state(),
        "net": net_brief(),
        "time": time.strftime("%Y-%m-%d %H:%M:%S"),
        "timezone": current_timezone(),
    }


def r_timezones(body, q):
    zones = run(["timedatectl", "list-timezones", "--no-pager"], timeout=20).split()
    return {"current": current_timezone(), "zones": zones}


def r_timezone_set(body, q):
    tz = str(body.get("timezone", "")).strip()
    if tz not in run(["timedatectl", "list-timezones", "--no-pager"], timeout=20).split():
        raise ApiError("Nieznana strefa czasowa")
    run(["timedatectl", "set-timezone", tz], timeout=20)
    time.tzset()
    return {"timezone": current_timezone(), "time": time.strftime("%Y-%m-%d %H:%M:%S")}


def r_config_get(body, q):
    return effective_config()


def r_config_set(body, q):
    return save_config(body)


def r_hmi_test(body, q):
    """Can the HMI server's port be reached at all? (TCP connect, 3 s.)"""
    host = str(body.get("host", "")).strip().strip("[]")
    try:
        port = int(body.get("port"))
    except (TypeError, ValueError):
        raise ApiError("Port musi być liczbą")
    if not host:
        raise ApiError("Podaj adres HMI")
    t0 = time.time()
    try:
        with socket.create_connection((host, port), timeout=3):
            pass
    except OSError as e:
        return {"ok": False, "message": f"Brak połączenia z {host}:{port} ({e.strerror or e})"}
    return {"ok": True, "message": f"Port {port} na {host} odpowiada ({(time.time() - t0) * 1000:.0f} ms)"}


def r_wifi(body, q):
    return wifi_state(rescan=q.get("rescan", ["0"])[0] == "1")


def r_wifi_connect(body, q):
    wifi_connect(str(body.get("ssid", "")), str(body.get("password", "")), bool(body.get("hidden")))
    return wifi_state(rescan=False)


def r_wifi_forget(body, q):
    uuid = str(body.get("uuid", ""))
    if not re.fullmatch(r"[0-9a-fA-F-]{36}", uuid):
        raise ApiError("Niepoprawny profil")
    run(["nmcli", "con", "delete", uuid])
    return wifi_state(rescan=False)


def r_wifi_disconnect(body, q):
    """Drop the current Wi-Fi connection. NetworkManager doesn't reconnect
    the device by itself after a manual disconnect -- until a network is
    picked again (or the next boot)."""
    dev = wifi_device()
    if dev and dev["state"].startswith(("connected", "connecting")):
        run(["nmcli", "dev", "disconnect", dev["device"]], timeout=30)
    return wifi_state(rescan=False)


def r_wifi_radio(body, q):
    run(["nmcli", "radio", "wifi", "on" if body.get("enabled") else "off"])
    return wifi_state(rescan=False)


def r_network(body, q):
    return network_state()


def r_network_set(body, q):
    network_set(body)
    return {"ok": True}


HOSTNAME = re.compile(r"^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$")


def r_hostname_set(body, q):
    """Static hostname (hostnamectl). One DNS label: what DHCP and routers show."""
    name = str(body.get("hostname", "")).strip().lower()
    if not HOSTNAME.fullmatch(name):
        raise ApiError("Nazwa: 1-63 znaki, małe litery, cyfry i myślniki (nie na początku ani końcu)")
    run(["hostnamectl", "set-hostname", name])
    return {"hostname": socket.gethostname()}


# ---------------------------------------------------------------- touch rotation
#
# The screen is rotated by the compositor (wlr-randr --transform), but cage
# only maps a touchscreen onto an output when the device names one, which
# these tablets' touchscreens don't. Without that, touch keeps the panel's
# native axes: a left-right swipe scrolls up-down and taps land in the wrong
# place. The fix lives in libinput (the input driver layer), not the page: a
# udev rule sets LIBINPUT_CALIBRATION_MATRIX on every touchscreen to match
# the output transform.
#
# The matrix maps normalized touch coordinates (0..1, panel-native) to the
# rotated screen's: x' = a*x + b*y + c, y' = d*x + e*y + f.
TOUCH_MATRICES = {
    "normal": "1 0 0 0 1 0",
    "90": "0 -1 1 1 0 0",
    "180": "-1 0 1 0 -1 1",
    "270": "0 1 0 -1 0 1",
}
TOUCH_RULE = Path("/etc/udev/rules.d/99-immutable-kiosk-touch.rules")
CAGE_UNIT = "immutable-kiosk-cage.service"


def touchscreens_present():
    for ev in Path("/sys/class/input").glob("event*"):
        props = subprocess.run(["udevadm", "info", "-q", "property", str(ev)],
                               capture_output=True, text=True, timeout=5).stdout
        if "ID_INPUT_TOUCHSCREEN=1" in props.splitlines():
            return True
    return False


def r_touch_set(body, q):
    """kiosk-shell reports the transform it gave the panel; make touch follow it.

    libinput reads the calibration matrix only when a device is added, i.e.
    when cage starts -- so if the rule changed, cage is restarted once. The
    rule lives in /etc and udev applies it at boot, before cage starts: after
    that first time, no restart.
    """
    transform = str(body.get("transform", ""))
    matrix = TOUCH_MATRICES.get(transform)
    if not matrix:
        raise ApiError("Nieznana orientacja")
    rule = (
        "# Written by kioskd: touch follows the screen rotation "
        f"(wlr-randr transform {transform}).\n"
        'ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", '
        f'ENV{{ID_INPUT_TOUCHSCREEN}}=="1", ENV{{LIBINPUT_CALIBRATION_MATRIX}}="{matrix}"\n'
    )
    try:
        current = TOUCH_RULE.read_text()
    except OSError:
        current = None
    if current == rule:
        return {"changed": False, "restart": False}
    TOUCH_RULE.parent.mkdir(parents=True, exist_ok=True)
    tmp = TOUCH_RULE.with_suffix(".tmp")
    tmp.write_text(rule)
    tmp.replace(TOUCH_RULE)
    run(["udevadm", "control", "--reload"], timeout=10)
    run(["udevadm", "trigger", "--action=change", "--subsystem-match=input"], timeout=10)
    run(["udevadm", "settle", "--timeout=5"], check=False, timeout=10)
    restart = touchscreens_present()
    print(f"kioskd: touch matrix for transform {transform}: {matrix}"
          f"{' -- restarting cage' if restart else ' (no touchscreen)'}", flush=True)
    if restart:
        # After the reply: the request comes from inside cage.
        threading.Timer(1.0, subprocess.run, args=(["systemctl", "restart", CAGE_UNIT],)).start()
    return {"changed": True, "restart": restart}


def r_system(body, q):
    # While bootc upgrade/switch runs it holds the sysroot lock and `bootc
    # status` waits for it -- 30 s, then "Aktualizacje są niedostępne" in
    # the middle of a download. Answer from the last good status instead.
    job = CURRENT_JOB
    cached = LAST_STATUS["value"]
    if job and job.state == "running" and job.kind != "install" and cached:
        st = dict(cached, checked=LAST_CHECK, busy=True)
    else:
        st = bootc_status()
        if not st.get("available") and cached:
            st = dict(cached, checked=LAST_CHECK, stale=st.get("error"))
    # Left by boot-counter when a new version never came up and the previous
    # one was booted (and made the default again) automatically.
    try:
        st["fallback"] = json.loads(BOOT_FALLBACK_NOTE.read_text())
    except (OSError, ValueError):
        st["fallback"] = None
    # Fedora release of what runs: names old builds' "latest.<date>-<sha>"
    # labels "v45.<date>-<sha>" in Settings.
    try:
        st["fedora"] = next((ln.split("=", 1)[1].strip().strip('"') for ln in
                             Path("/usr/lib/os-release").read_text().splitlines()
                             if ln.startswith("VERSION_ID=")), None)
    except OSError:
        st["fedora"] = None
    return st


