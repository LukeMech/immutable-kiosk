# ---------------------------------------------------------------- installer

def power_state():
    """{ac_online (None = unknown), battery %, battery_status}.

    USB-charged tablets report the charger as "USB*" or not at all, so the
    battery's Charging/Discharging status counts too.
    """
    ac, battery, status = None, None, None
    for ps in Path("/sys/class/power_supply").glob("*"):
        try:
            kind = (ps / "type").read_text().strip()
            if kind == "Battery":
                battery = int((ps / "capacity").read_text().strip())
                status = (ps / "status").read_text().strip()
            elif kind == "Mains" or kind.startswith("USB") or kind == "Wireless":
                online = (ps / "online").read_text().strip() == "1"
                ac = online or bool(ac)
        except (OSError, ValueError):
            continue
    if status in ("Charging", "Full", "Not charging"):
        ac = True  # some chargers never report online, the battery does
    elif ac is None and status == "Discharging":
        ac = False
    return {"ac_online": ac, "battery": battery, "battery_status": status}


def boot_medium():
    """Kernel name of the disk the live ISO runs from (never a valid target)."""
    try:
        src = run(["findmnt", "-no", "SOURCE", str(LIVE_MOUNT)], check=False).strip()
    except ApiError:
        return None
    if not src.startswith("/dev/"):
        return None
    parent = run(["lsblk", "-no", "PKNAME", src], check=False).strip()
    return parent or Path(src).name


def payload_info():
    raw = PAYLOAD_DIR / "disk.raw.zst"
    if not raw.exists():
        return None
    meta = {}
    try:
        meta = json.loads((PAYLOAD_DIR / "payload.json").read_text())
    except (OSError, ValueError):
        pass
    return {"path": str(raw), "compressed": raw.stat().st_size, **meta}


def list_disks():
    data = json.loads(run(["lsblk", "-J", "-b", "-d", "-o",
                           "NAME,PATH,SIZE,MODEL,TYPE,TRAN,RM,HOTPLUG,RO"]))
    boot = boot_medium()
    disks = []
    for d in data.get("blockdevices", []):
        name = d.get("name", "")
        if d.get("type") != "disk" or d.get("ro") in (True, "1", 1):
            continue
        if re.match(r"^(loop|zram|sr|ram)\d*", name) or re.search(r"(boot\d+|rpmb)$", name):
            continue
        internal = name.startswith(("mmcblk", "nvme")) or not (d.get("rm") or d.get("hotplug"))
        disks.append({
            "name": name,
            "path": d.get("path") or f"/dev/{name}",
            "size": int(d.get("size") or 0),
            "model": (d.get("model") or "").strip() or ("eMMC" if name.startswith("mmcblk") else ""),
            "transport": d.get("tran") or ("mmc" if name.startswith("mmcblk") else ""),
            "internal": bool(internal),
            "is_boot_medium": name == boot,
        })
    disks.sort(key=lambda d: (d["is_boot_medium"], not d["name"].startswith("mmcblk"), not d["internal"]))
    return disks


def installer_state():
    return {"payload": payload_info(), "disks": list_disks(), "power": power_state()}


CHUNK = 4 * 1024 * 1024
SYNC_EVERY = 64 * 1024 * 1024
LOG_EVERY = 512 * 1024 * 1024  # a progress line in "Details" every 512 MiB


def _mmss(seconds):
    return f"{int(seconds // 60)} min {int(seconds % 60)} s"


def job_install(disk_path):
    def target(job):
        payload = payload_info()
        if not payload:
            raise RuntimeError("No system image on the installation drive")
        size = int(payload.get("size") or 0)
        expected = payload.get("sha256") or ""
        job.add_log(f"Image: {payload.get('image', '?')} ({payload.get('version', '?')})")
        job.add_log(f"Size: {size / 1e9:.2f} GB, compressed {payload['compressed'] / 1e9:.2f} GB")
        job.add_log(f"Target disk: {disk_path}")

        # Unmount anything on the target.
        job.stage = "Preparing the disk"
        job.add_log(job.stage)
        mounted = run(["lsblk", "-nrpo", "NAME,MOUNTPOINT", disk_path], check=False)
        for line in mounted.splitlines():
            parts = line.split(maxsplit=1)
            if len(parts) == 2 and parts[1]:
                job.add_log(f"  unmounting {parts[0]} ({parts[1]})")
                run(["umount", "-l", parts[0]], check=False)
        # Wipe old signatures, backup GPT included.
        for line in run(["wipefs", "-a", disk_path], check=False).splitlines():
            job.add_log(f"  {line}")

        job.stage = "Copying the system"
        job.add_log(job.stage)
        next_log = LOG_EVERY
        digest = hashlib.sha256()
        written = 0
        t0 = time.time()
        dec = subprocess.Popen(["zstd", "-dc", payload["path"]], stdout=subprocess.PIPE)
        # O_EXCL on a block device: refuses if anything still has it mounted.
        fd = os.open(disk_path, os.O_WRONLY | os.O_EXCL)
        try:
            since_sync = 0
            while True:
                buf = dec.stdout.read(CHUNK)
                if not buf:
                    break
                digest.update(buf)
                view = memoryview(buf)
                while view:
                    n = os.write(fd, view)
                    view = view[n:]
                written += len(buf)
                since_sync += len(buf)
                # Periodic sync: progress tracks the disk, not the page cache.
                if since_sync >= SYNC_EVERY:
                    os.fdatasync(fd)
                    since_sync = 0
                    _progress(job, written, size, t0)
                    if written >= next_log:
                        job.add_log(f"  {job.detail}")
                        next_log += LOG_EVERY
            os.fdatasync(fd)
            _progress(job, written, size, t0)
            job.add_log(f"  wrote {written / 1e9:.2f} GB in {_mmss(time.time() - t0)}")
        finally:
            os.close(fd)
        if dec.wait() != 0:
            raise RuntimeError("The system image on the USB drive is damaged (decompression error)")
        if size and written != size:
            raise RuntimeError(f"Wrote {written} B instead of {size} B")
        if expected and digest.hexdigest() != expected:
            raise RuntimeError("Image checksum mismatch -- the installation drive is damaged")

        job.add_log(f"  sha256 {digest.hexdigest()[:16]}… matches the image" if expected
                    else f"  sha256 {digest.hexdigest()[:16]}…")

        job.stage = "Verifying the write"
        job.add_log(job.stage)
        job.fraction = 0
        run(["blockdev", "--flushbufs", disk_path], check=False)
        check = hashlib.sha256()
        read = 0
        t0 = time.time()
        next_log = LOG_EVERY
        fd = os.open(disk_path, os.O_RDONLY)
        try:
            os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_DONTNEED)
            while read < written:
                buf = os.read(fd, min(CHUNK, written - read))
                if not buf:
                    break
                check.update(buf)
                read += len(buf)
                if read % (64 * CHUNK) < CHUNK:
                    _progress(job, read, written, t0)
                if read >= next_log:
                    job.add_log(f"  {job.detail}")
                    next_log += LOG_EVERY
        finally:
            os.close(fd)
        if check.hexdigest() != digest.hexdigest():
            raise RuntimeError("Verification failed: the data on the disk differs from the image. Try again.")
        job.add_log(f"  read {read / 1e9:.2f} GB in {_mmss(time.time() - t0)}, data matches")

        job.stage = "Finishing"
        job.add_log(job.stage)
        # Move the backup GPT to the disk's end; root grows on first boot.
        for cmd in (["sgdisk", "-e", disk_path], ["blockdev", "--rereadpt", disk_path]):
            p = subprocess.run(cmd, capture_output=True, text=True)
            for line in (p.stdout + p.stderr).splitlines():
                job.add_log(f"  {line}")
        subprocess.run(["sync"])
        job.add_log("Done. Remove the USB drive and restart.")
        job.fraction = 1
        job.detail = "System installed. Remove the USB drive and restart."
    return target


def _progress(job, done, total, t0):
    elapsed = max(time.time() - t0, 0.001)
    speed = done / elapsed
    job.fraction = done / total if total else None
    eta = ""
    if total and speed > 0:
        left = (total - done) / speed
        eta = f" · about {int(left // 60)} min {int(left % 60)} s left"
    job.detail = f"{done / 1e9:.2f} / {total / 1e9:.2f} GB · {speed / 1e6:.0f} MB/s{eta}" if total \
        else f"{done / 1e9:.2f} GB · {speed / 1e6:.0f} MB/s"


# ---------------------------------------------------------------- HTTP

class Handler(BaseHTTPRequestHandler):
    server_version = "kioskd"

    def log_message(self, fmt, *args):  # journal stays readable: errors only
        pass

    # -- plumbing
    def send_json(self, obj, status=HTTPStatus.OK):
        body = json.dumps(obj).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def body(self):
        n = int(self.headers.get("Content-Length") or 0)
        if n > 64 * 1024:
            raise ApiError("Request too large")
        if not n:
            return {}
        try:
            data = json.loads(self.rfile.read(n))
        except ValueError:
            raise ApiError("Invalid JSON")
        if not isinstance(data, dict):
            raise ApiError("Expected a JSON object")
        return data

    def guard(self):
        if self.headers.get("Host") not in ALLOWED_HOSTS:
            raise ApiError("forbidden", HTTPStatus.FORBIDDEN)

    def handle_api(self, method):
        self.guard()
        if self.headers.get("X-Kiosk") != "1":
            raise ApiError("forbidden", HTTPStatus.FORBIDDEN)
        url = urlsplit(self.path)
        path = url.path
        query = parse_qs(url.query)
        route = ROUTES.get((method, path))
        if not route:
            raise ApiError("not found", HTTPStatus.NOT_FOUND)
        body = self.body() if method == "POST" else {}
        return route(body, query)

    def serve_events(self):
        """SSE: "change" events with topic lists, else a ping every 25 s
        (a gone client surfaces as a write error)."""
        self.send_response(HTTPStatus.OK)
        self.send_header("Content-Type", "text/event-stream; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        seq = EVENTS.seq
        self.wfile.write(b"retry: 3000\n\n")
        self.wfile.flush()
        try:
            while True:
                seq, topics = EVENTS.wait(seq, 25)
                chunk = (f"event: change\ndata: {json.dumps(topics)}\n\n" if topics else ": ping\n\n")
                self.wfile.write(chunk.encode())
                self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError, OSError):
            return

    def dispatch(self, method):
        try:
            # EventSource can't send X-Kiosk; only topic names go out, Host is checked.
            if method == "GET" and urlsplit(self.path).path == "/api/events":
                self.guard()
                return self.serve_events()
            if self.path.startswith("/api/"):
                result = self.handle_api(method)
                self.send_json(result if result is not None else {"ok": True})
            elif method == "GET":
                self.guard()
                self.serve_static()
            else:
                raise ApiError("not found", HTTPStatus.NOT_FOUND)
        except ApiError as e:
            self.send_json({"error": str(e)}, e.status)
        except Exception as e:  # noqa: BLE001
            self.send_json({"error": f"Internal error: {e}"}, HTTPStatus.INTERNAL_SERVER_ERROR)

    def do_GET(self):
        self.dispatch("GET")

    def do_POST(self):
        self.dispatch("POST")

    def serve_static(self):
        rel = urlsplit(self.path).path.lstrip("/") or "index.html"
        f = (WEB_ROOT / rel).resolve()
        if WEB_ROOT.resolve() not in f.parents or not f.is_file():
            raise ApiError("not found", HTTPStatus.NOT_FOUND)
        data = f.read_bytes()
        ctype = mimetypes.guess_type(f.name)[0] or "application/octet-stream"
        if ctype.startswith("text/") or ctype in ("application/javascript",):
            ctype += "; charset=utf-8"
        self.send_response(HTTPStatus.OK)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-cache")
        self.send_header("X-Frame-Options", "DENY")
        self.end_headers()
        self.wfile.write(data)


