PAYLOAD_DIR = Path("/usr/share/immutable-kiosk/payload")
LIVE_MOUNT = Path("/run/initramfs/live")

ROTATIONS = ("portrait", "landscape", "normal", "90", "180", "270")

DEFAULT_CONFIG = {
