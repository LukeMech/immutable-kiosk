# SELinux is on again after builds that booted with selinux=0: what those
# boots wrote to /etc and /var (Wi-Fi profiles, settings, the journal) has
# no label, and confined services (NetworkManager, chronyd...) would be
# denied it. Labelled once, before they start; a stamp skips it after that.
[Unit]
Description=immutable-kiosk: label files written while SELinux was off
DefaultDependencies=no
ConditionSecurity=selinux
ConditionPathExists=!/run/initramfs/live
ConditionPathExists=!/var/lib/immutable-kiosk/selinux-labelled
RequiresMountsFor=/var
After=local-fs.target
Before=sysinit.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/restorecon -R /etc /var
ExecStart=/usr/bin/mkdir -p /var/lib/immutable-kiosk
ExecStart=/usr/bin/touch /var/lib/immutable-kiosk/selinux-labelled

[Install]
WantedBy=sysinit.target
