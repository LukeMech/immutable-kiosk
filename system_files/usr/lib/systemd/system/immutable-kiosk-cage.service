# cage on tty1 as kiosk, no display manager (per cage's wiki): the PAM session
# gives the logind session needed for DRM/input on seat0.
# Not after systemd-user-sessions (waits for network); the immutable-kiosk
# PAM stack omits pam_nologin instead.
[Unit]
Description=Kiosk (cage + kiosk-shell) on tty1
After=dbus.socket systemd-logind.service immutable-kiosk-backend.service
Wants=dbus.socket systemd-logind.service immutable-kiosk-backend.service
# Splash handover like GDM: `plymouth deactivate` (ExecStartPre) instead of
# plymouth-quit keeps its last frame up until cage draws; kioskd sends
# `plymouth quit --retain-splash` once the kiosk has drawn.
After=plymouth-start.service plymouth-quit.service
Conflicts=plymouth-quit.service
ConditionPathExists=/dev/tty0
# Never give up (the default start limit could leave tty1 without a kiosk).
StartLimitIntervalSec=0

[Service]
Type=simple
User=kiosk
WorkingDirectory=/var/home/kiosk
# i915 can appear after this starts; cage would then fail or take simpledrm.
# Wait up to 30 s for a non-simple-framebuffer card, then start anyway.
# ($$: systemd expands $ itself.)
ExecStartPre=/bin/sh -c 'for i in $$(seq 60); do for c in /sys/class/drm/card[0-9]; do d=$$(readlink -f "$$c/device/driver"); [ -n "$$d" ] && [ "$${d##*/}" != simple-framebuffer ] && exit 0; done; sleep 0.5; done; echo "no GPU (only a firmware framebuffer) after 30 s" >&2'
# "handover": the splash forms the word WAIT (1.5 s), then releases the GPU
# with it on screen for kiosk-splash to continue. "+": as root; "-": no splash is fine.
ExecStartPre=-+/bin/sh -c '/usr/bin/plymouth update --status=handover && sleep 1.6; /usr/bin/plymouth deactivate'
PAMName=immutable-kiosk
Environment=XDG_SESSION_TYPE=wayland
# -d: no client-side decorations.
ExecStart=/usr/bin/cage -d -- /usr/libexec/immutable-kiosk/kiosk-session
Restart=always
RestartSec=2
UtmpIdentifier=tty1
UtmpMode=user
TTYPath=/dev/tty1
# No TTYReset/TTYVTDisallocate: they'd switch tty1 to text mode and blank
# plymouth's frame before cage draws.
TTYVHangup=yes
StandardInput=tty-fail
StandardOutput=journal
# Console output only shows when cage dies -- exactly when it's needed.
StandardError=journal+console

[Install]
WantedBy=graphical.target
Alias=display-manager.service
