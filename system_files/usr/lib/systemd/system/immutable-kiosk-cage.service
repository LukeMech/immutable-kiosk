# cage on tty1 as the kiosk user, started by systemd directly -- no display
# manager, no greeter. Follows cage's own wiki ("Starting Cage on boot with
# systemd"): a PAM session gives the logind session that lets an
# unprivileged user open the DRM and input devices on seat0.
#
# Not after systemd-user-sessions: that one waits for network.target (and
# with it Wi-Fi), so the kiosk did too. Its PAM stack (immutable-kiosk) has
# no pam_nologin, the only thing systemd-user-sessions unlocks. No network
# at start: kiosk-shell shows Settings and switches to the HMI when it loads.
[Unit]
Description=Kiosk (cage + kiosk-shell) on tty1
After=dbus.socket systemd-logind.service immutable-kiosk-backend.service
Wants=dbus.socket systemd-logind.service immutable-kiosk-backend.service
# The boot splash hands the screen over to cage the way display managers do
# it: plymouth-quit (the generic "stop the splash" at multi-user) is replaced
# by our own `plymouth quit --retain-splash` right before cage starts, so the
# splash's last frame stays up until cage draws, with kiosk-splash (see
# ExecStart) right after it.
After=plymouth-start.service plymouth-quit.service
Conflicts=plymouth-quit.service
ConditionPathExists=/dev/tty0
# Never give up: with the default limit (5 starts in 10 s) a few early
# failures left the unit dead, and tty1 showed a login prompt instead.
StartLimitIntervalSec=0

[Service]
Type=simple
User=kiosk
WorkingDirectory=/var/home/kiosk
# i915 on Bay Trail can come up after this unit starts (slower still from a
# USB stick over OTG): cage then finds no GPU and exits. Wait up to 30 s
# for a DRM card first; after that, start anyway and let Restart= retry.
# ($$: systemd expands $ itself.)
ExecStartPre=/bin/sh -c 'for i in $$(seq 60); do ls /dev/dri/card* >/dev/null 2>&1 && exit 0; sleep 0.5; done; echo "no /dev/dri/card* after 30 s" >&2'
# Splash off, last frame kept, DRM master released for cage. "+": as root
# (the rest of the unit runs as kiosk); "-": no splash running is fine.
ExecStartPre=-+/usr/bin/plymouth quit --retain-splash
PAMName=immutable-kiosk
Environment=XDG_SESSION_TYPE=wayland
# -d: no client-side decorations. kiosk-session: the last rotation, then
# kiosk-splash (on screen at once) and kiosk-shell over it -- cage's black
# first frame lasts a fraction of a second, not all of kiosk-shell's start.
ExecStart=/usr/bin/cage -d -- /usr/libexec/immutable-kiosk/kiosk-session
Restart=always
RestartSec=2
UtmpIdentifier=tty1
UtmpMode=user
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
# Also on the console: while cage runs it owns the screen, so this is only
# seen when cage/kiosk-shell dies -- exactly when the error is needed.
StandardError=journal+console

[Install]
WantedBy=graphical.target
Alias=display-manager.service
