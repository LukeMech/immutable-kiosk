# cage on tty1 as the kiosk user, started by systemd directly -- no display
# manager, no greeter. Follows cage's own wiki ("Starting Cage on boot with
# systemd"): PAMName=login gives the logind session that lets an unprivileged
# user open the DRM and input devices on seat0.
[Unit]
Description=Kiosk (cage + kiosk-shell) on tty1
After=systemd-user-sessions.service dbus.socket systemd-logind.service immutable-kiosk-backend.service
Wants=dbus.socket systemd-logind.service immutable-kiosk-backend.service
Conflicts=getty@tty1.service
After=getty@tty1.service
ConditionPathExists=/dev/tty0
# Never give up: with the default limit (5 starts in 10 s) a few early
# failures left the unit dead, and tty1 showed a login prompt instead.
StartLimitIntervalSec=0

[Service]
Type=simple
User=kiosk
WorkingDirectory=/var/home/kiosk
# i915 on Bay Trail can come up after this unit starts (slower still from a
# USB stick over OTG): cage then finds no GPU and exits. Wait up to 30 s
# for a DRM card first; after that, start anyway and let Restart= retry.
# ($$: systemd expands $ itself.)
ExecStartPre=/bin/sh -c 'for i in $$(seq 60); do ls /dev/dri/card* >/dev/null 2>&1 && exit 0; sleep 0.5; done; echo "no /dev/dri/card* after 30 s" >&2'
PAMName=login
Environment=XDG_SESSION_TYPE=wayland
# -d: no client-side decorations, kiosk-shell is the only (fullscreen) window.
ExecStart=/usr/bin/cage -d -- /usr/libexec/immutable-kiosk/kiosk-shell
Restart=always
RestartSec=2
UtmpIdentifier=tty1
UtmpMode=user
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
# Also on the console: while cage runs it owns the screen, so this is only
# seen when cage/kiosk-shell dies -- exactly when the error is needed.
StandardError=journal+console

[Install]
WantedBy=graphical.target
Alias=display-manager.service
