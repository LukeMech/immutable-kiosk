[Unit]
Description=immutable-kiosk settings API (kioskd, localhost only)
# NetworkManager running is enough (nmcli answers); network.target would
# hold kioskd -- and the kiosk after it -- until Wi-Fi is up.
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/libexec/immutable-kiosk/kioskd
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
