[Unit]
Description=immutable-kiosk settings API (kioskd, localhost only)
# Not After=: ordering on NetworkManager delays the kiosk; kioskd copes.
Wants=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/libexec/immutable-kiosk/kioskd
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
