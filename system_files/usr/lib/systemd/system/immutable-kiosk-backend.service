[Unit]
Description=immutable-kiosk settings API (kioskd, localhost only)
# Not after NetworkManager either: it took 1.8 s to start, and the kiosk
# (after kioskd) waited for that. kioskd's nmcli calls work as soon as it
# runs, and its events bring NetworkManager's state when it does.
Wants=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/libexec/immutable-kiosk/kioskd
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
