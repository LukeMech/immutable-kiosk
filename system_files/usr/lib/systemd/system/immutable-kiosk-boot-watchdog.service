# Automatic rollback: reboot a trial boot whose kiosk isn't up in 10 min.
[Unit]
Description=immutable-kiosk: reboot a new version that never comes up
ConditionPathExists=!/run/initramfs/live
After=immutable-kiosk-boot-counter.service
Wants=immutable-kiosk-boot-counter.service

[Service]
Type=simple
ExecStart=/usr/libexec/immutable-kiosk/boot-counter watchdog

[Install]
WantedBy=multi-user.target
